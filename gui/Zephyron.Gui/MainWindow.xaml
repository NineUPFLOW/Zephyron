<Window x:Class="Zephyron.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zephyron.Gui.Views"
        xmlns:local="clr-namespace:Zephyron.Gui"
        Title="Zephyron"
        Height="760" Width="1160"
        MinHeight="560" MinWidth="880"
        Background="{DynamicResource Backdrop}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Оболочка с 0.18: командная полоса сверху во всю ширину и раздел под ней.

        В полосе видны все тринадцать разделов: пять ежедневных — текстовыми
        вкладками, инструменты разбора и настройки — значками, выбранный из
        них раскрывается своим именем. Выбранное отмечает одна черта под
        полосой, переезжающая от пункта к пункту (MoveIndicator). Справа —
        журнал и состояние движков, видные из любого раздела.

        Не боковая колонка: та же колонка с теми же пунктами в том же порядке —
        чужая композиция, от которой Zephyron ушёл. И не
        всплывающее «Ещё», как в 0.16–0.17: открытый оттуда раздел подсвечивал
        только «Ещё», и по окну было не понять, где вы. Имена пунктов, их Tag
        и обработчик прежние: менялась форма, а не поведение.
    -->
    <Grid x:Name="Root" LayoutTransform="{DynamicResource UiScaleTransform}" SizeChanged="OnRootSize">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Фон темы: картинка и затемнение цветом подложки, подо всем окном.
            У встроенных тем картинки нет, и оба слоя сливаются с подложкой.
            Не ловят мышь: под ними ничего нет, а над ними всё окно.
        -->
        <Rectangle x:Name="BackdropLayer" Grid.RowSpan="3" IsHitTestVisible="False" Fill="{DynamicResource BackdropImage}" />
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False" Fill="{DynamicResource Backdrop}"
                   Opacity="{DynamicResource BackdropDim}" />

        <!--
            Сияние («Сигнал»): одно неподвижное пятно акцента слева сверху,
            0.07 от Decor (у тем с картинкой Decor = 0 — пятна нет). Прежние
            облака, точечная сетка и дрейф сняты: бюджет кадра отдан слою частиц.
        -->
        <Rectangle x:Name="Aurora" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="{DynamicResource Decor}">
            <Rectangle.Fill>
                <RadialGradientBrush Opacity="0.07" Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--
            Слой «сеть» (ParticleField): между фоном и полосой, не ловит мышь.
            Курсор и клики сообщает ему само окно (Root, handledEventsToo).
            Видео-фон темы прячет его целиком, картинка приглушает (ApplyBackdropKind).
        -->
        <local:ParticleField x:Name="Field" Grid.RowSpan="3" IsHitTestVisible="False" />

        <!-- Командная полоса. -->
        <Border Grid.Row="0" x:Name="Nav" Style="{StaticResource RailPanel}" SizeChanged="OnNavSize">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    Знак программы — её же рисунок, что у значка в трее и у файла
                    (Assets\logo.png, вынут из app.ico; владелец, 12.10 и 25.10: знак
                    не перекрашивается под тему). Версия — рядом, пока полоса не сжата.
                -->
                <StackPanel x:Name="Brand" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Image x:Name="Mark" Width="{StaticResource MarkSize}" Height="{StaticResource MarkSize}"
                           Source="pack://application:,,,/Zephyron;component/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrandName" Text="Zephyron" FontFamily="{DynamicResource UiFont}"
                               FontWeight="SemiBold" FontSize="14" Margin="9,0,0,1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource MonoTag}" Margin="7,3,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Разделы на каждый день — вкладками. -->
                <StackPanel x:Name="Rail" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="RailStatus" Style="{StaticResource RailItem}" Content="Главная" Tag="status" local:MenuIcon.Glyph="&#xE80F;" IsChecked="True" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="VPN" Tag="vpn" local:MenuIcon.Glyph="&#xE774;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="Десинк" Tag="desync" local:MenuIcon.Glyph="&#xE9E9;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="Маршруты" Tag="routes" local:MenuIcon.Glyph="&#xE816;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="TG Proxy" Tag="tgproxy" local:MenuIcon.Shape="{StaticResource TelegramPlane}" Checked="OnSection" />
                </StackPanel>

                <!--
                    Инструменты разбора и настройки программы — значками. Имя MoreRail
                    осталось от всплывающего «Ещё»: по нему окно перечисляет пункты (Items).
                -->
                <StackPanel x:Name="MoreRail" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ToolItem}" Content="Проверка блокировок" Tag="check" local:MenuIcon.Glyph="&#xE721;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource ToolItem}" Content="Замер скорости" Tag="speed" local:MenuIcon.Glyph="&#xEC4A;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource ToolItem}" Content="DNS" Tag="dns" local:MenuIcon.Glyph="&#xE968;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource ToolItem}" Content="Файл hosts" Tag="hosts" local:MenuIcon.Glyph="&#xE8A5;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource ToolItem}" Content="Наблюдение" Tag="watch" local:MenuIcon.Glyph="&#xE9D2;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource ToolItem}" Content="Диагностика" Tag="doctor" local:MenuIcon.Glyph="&#xE9D9;" Checked="OnSection" />

                    <Border Width="1" Height="18" Margin="7,0" Background="{DynamicResource Border}" />

                    <RadioButton Style="{StaticResource ToolItem}" Content="Оформление" Tag="look" local:MenuIcon.Glyph="&#xE790;" Checked="OnSection" />
                    <RadioButton x:Name="RailMore" Style="{StaticResource ToolItem}" Content="Прочее" Tag="more" local:MenuIcon.Glyph="&#xE713;" Checked="OnSection" />
                </StackPanel>

                <!-- Журнал и состояние движков — справа, на виду из любого раздела. -->
                <StackPanel x:Name="BarEnd" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="1" Height="18" Margin="0,0,9,0" Background="{DynamicResource Border}" />

                    <ToggleButton x:Name="LogButton" Style="{StaticResource NavMore}" local:MenuIcon.Glyph="&#xE8FD;"
                                  Click="OnLogToggle" ToolTip="Журналы движков — панелью снизу"
                                  AutomationProperties.Name="Журнал" />

                    <!--
                        Состояние движков (ShowTopDot): кольцо — выключен, дуга — запуск,
                        диск — работает, ромб — частично, треугольник — сбой; слово рядом.
                        Нажатие ведёт на «Главную», где их запускают.
                    -->
                    <Button x:Name="StatusRow" Style="{StaticResource NavStatus}" Margin="8,0,0,0" Click="OnStatusRow"
                            AutomationProperties.Name="Состояние движков">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <!-- Ореол знака — только пока обход работает (Breathe). -->
                                <Ellipse x:Name="TopHalo" Width="10" Height="10" Fill="{DynamicResource Success}"
                                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Control x:Name="TopMark" Style="{StaticResource StateMark}" Width="10" Height="10" Tag="Off" />
                            </Grid>
                            <TextBlock x:Name="TopStatus" Margin="8,0,0,0" FontSize="12" FontWeight="Medium" Text="Выключен"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                       Visibility="{DynamicResource NavLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Черта выбранного пункта — одна на всю полосу, на её нижней кромке.
            Переезжает от пункта к пункту (MoveIndicator) и светится акцентом.
            Ширина постоянная (= MainWindow.IndicatorBase), место и длина — RenderTransform;
            ScaleX="0" — ещё не поставлена.
        -->
        <Canvas Grid.Row="0" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="0" ClipToBounds="False">
            <Rectangle x:Name="NavIndicator" Height="2" Width="64" RadiusX="1" RadiusY="1" Canvas.Top="-2"
                       Fill="{DynamicResource Accent}">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="NavScale" ScaleX="0" />
                        <TranslateTransform x:Name="NavShift" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource AccentColor}" />
                </Rectangle.Effect>
            </Rectangle>
        </Canvas>

        <Grid Grid.Row="1" x:Name="SectionArea">
            <ContentControl x:Name="Section" Focusable="False">
                <views:StatusView />
            </ContentControl>

            <!--
                «Маршруты» — своим местом: уход их прячет, а не отцепляет
                (OnSection). Отцепленные при возврате раскладывали
                сотню карточек заново — у владельца сторож писал 1,0–1,6 с.
            -->
            <ContentControl x:Name="RoutesHost" Visibility="Collapsed" Focusable="False" />

            <!--
                Всплывающие карточки — стопкой внизу справа, над кнопкой журнала,
                чтобы две разом не легли одна на другую.
            -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20">

            <!--
                После обновления: звезда на GitHub и канал. Один раз на каждую
                новую версию и только тем, кто скрыл карточку на «Главной»
                (UpdateGreeting). Сама не уходит — закрывается кнопкой:
                кнопки в ней и есть смысл.
            -->
            <Border x:Name="GreetingToast" Visibility="Collapsed" MaxWidth="440" Margin="0,0,0,12"
                    Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="{StaticResource Stroke}"
                    CornerRadius="{StaticResource RLg}" Padding="12,10"
                    AutomationProperties.LiveSetting="Polite">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Control Style="{StaticResource StateMark}" Width="14" Height="14" Tag="Running"
                                 Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="GreetingTitle" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE711;" Margin="10,-4,-6,0"
                                Padding="6,4" MinWidth="0" VerticalAlignment="Top" Click="OnGreetingClose"
                                Background="Transparent" BorderBrush="Transparent" ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="24,4,0,0" TextWrapping="Wrap"
                               Text="Если программа помогает — поставьте звезду на GitHub и подпишитесь на канал: так о ней узнают другие, а вы — о новых версиях. Поддержать разработку можно и донатом." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Click="OnGreetingTelegram"
                                local:ButtonGlyph.Lead="&#xE724;" Content="Канал"
                                ToolTip="Новости в телеграм-канале" />
                        <Button Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="OnGreetingDonate"
                                local:ButtonGlyph.Lead="&#xEB51;" Content="Поддержать"
                                ToolTip="Поддержать разработку донатом" />
                        <Button Style="{StaticResource Primary}" Click="OnGreetingStar"
                                local:ButtonGlyph.Lead="&#xE734;" Content="Звезда на GitHub"
                                ToolTip="Страница Zephyron на GitHub — звезда справа вверху" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                Предложение перезапустить движки. Внизу справа и само уходит:
                почти всё, что меняется в окне, применяется перезапуском,
                и говорить об этом строкой в глубине раздела значит не сказать
                вовсе. Но и держать перед глазами нельзя — правок за один
                заход бывает десяток. Наведённая мышь останавливает отсчёт.
                Знак — ToastMark: ромб — предложение, диск — готово, треугольник — не вышло.
            -->
            <Border x:Name="Toast" Visibility="Collapsed" MaxWidth="340" Margin="0,0,0,12"
                    Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="{StaticResource Stroke}"
                    CornerRadius="{StaticResource RLg}" Padding="12,10"
                    AutomationProperties.LiveSetting="Polite"
                    MouseEnter="OnToastEnter" MouseLeave="OnToastLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Control x:Name="ToastMark" Style="{StaticResource StateMark}" Width="14" Height="14" Tag="Degraded"
                                 Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="ToastBody" Style="{StaticResource Caption}"
                               Margin="24,4,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="ToastLater" Style="{StaticResource Quiet}" Content="Позже"
                                Margin="0,0,8,0" Click="OnToastLater" />
                        <Button x:Name="ToastAct" Style="{StaticResource Primary}"
                                Content="Перезапустить" Click="OnToastRestart" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </Grid>

        <!--
            Журнал панелью снизу (с 0.16) — тот же, что окном из «Диагностики»
            (LogView). Свёрнутая панель не занимает места; содержимое раздела
            сжимается над ней, а не прячется под неё.
        -->
        <Border Grid.Row="2" x:Name="LogDrawer" Height="300" Visibility="Collapsed"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0">
            <views:LogView x:Name="DrawerLog" Padding="18,12,18,14" ShowClose="True" />
        </Border>
    </Grid>
</Window>
