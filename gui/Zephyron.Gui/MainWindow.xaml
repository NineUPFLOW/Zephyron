<Window x:Class="Zephyron.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zephyron.Gui.Views"
        xmlns:local="clr-namespace:Zephyron.Gui"
        Title="Zephyron"
        Height="760" Width="1160"
        MinHeight="560" MinWidth="880"
        Background="{DynamicResource Backdrop}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Оболочка с 0.18: командная полоса сверху во всю ширину и раздел под ней.

        В полосе видны все тринадцать разделов: пять ежедневных — текстовыми
        вкладками, инструменты разбора и настройки — значками, выбранный из
        них раскрывается своим именем. Выбранное отмечает одна черта под
        полосой, переезжающая от пункта к пункту (MoveIndicator). Справа —
        журнал и состояние движков, видные из любого раздела.

        Не боковая колонка: та же колонка с теми же пунктами в том же порядке —
        чужая композиция, от которой Zephyron ушёл. И не
        всплывающее «Ещё», как в 0.16–0.17: открытый оттуда раздел подсвечивал
        только «Ещё», и по окну было не понять, где вы. Имена пунктов, их Tag
        и обработчик прежние: менялась форма, а не поведение.
    -->
    <Grid x:Name="Root" LayoutTransform="{DynamicResource UiScaleTransform}" SizeChanged="OnRootSize">
        <!--
            С 1.8.1 — боковое меню (макет 23.11): пункт меню виден сразу, а у ежедневных
            разделов справа их состояние. Имена пунктов, их Tag и обработчик прежние.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideColumn" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Фон темы: картинка и затемнение цветом подложки, подо всем окном.
            У встроенных тем картинки нет, и оба слоя сливаются с подложкой.
        -->
        <Rectangle x:Name="BackdropLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" Fill="{DynamicResource BackdropImage}" />
        <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" Fill="{DynamicResource Backdrop}"
                   Opacity="{DynamicResource BackdropDim}" />

        <Rectangle x:Name="Aurora" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="{DynamicResource Decor}">
            <Rectangle.Fill>
                <RadialGradientBrush Opacity="0.07" Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <local:ParticleField x:Name="Field" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" />

        <!-- Боковое меню. -->
        <Border Grid.Column="0" Grid.RowSpan="2" x:Name="Nav" Style="{StaticResource SidePanel}" SizeChanged="OnNavSize">
            <DockPanel LastChildFill="True">
                <!-- Знак программы и версия. -->
                <StackPanel x:Name="Brand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,18,20,0">
                    <Image x:Name="Mark" Width="{StaticResource MarkSize}" Height="{StaticResource MarkSize}"
                           Source="pack://application:,,,/Zephyron;component/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrandName" Text="Zephyron" FontFamily="{DynamicResource UiFont}"
                               FontWeight="Bold" FontSize="16" Margin="10,0,0,1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource MonoTag}" Margin="8,3,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Управление: обход одной кнопкой, рядом — перезапуск и режимы. -->
                <TextBlock DockPanel.Dock="Top" Text="управление" Margin="26,16,0,8" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource Faint}" />
                <Grid DockPanel.Dock="Top" Margin="12,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PowerButton" Style="{StaticResource Primary}" Height="44" Click="OnPower"
                            HorizontalContentAlignment="Left" Padding="16,0" AutomationProperties.Name="Обход">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7E8;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="PowerLabel" Text="Включить обход" Margin="12,0,0,0" FontSize="15"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PowerMenuButton" Grid.Column="1" Style="{StaticResource Ghost}" Width="44" Height="44"
                            Margin="8,0,0,0" Click="OnPowerMenu" Padding="0" AutomationProperties.Name="Перезапуск и режим"
                            ToolTip="Перезапустить движки, сменить режим">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Подвал: ссылки, журнал и состояние движков. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="26,6,16,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource SideLink}" Content="Поддержать" local:MenuIcon.Glyph="&#xEB51;" Click="OnSupport" />
                        <Button Style="{StaticResource SideLink}" Content="Telegram" local:MenuIcon.Glyph="&#xE724;" Margin="16,0,0,0" Click="OnTelegram" />
                    </StackPanel>
                    <Button Style="{StaticResource SideLink}" Content="Нашли баг?" local:MenuIcon.Glyph="&#xEBE8;" Margin="0,0,0,10" Click="OnBug"
                            HorizontalAlignment="Left" ToolTip="Диагностика и отчёт для разбора" />

                    <!--
                        Состояние движков (ShowTopDot): кольцо — выключен, дуга — запуск,
                        диск — работает, ромб — частично, треугольник — сбой; слово рядом.
                        Нажатие ведёт на «Обзор». Журнал — панелью снизу.
                    -->
                    <Grid x:Name="BarEnd">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StatusRow" Style="{StaticResource NavStatus}" Click="OnStatusRow" HorizontalAlignment="Left"
                                AutomationProperties.Name="Состояние движков">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse x:Name="TopHalo" Width="10" Height="10" Fill="{DynamicResource Success}"
                                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Control x:Name="TopMark" Style="{StaticResource StateMark}" Width="10" Height="10" Tag="Off" />
                                </Grid>
                                <TextBlock x:Name="TopStatus" Margin="8,0,0,0" FontSize="12" FontWeight="Medium" Text="Выключен"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="LogButton" Grid.Column="1" Style="{StaticResource NavMore}" local:MenuIcon.Glyph="&#xE8FD;"
                                      Click="OnLogToggle" ToolTip="Журнал движков — панелью снизу"
                                      AutomationProperties.Name="Журнал" />
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <!-- Разделы на каждый день: справа — их состояние (UpdateSideValues). -->
                        <StackPanel x:Name="Rail">
                            <RadioButton x:Name="RailStatus" Style="{StaticResource SideItem}" Content="Обзор" Tag="status" local:MenuIcon.Glyph="&#xECA5;" IsChecked="True" Checked="OnSection" />
                            <RadioButton x:Name="SideVpn" Style="{StaticResource SideItem}" Content="VPN" Tag="vpn" local:MenuIcon.Glyph="&#xE774;" Checked="OnSection" />
                            <RadioButton x:Name="SideDesync" Style="{StaticResource SideItem}" Content="Десинк" Tag="desync" local:MenuIcon.Glyph="&#xE9E9;" Checked="OnSection" />
                            <RadioButton x:Name="SideRoutes" Style="{StaticResource SideItem}" Content="Маршруты" Tag="routes" local:MenuIcon.Glyph="&#xE816;" Checked="OnSection" />
                            <RadioButton x:Name="SideTg" Style="{StaticResource SideItem}" Content="TG Proxy" Tag="tgproxy" local:MenuIcon.Shape="{StaticResource TelegramPlane}" Checked="OnSection" />
                        </StackPanel>

                        <!-- Инструменты и настройка. Имя MoreRail — по нему окно перечисляет пункты (Items). -->
                        <StackPanel x:Name="MoreRail" Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource SideItem}" Content="Проверка блокировок" Tag="check" local:MenuIcon.Glyph="&#xE721;" Checked="OnSection" />
                            <RadioButton Style="{StaticResource SideItem}" Content="Замер скорости" Tag="speed" local:MenuIcon.Glyph="&#xEC4A;" Checked="OnSection" />
                            <RadioButton Style="{StaticResource SideItem}" Content="Файл hosts" Tag="hosts" local:MenuIcon.Glyph="&#xE8A5;" Checked="OnSection" />
                            <RadioButton Style="{StaticResource SideItem}" Content="Наблюдение" Tag="watch" local:MenuIcon.Glyph="&#xE9D2;" Checked="OnSection" />
                            <RadioButton x:Name="SideDns" Style="{StaticResource SideItem}" Content="DNS" Tag="dns" local:MenuIcon.Glyph="&#xE968;" Checked="OnSection" />
                            <RadioButton Style="{StaticResource SideItem}" Content="Диагностика" Tag="doctor" local:MenuIcon.Glyph="&#xE9D9;" Checked="OnSection" />
                            <RadioButton Style="{StaticResource SideItem}" Content="Оформление" Tag="look" local:MenuIcon.Glyph="&#xE790;" Checked="OnSection" />
                            <RadioButton x:Name="RailMore" Style="{StaticResource SideItem}" Content="Настройки" Tag="more" local:MenuIcon.Glyph="&#xE713;" Checked="OnSection" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Черта прежней верхней полосы — с боковым меню не видна (выбор отмечает сам пункт). -->
        <Canvas Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False" Height="0">
            <Rectangle x:Name="NavIndicator" Height="2" Width="64">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="NavScale" ScaleX="0" />
                        <TranslateTransform x:Name="NavShift" />
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <Grid Grid.Column="1" Grid.Row="0" x:Name="SectionArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="Section" Focusable="False">
                <views:StatusView />
            </ContentControl>

            <!--
                «Маршруты» — своим местом: уход их прячет, а не отцепляет
                (OnSection). Отцепленные при возврате раскладывали
                сотню карточек заново — у владельца сторож писал 1,0–1,6 с.
            -->
            <ContentControl x:Name="RoutesHost" Visibility="Collapsed" Focusable="False" />

            <!--
                Всплывающие карточки — стопкой внизу справа, над кнопкой журнала,
                чтобы две разом не легли одна на другую.
            -->
            <!-- Поверх страницы, а не строкой под ней: строка съедала низ страницы,
                 пока висела карточка. Промахнуться по кнопке под ней нельзя — предложение
                 перезапуска само не уходит (OfferRestart). -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,8">

            <!--
                После обновления: звезда на GitHub и канал. Один раз на каждую
                новую версию и только тем, кто скрыл карточку на «Главной»
                (UpdateGreeting). Сама не уходит — закрывается кнопкой:
                кнопки в ней и есть смысл.
            -->
            <Border x:Name="GreetingToast" Visibility="Collapsed" MaxWidth="440" Margin="0,0,0,12"
                    Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="{StaticResource Stroke}"
                    CornerRadius="{StaticResource RLg}" Padding="12,10"
                    AutomationProperties.LiveSetting="Polite">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Control Style="{StaticResource StateMark}" Width="14" Height="14" Tag="Running"
                                 Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="GreetingTitle" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE711;" Margin="10,-4,-6,0"
                                Padding="6,4" MinWidth="0" VerticalAlignment="Top" Click="OnGreetingClose"
                                Background="Transparent" BorderBrush="Transparent" ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="24,4,0,0" TextWrapping="Wrap"
                               Text="Программа выручила? Звезда на GitHub и канал помогут другим её найти. Проект можно поддержать деньгами." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Click="OnGreetingTelegram"
                                local:ButtonGlyph.Lead="&#xE724;" Content="Новости"
                                ToolTip="Что вышло и что изменилось, коротко в Telegram" />
                        <Button Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="OnGreetingDonate"
                                local:ButtonGlyph.Lead="&#xEB51;" Content="Поддержать"
                                ToolTip="Поддержать разработку донатом" />
                        <Button Style="{StaticResource Primary}" Click="OnGreetingStar"
                                local:ButtonGlyph.Lead="&#xE734;" Content="Отметить на GitHub"
                                ToolTip="Проект на GitHub: звезда в правом верхнем углу" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                Предложение перезапустить движки. Внизу справа, в своей строке под
                разделом (не поверх кнопок страницы), и само не уходит, пока движки
                на старой настройке; после «Не сейчас» остаётся слово в полосе. Раньше уходило само:
                почти всё, что меняется в окне, применяется перезапуском,
                и говорить об этом строкой в глубине раздела значит не сказать
                вовсе. Но и держать перед глазами нельзя — правок за один
                заход бывает десяток. Наведённая мышь останавливает отсчёт.
                Знак — ToastMark: ромб — предложение, диск — готово, треугольник — не вышло.
            -->
            <Border x:Name="Toast" Visibility="Collapsed" MaxWidth="340" Margin="0,0,0,12"
                    Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="{StaticResource Stroke}"
                    CornerRadius="{StaticResource RLg}" Padding="12,10"
                    AutomationProperties.LiveSetting="Polite"
                    MouseEnter="OnToastEnter" MouseLeave="OnToastLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Control x:Name="ToastMark" Style="{StaticResource StateMark}" Width="14" Height="14" Tag="Degraded"
                                 Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="ToastBody" Style="{StaticResource Caption}"
                               Margin="24,4,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="ToastLater" Style="{StaticResource Quiet}" Content="Не сейчас"
                                Margin="0,0,8,0" Click="OnToastLater" />
                        <Button x:Name="ToastAct" Style="{StaticResource Primary}"
                                Content="Перезапустить сейчас" Click="OnToastRestart" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </Grid>

        <!--
            Журнал панелью снизу (с 0.16) — тот же, что окном из «Диагностики»
            (LogView). Свёрнутая панель не занимает места; содержимое раздела
            сжимается над ней, а не прячется под неё.
        -->
        <Border Grid.Column="1" Grid.Row="1" x:Name="LogDrawer" Height="300" Visibility="Collapsed"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0">
            <views:LogView x:Name="DrawerLog" Padding="18,12,18,14" ShowClose="True" />
        </Border>
    </Grid>
</Window>
