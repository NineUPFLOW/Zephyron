<Window x:Class="Zephyron.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Zephyron.Gui.Views"
        xmlns:local="clr-namespace:Zephyron.Gui"
        Title="Zephyron"
        Height="760" Width="1160"
        MinHeight="560" MinWidth="880"
        Background="{DynamicResource Backdrop}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Оболочка с 0.16: плавающая полоса меню сверху по центру и раздел под
        ней во всю ширину. Прежде меню было колонкой слева; пять ежедневных
        разделов теперь в полосе, инструменты разбора и настройки программы —
        в выпадающем «Ещё». Имена пунктов, их Tag и обработчик те же:
        менялась форма, а не поведение.
    -->
    <Grid x:Name="Root" LayoutTransform="{DynamicResource UiScaleTransform}" SizeChanged="OnRootSize">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Фон темы: картинка и затемнение цветом подложки, подо всем окном.
            У встроенных тем картинки нет, и оба слоя сливаются с подложкой.
            Не ловят мышь: под ними ничего нет, а над ними всё окно.
        -->
        <Rectangle x:Name="BackdropLayer" Grid.RowSpan="3" IsHitTestVisible="False" Fill="{DynamicResource BackdropImage}" />
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False" Fill="{DynamicResource Backdrop}"
                   Opacity="{DynamicResource BackdropDim}" />

        <!--
            Убранство сплошной подложки: сетка, тающая к краям, два мягких
            свечения по углам и виньетка. Прозрачность — Decor из темы: у тем
            с картинкой оно ноль, и убранство не спорит с картинкой.
        -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True" Opacity="{DynamicResource Decor}">
            <Rectangle>
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute"
                                  Viewbox="0,0,44,44" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="{DynamicResource Wash}" Thickness="1" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0.5" EndPoint="44,0.5" />
                                        <LineGeometry StartPoint="0.5,0" EndPoint="0.5,44" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.6">
                        <GradientStop Color="#FF000000" Offset="0.2" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <Ellipse Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-180,-240,0,0" Opacity="0.13">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Второе свечение — фиолетовое, как в макете: противовес акценту в другом углу. -->
            <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-200,-260" Opacity="0.11">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A855F7" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#00000000" Offset="0.55" />
                        <GradientStop Color="#B3000000" Offset="1.05" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>


        <Grid Grid.Row="0" Grid.RowSpan="2">
            <ContentControl x:Name="Section">
                <views:StatusView />
            </ContentControl>

            <!--
                Всплывающие карточки — стопкой внизу справа, над кнопкой журнала,
                чтобы две разом не легли одна на другую.
            -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20">

            <!--
                После обновления: звезда на GitHub и канал. Один раз на каждую
                новую версию и только тем, кто скрыл карточку на «Главной»
                (UpdateGreeting). Сама не уходит — закрывается кнопкой:
                кнопки в ней и есть смысл.
            -->
            <Border x:Name="GreetingToast" Visibility="Collapsed" MaxWidth="500" Margin="0,0,0,12"
                    Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource WarnLine}" BorderThickness="{StaticResource Stroke}"
                    CornerRadius="{StaticResource RLg}" Padding="18,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}"
                                Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE735;" FontSize="14" Foreground="{DynamicResource Warn}" />
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="GreetingTitle" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE711;" Margin="10,-4,-6,0"
                                Padding="6,4" MinWidth="0" VerticalAlignment="Top" Click="OnGreetingClose"
                                Background="Transparent" BorderBrush="Transparent" ToolTip="Закрыть" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="44,4,0,0" TextWrapping="Wrap"
                               Text="Если программа помогает — поставьте звезду на GitHub и подпишитесь на канал: так о ней узнают другие, а вы — о новых версиях. Поддержать разработку можно и донатом." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Click="OnGreetingTelegram"
                                local:ButtonGlyph.Lead="&#xE724;" Content="Канал"
                                ToolTip="Новости в телеграм-канале" />
                        <Button Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="OnGreetingDonate"
                                local:ButtonGlyph.Lead="&#xEB51;" Content="Поддержать"
                                ToolTip="Поддержать разработку донатом" />
                        <Button Style="{StaticResource Primary}" Padding="16,8" Click="OnGreetingStar"
                                local:ButtonGlyph.Lead="&#xE734;" Content="Звезда на GitHub"
                                ToolTip="Страница Zephyron на GitHub — звезда справа вверху" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                Предложение перезапустить движки. Внизу справа и само уходит:
                почти всё, что меняется в окне, применяется перезапуском,
                и говорить об этом строкой в глубине раздела значит не сказать
                вовсе. Но и держать перед глазами нельзя — правок за один
                заход бывает десяток.
            -->
            <Border x:Name="Toast" Visibility="Collapsed" MaxWidth="460" Margin="0,0,0,12"
                    Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource AccentLine}" BorderThickness="{StaticResource Stroke}"
                    CornerRadius="{StaticResource RLg}" Padding="18,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastBody" Style="{StaticResource Caption}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="ToastLater" Style="{StaticResource Quiet}" Content="Позже"
                                Margin="0,0,8,0" Click="OnToastLater" />
                        <Button x:Name="ToastAct" Style="{StaticResource Primary}"
                                Content="Перезапустить" Padding="18,8" Click="OnToastRestart" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </Grid>

        <!--
            Верхнее меню — плавающая плашка по центру. Знак, имя и версия
            слева, точка состояния движков рядом (TopDot), за ними разделы.

            Стоит в разметке после раздела, а не до: раздел лежит под ним во всю
            высоту окна (с 0.16, MainWindow.FitUnderNav), и меню должно рисоваться
            поверх. Иначе картинка темы на «Главной» начиналась бы под меню,
            а над ней виднелась бы та же картинка окна, сдвинутая, — шов.
        -->
        <Border Grid.Row="0" x:Name="Nav" Style="{StaticResource RailPanel}" SizeChanged="OnNavSize"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{StaticResource NavInset}">
            <StackPanel Orientation="Horizontal">

                <!--
                    Знак программы — её же рисунок, что у значка в трее и у файла
                    (Assets\logo.png, вынут из app.ico; владелец, 12.10).
                -->
                <StackPanel Orientation="Horizontal" Margin="4,0,14,0" VerticalAlignment="Center">
                    <Image x:Name="Mark" Width="{StaticResource MarkSize}" Height="{StaticResource MarkSize}"
                           Source="pack://application:,,,/Zephyron;component/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="Zephyron" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource MonoTag}" FontSize="9.5" Margin="6,2,0,0" VerticalAlignment="Center" />

                    <Rectangle x:Name="TopDot" Width="6" Height="6" RadiusX="1" RadiusY="1" Margin="10,0,0,0"
                               VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                </StackPanel>

                <!-- Разделы на каждый день. -->
                <StackPanel x:Name="Rail" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RailStatus" Style="{StaticResource RailItem}" Content="Главная" Tag="status" local:MenuIcon.Glyph="&#xE80F;" IsChecked="True" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="VPN" Tag="vpn" local:MenuIcon.Glyph="&#xE774;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="Десинк" Tag="desync" local:MenuIcon.Glyph="&#xE9E9;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="Маршруты" Tag="routes" local:MenuIcon.Glyph="&#xE816;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource RailItem}" Content="TG Proxy" Tag="tgproxy" local:MenuIcon.Glyph="&#xE724;" Checked="OnSection" />
                </StackPanel>

                <!--
                    «Ещё» — инструменты разбора и настройки программы. Пункты те же
                    переключатели разделов, что в полосе, только во всплывающем
                    меню (MorePopup); раздел из меню подсвечивает саму кнопку.
                -->
                <ToggleButton x:Name="MoreToggle" Style="{StaticResource NavMore}" VerticalAlignment="Center"
                              Content="Ещё" local:MenuIcon.Glyph="&#xE712;" Click="OnMoreToggle" />

                <!--
                    Журнал панелью снизу — кнопкой в меню, а не плавающей в углу
                    окна (владелец, 22.10): в углу она закрывала кнопки мастера
                    первого запуска и «Загрузить» в «Маршрутах». Открытая панель
                    подсвечивает кнопку, как выбранный раздел.
                -->
                <Border Width="1" Height="18" Background="{DynamicResource Border}" Margin="6,0" VerticalAlignment="Center" />
                <ToggleButton x:Name="LogButton" Style="{StaticResource NavMore}" VerticalAlignment="Center"
                              Content="Журнал" local:MenuIcon.Glyph="&#xE8FD;"
                              Click="OnLogToggle" ToolTip="Журналы движков — панелью снизу" />
            </StackPanel>
        </Border>

        <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreToggle}" Placement="Bottom"
               HorizontalOffset="-150" VerticalOffset="12" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Closed="OnMoreClosed">
            <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}"
                    BorderThickness="{StaticResource Stroke}" CornerRadius="{StaticResource RMd}"
                    Padding="6" MinWidth="238" Margin="0,0,18,18"
                    LayoutTransform="{DynamicResource UiScaleTransform}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel x:Name="MoreRail">
                    <RadioButton Style="{StaticResource MoreItem}" Content="Проверка блокировок" Tag="check" local:MenuIcon.Glyph="&#xE721;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource MoreItem}" Content="Замер скорости" Tag="speed" local:MenuIcon.Glyph="&#xEC4A;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource MoreItem}" Content="DNS" Tag="dns" local:MenuIcon.Glyph="&#xE968;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource MoreItem}" Content="Файл hosts" Tag="hosts" local:MenuIcon.Glyph="&#xE8A5;" Checked="OnSection" />
                    <RadioButton Style="{StaticResource MoreItem}" Content="Наблюдение" Tag="watch" local:MenuIcon.Glyph="&#xE9D2;" Checked="OnSection" />
                    <!-- «Журнал» — окном из «Диагностики» и панелью снизу (кнопка «Журнал»). -->
                    <RadioButton Style="{StaticResource MoreItem}" Content="Диагностика" Tag="doctor" local:MenuIcon.Glyph="&#xE9D9;" Checked="OnSection" />

                    <Border Height="1" Background="{DynamicResource Border}" Margin="8,5" />
                    <RadioButton Style="{StaticResource MoreItem}" Content="Оформление" Tag="look" local:MenuIcon.Glyph="&#xE790;" Checked="OnSection" />
                    <RadioButton x:Name="RailMore" Style="{StaticResource MoreItem}" Content="Прочее" Tag="more" local:MenuIcon.Glyph="&#xE713;" Checked="OnSection" />
                </StackPanel>
            </Border>
        </Popup>

        <!--
            Журнал панелью снизу (с 0.16) — тот же, что окном из «Диагностики»
            (LogView). Свёрнутая панель не занимает места; содержимое раздела
            сжимается над ней, а не прячется под неё.
        -->
        <Border Grid.Row="2" x:Name="LogDrawer" Height="300" Visibility="Collapsed"
                Background="{DynamicResource RailFill}" BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="0,1,0,0">
            <views:LogView x:Name="DrawerLog" Padding="18,12,18,14" ShowClose="True" />
        </Border>
    </Grid>
</Window>
