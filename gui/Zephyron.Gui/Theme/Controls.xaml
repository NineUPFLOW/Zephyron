            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape" Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="{StaticResource Stroke}" CornerRadius="{StaticResource RMd}"
                            Height="{StaticResource HControlSm}" Padding="8,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

