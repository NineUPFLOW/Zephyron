<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Zephyron.Gui">

    <!--
        Стили без ключа — то есть по умолчанию для всего окна. Иначе каждый
        элемент пришлось бы помечать вручную, и однажды кто-то забудет,
        а забытая кнопка на тёмном фоне выйдет светлой.
    -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!--
        Title и Caption объявлены до PageHead: шаблон шапки берёт их через
        StaticResource, а он ищет только выше себя. Ссылка вперёд роняла
        показ окна — «Не удается найти ресурс с именем "Title"».
    -->
    <!--
        «Сигнал»: заголовок окна и блока — сплошным цветом текста, без градиента.
        DisplayFont оставлен для слова состояния и крупных цифр: заголовкам
        хватает основного шрифта, и на плотном окне он читается ровнее.
    -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        Подпись над блоком: мелко, строчными, третьим планом — «Режим работы»,
        «Приём». Называет блок, не споря с его содержимым. Прописных нет:
        крик капителью в плотном окне утомляет, а читается хуже.
    -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Faint}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Служебная метка моноширинным: «desync · winws2», версия, время. -->
    <Style x:Key="MonoTag" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Faint}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!--
        Крупная цифра метрики. Табличные цифры: число меняется каждую секунду
        и не должно дрожать по ширине. Единица — отдельным MetricUnit рядом.
        Если шрифт не отдаёт tnum, ширины «1111» и «0000» разойдутся —
        тогда FontFamily этого стиля меняется на MonoFont (проверка в ScreenshotTests).
    -->
    <Style x:Key="Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
    </Style>

    <Style x:Key="MetricUnit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Слово состояния на плашке «Главной»; цвет ставит место применения. -->
    <Style x:Key="StateWord" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageHead" TargetType="ContentControl">
        <!--
            Шапка раздела. Кнопки — содержимым, имя и подпись —
            присоединёнными свойствами (PageHead.cs).

            С 0.18 — не карточка, а строка: имя, подпись и кнопки раздела
            прямо на подложке. Карточка с акцентной чертой занимала под сотню
            точек высоты на каждом разделе и ничего не группировала: где вы,
            теперь видно по выбранному пункту боковой панели.
        -->
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <!-- Имя раздела — 20, сплошным цветом текста (с «Сигнала» без градиента). -->
                            <TextBlock Style="{StaticResource Title}" FontSize="20" HorizontalAlignment="Left"
                                       TextWrapping="Wrap"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Title)}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Subtitle)}" />
                        </StackPanel>

                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Окно-диалог — общий вид всех семнадцати окон программы: подложка темы
        и заголовок Windows цветами темы (TitleBar). С «Сигнала» без свечения
        акцента и градиентной черты: заголовок рисует сама Windows, а диалог —
        рабочее окно, не витрина.
    -->
    <Style x:Key="Dialog" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Backdrop}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="local:TitleBar.Themed" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <AdornerDecorator>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </AdornerDecorator>

                            <ResizeGrip x:Name="Grip" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        IsTabStop="False" Visibility="Collapsed" Opacity="0.5" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                            <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        Карточка. Скруглённая поверхность с рамкой на тон светлее фона:
        на тёмном именно рамка задаёт границу, тень почти не видна.
    -->
    <!--
        Рамка — CardRim: волосяная кромка цвета текста, ярче сверху. Карточка
        плоская и без среза углов (срез остался одной плашке состояния на
        «Главной»): две ступени — карточка (Surface) и вложенная панель (Raised).
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardRim}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource RLg}" />
        <Setter Property="Padding" Value="{StaticResource CardPad}" />
        <!-- Стекло под карточкой, если у темы фон и размытие включено (Glass.cs). -->
        <Setter Property="local:Glass.IsOn" Value="True" />
    </Style>

    <!--
        Стрелка сворачивания — фигурой, а не знаком шрифта.

        Знаками она была, и это оказалось ошибкой, которую видно глазом.
        Замер 20.09: «▸» U+25B8 и «▾» U+25BE, которыми рисовали маршруты
        и хосты, в Segoe UI отсутствуют — Windows подменяла их чужим
        шрифтом. «►» U+25BA и «▼» U+25BC, которыми рисовали подписки,
        в нём свои. Один и тот же жест выходил на двух вкладках разной
        гарнитурой: разный размер, разный вес, разная высота над строкой.
        Владелец назвал это «стрелочки кривые», и был прав.

        Фигура ни от какого шрифта не зависит. Одна на все разделы: две
        копии разошлись бы при первой же правке — так уже вышло с парами
        «▸/▾» в маршрутах и «►/▼» в подписках.

        Повёрнута поворотом, а не второй фигурой: угол легко связать
        с состоянием, а две фигуры пришлось бы держать в согласии руками.

        Стоит раньше кнопки: её шаблон рисует этой же фигурой стрелку меню
        (ButtonGlyph.Menu), а ключ словаря виден только ниже своего места.
    -->
    <!--
        Рамка фокуса клавиатуры — одна на все кнопки, поля и пункты меню.
        Стандартная — пунктир системного цвета, на тёмном почти не видна,
        а у своих шаблонов с ней не было понятно, где фокус после Tab.
        Показывается только при работе с клавиатуры — так решает сам WPF.
    -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="{StaticResource FocusWidth}" CornerRadius="{StaticResource RMd}"
                            BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chevron" TargetType="Path">
        <Setter Property="Data" Value="M 0,0 L 5,4 L 0,8 Z" />
        <Setter Property="Fill" Value="{DynamicResource Muted}" />
        <Setter Property="Width" Value="5" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Кнопка. Шаблон переопределён целиком: у стандартной внутри своя
        подложка, которая на тёмном фоне остаётся светлой при наведении.
    -->
    <!--
        С 0.16 кнопка — едва заметная подложка (Wash) с волосяной рамкой
        и подписью второго плана; при наведении подпись светлеет до текста,
        а рамка — до LineStrong. Так десяток кнопок раздела не спорит
        с главной, а главная (Primary) светится цветом акцента.
    -->
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Background" Value="{DynamicResource Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="{StaticResource HControl}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                        С 0.18 наведение — слоем поверх подложки (Hover), а не
                        подменой её цвета. Так отклик одинаков у кнопки любого
                        цвета — и у залитой главной, и у кнопки с подложкой,
                        заданной в разметке раздела, — а цвет кнопки остаётся её.
                    -->
                    <Grid>
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource Stroke}"
                            CornerRadius="{StaticResource RMd}" />
                    <Border x:Name="Hover" CornerRadius="{StaticResource RMd}" Background="{DynamicResource Text}"
                            Opacity="0" IsHitTestVisible="False" />
                    <Border Padding="{TemplateBinding Padding}" BorderThickness="{StaticResource Stroke}">
                        <!--
                            Подпись — цветом кнопки, а не общим цветом текста.
                            Стиль TextBlock без ключа выше красит весь текст
                            в Text и перебивает цвет, унаследованный от кнопки:
                            у главной кнопки подпись никогда не была OnAccent.
                            На тёмных темах это не было видно — светлый текст
                            на зелёном читается, — а в светлой теме с графитовой
                            кнопкой подпись пропала вовсе (владелец, 24.09),
                            и на жёлтой кнопке Nirvana была белой вместо тёмной.
                            Проверка читаемости смотрела на OnAccent, которого
                            окно не рисовало.

                            Своим шаблоном подписи, а не стилем в ресурсах:
                            стиль, положенный внутрь кнопки, до подписи не
                            доходил — это поймал тест, — а цвет, заданный самой
                            надписи, общий стиль перебить не может.

                            Только для текста — через выбор шаблона, а не
                            шаблоном напрямую: прямой применялся и к значку
                            пина, и тот показывался строкой
                            «System.Windows.Shapes.Path» (CaptionSelector).
                        -->
                        <!--
                            Значок слева и стрелка меню справа (ButtonGlyph) —
                            по умолчанию скрыты. Сетка, а не StackPanel: подпись
                            в средней колонке меряется по ширине кнопки и умеет
                            переноситься, в StackPanel ширина была бы бесконечной.
                        -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="LeadGlyph" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource IconFont}" FontSize="14"
                                       Text="{TemplateBinding local:ButtonGlyph.Lead}"
                                       Foreground="{TemplateBinding Foreground}" />

                            <!--
                                Поворот при раскладке, а не при отрисовке: фигура
                                5×8, повёрнутая отрисовкой, рисуется 8×5 в месте
                                5×8 и вылезает за него на полторы точки с боков —
                                у владельца 20.10 (125 %) стрелка выходила обрезанной.
                            -->
                            <Path x:Name="MenuArrow" Grid.Column="2" Style="{StaticResource Chevron}"
                                  Fill="{TemplateBinding Foreground}" Opacity="0.75" Margin="10,1,2,0"
                                  Visibility="Collapsed">
                                <Path.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </Path.LayoutTransform>
                            </Path>

                        <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.ContentTemplateSelector>
                                <local:CaptionSelector>
                                    <local:CaptionSelector.Text>
                                        <DataTemplate>
                                            <!--
                                                Шрифт — тоже кнопки: общий стиль надписей
                                                ставил свой, и значки IconGhost выходили
                                                квадратиками (28.09).
                                            -->
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </DataTemplate>
                                    </local:CaptionSelector.Text>
                                </local:CaptionSelector>
                            </ContentPresenter.ContentTemplateSelector>
                        </ContentPresenter>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:ButtonGlyph.Lead" Value="">
                            <Setter TargetName="LeadGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="local:ButtonGlyph.Menu" Value="True">
                            <Setter TargetName="MenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--
                            Рамка и подпись — свойствами самой кнопки, а не её
                            частей: стиль-наследник (Primary) перебивает их своим
                            триггером, а триггер шаблона по части — нет.
                        -->
                        <!--
                            Слой наведения проявляется за 120 мс и гаснет за 220:
                            приход быстрее ухода, и кнопка не «мигает» при проводке
                            мышью по ряду. Нажатие — темнее и мгновенно.
                        -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.07" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.13" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.07" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Главное действие раздела: одно на экран, иначе перестаёт быть главным.
        «Сигнал»: заливка AccentGradient (вертикаль «от подписи») с подписью
        OnAccent — пара, которую проверка читаемости сверяет у каждой темы.
        Свечение статичное и сдержанное: покой 10/.28, под мышью 16/.45,
        при нажатии гаснет до 8/.20. Это один из трёх элементов со свечением
        (ещё черта выбора и знак «Работает»).
    -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="local:Glow.Radius" Value="10" />
        <Setter Property="local:Glow.Strength" Value="0.28" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                <Setter Property="local:Glow.Radius" Value="16" />
                <Setter Property="local:Glow.Strength" Value="0.45" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="local:Glow.Radius" Value="8" />
                <Setter Property="local:Glow.Strength" Value="0.2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="local:Glow.Radius" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}" />
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        <Setter Property="Padding" Value="16,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Кнопка без рамки и подложки — «Не сейчас», «Скрыть», ссылки в подвале.
        Рамка и подложка появляются под мышью.
    -->
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{DynamicResource WashHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Выпадающий список. Шаблон переопределён целиком: стандартный тянет
        системные цвета, и на тёмном фоне выходит белый прямоугольник
        с невидимым текстом — ровно это и было видно в «Маршрутах».
    -->
    <Style TargetType="ComboBox">
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="{StaticResource HControl}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Shape"
                                            Background="{DynamicResource Raised}"
                                            BorderBrush="{DynamicResource FieldLine}"
                                            BorderThickness="{StaticResource Stroke}" CornerRadius="{StaticResource RMd}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--
                                                Выбранное рисуется шаблоном элемента, как
                                                в раскрытом списке. Без ContentTemplate
                                                строки выглядели как надо, а запись со
                                                шрифтом показывалась служебным видом
                                                «FontItem { Name = … }» (снимок 24.09).
                                            -->
                                            <ContentPresenter Grid.Column="0" Margin="10,6"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />

                                            <Path Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}"
                                                  StrokeThickness="1.4" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                                        </Trigger>
                                        <!-- Раскрытый список — рамка акцента, как у поля в фокусе. -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!--
                            Всплывающий список — отдельное окно, и масштаб главного
                            на него не действует: отсюда свой LayoutTransform.
                            Прокрутка и предел высоты обязательны: без них список
                            из трёхсот шрифтов рос во весь экран и обрезался его
                            краем (снимок владельца 24.09). ItemsPresenter, а не
                            StackPanel: так списку можно задать свою панель —
                            виртуальную для длинных.
                        -->
                        <!--
                            Поле вокруг рамки — место под тень (общая у всплывающих:
                            16 / 4 / .45); HorizontalOffset возвращает рамку под поле.
                        -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" HorizontalOffset="-10"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource Raised}"
                                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="{StaticResource Stroke}"
                                    CornerRadius="{StaticResource RLg}" Margin="10,2,10,16"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    LayoutTransform="{DynamicResource UiScaleTransform}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto" Margin="4"
                                              CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shape" Background="Transparent" CornerRadius="{StaticResource RSm}" Padding="8,4"
                            MinHeight="{StaticResource HControlSm}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Галка выбранного: признак не только цветом. -->
                            <Path x:Name="Tick" Data="M 0,5 L 3.5,8.5 L 10,1" Stroke="{DynamicResource Accent}"
                                  StrokeThickness="1.6" Width="11" Height="10" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поле ввода: та же беда со светлой подложкой, что у списка. -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}" />
        <Setter Property="MinHeight" Value="{StaticResource HControl}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--
                        Без Padding у рамки (0.18): поле само отдаёт Padding строке
                        ввода внутри PART_ContentHost, и рамка с тем же отступом
                        удваивала его — поле в 7 точек отступа выходило высотой 47.
                    -->
                    <Border x:Name="Shape" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource Stroke}"
                            CornerRadius="{StaticResource RMd}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" />

                            <!--
                                Подсказка (Hint.cs) встаёт туда же, где первая
                                буква. WPF сам отдаёт Padding поля прокрутке
                                внутри PART_ContentHost, поэтому текст стоит
                                на отступ правее рамки шаблона, а строка ввода
                                отходит от края ещё на 2. Отсюда Margin — Padding
                                поля, Padding — 2. По верху, а не по середине:
                                строка ввода тоже стоит по верху.
                            -->
                            <TextBlock x:Name="HintText" IsHitTestVisible="False"
                                       Margin="{TemplateBinding Padding}" Padding="2,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource Faint}"
                                       FontSize="{TemplateBinding FontSize}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{TemplateBinding local:Hint.Text}"
                                       Visibility="Collapsed" />
                            <!-- Нижняя полоса фокуса: внутри рамки, чтобы не менять раскладку. -->
                            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Background="{DynamicResource Accent}" CornerRadius="0,0,5,5" Opacity="0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                        </Trigger>
                        <!--
                            Фокус — рамка акцента и нижняя полоса, проявляющаяся за 120 мс.
                            Свечения нет (было в 0.18): поле — рабочий элемент, а не
                            источник света.
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Wash}" />
                            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="HintText" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Поле для скрытого ввода. Шаблон тот же, что у обычного: без него
        подложка остаётся системной, то есть белой, и точки не видно на белом.
    -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}" />
        <Setter Property="MinHeight" Value="{StaticResource HControl}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <!--
                        Без Padding у рамки (0.18): поле само отдаёт Padding строке
                        ввода внутри PART_ContentHost, и рамка с тем же отступом
                        удваивала его — поле в 7 точек отступа выходило высотой 47.
                    -->
                    <Border x:Name="Shape" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource Stroke}"
                            CornerRadius="{StaticResource RMd}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" />

                            <!-- Подсказка, как у TextBox; пустоту отмечает Hint.Empty. -->
                            <TextBlock x:Name="HintText" IsHitTestVisible="False"
                                       Margin="{TemplateBinding Padding}" Padding="2,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource Faint}"
                                       FontSize="{TemplateBinding FontSize}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{TemplateBinding local:Hint.Text}"
                                       Visibility="Collapsed" />
                            <!-- Нижняя полоса фокуса: внутри рамки, чтобы не менять раскладку. -->
                            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Background="{DynamicResource Accent}" CornerRadius="0,0,5,5" Opacity="0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                        </Trigger>
                        <!--
                            Фокус — рамка акцента и нижняя полоса, проявляющаяся за 120 мс.
                            Свечения нет (было в 0.18): поле — рабочий элемент, а не
                            источник света.
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Wash}" />
                            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="local:Hint.Empty" Value="True">
                            <Setter TargetName="HintText" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Строка выбора: пресет, резолвер, сервер. Выбранное отмечается
        присоединённым свойством Selector.IsSelected="True" на кнопке (оно
        есть у любого элемента): подложка AccentSoft, рамка AccentLine
        и точка слева — признак не только цветом. Свечения нет.
    -->
    <Style x:Key="Choice" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shape"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{StaticResource Stroke}"
                                CornerRadius="{StaticResource RMd}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Press" CornerRadius="{StaticResource RMd}" Background="{DynamicResource Text}"
                                Opacity="0" IsHitTestVisible="False" />
                        <Ellipse x:Name="Dot" Width="6" Height="6" Margin="4,0,0,0" HorizontalAlignment="Left"
                                 VerticalAlignment="Center" IsHitTestVisible="False"
                                 Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="0.13" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Заголовок папки. Нажимается строка целиком, а не значок: попасть
        в строку легче, чем в треугольник в её начале, а другого действия
        у заголовка нет — промахнуться не во что.
    -->
    <Style x:Key="Folder" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="{StaticResource Stroke}"
                            CornerRadius="{StaticResource RLg}"
                            Padding="14,10"
                            MinHeight="64">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Командная полоса (0.18) — верх окна во всю ширину. Слева знак, затем
        пять разделов на каждый день текстовыми вкладками, справа инструменты
        значками, журнал и состояние движков. Выбранное отмечает одна
        акцентная черта под полосой, которая переезжает от пункта к пункту
        (MainWindow.MoveIndicator), — а не подложка у каждого пункта.

        Почему не боковая колонка: колонка с теми же тринадцатью пунктами
        в том же порядке — чужая композиция, от которой Zephyron
        ушёл; и не всплывающее «Ещё», как в 0.16: спрятанный раздел
        не видно, даже когда он открыт.
    -->
    <!--
        Подписи вкладок и значки вместо них. На узком окне вкладки сжимаются
        до значков (MainWindow.FitNav): окно подменяет эти ресурсы у себя.
    -->
    <Visibility x:Key="NavLabel">Visible</Visibility>
    <Visibility x:Key="NavIcon">Collapsed</Visibility>
    <Thickness x:Key="NavGlyphGap">0</Thickness>

    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="Sections" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Shape" Background="Transparent" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!--
                                Знак шрифта или фигура (MenuIcon.Shape — самолётик
                                Telegram у «TG Proxy») — одним цветом: фигура берёт
                                цвет знака. Виден только в сжатой полосе.
                            -->
                            <Grid Width="18" Visibility="{DynamicResource NavIcon}" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph"
                                           Text="{Binding (local:MenuIcon.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{DynamicResource IconFont}" FontSize="16"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" />
                                <Path Data="{Binding (local:MenuIcon.Shape), RelativeSource={RelativeSource TemplatedParent}}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, ElementName=Glyph}" />
                            </Grid>

                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource Muted}" Visibility="{DynamicResource NavLabel}"
                                       FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />

                            <!-- Точка «есть новое» (RailBadge.cs). -->
                            <Rectangle x:Name="Badge" Width="6" Height="6" Margin="6,-8,0,0" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:RailBadge.Shown" Value="True">
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <!-- Фон вкладки не заливается: нажатие — только приглушение. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Инструмент — значок в квадрате, имя — подсказкой. Открытый подсвечен
        и отмечен чертой; назван он шапкой раздела. Своим именем в полосе
        он не раскрывается: полоса меняла бы ширину от раздела к разделу.
    -->
    <Style x:Key="ToolItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="Sections" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Shape" Background="Transparent" CornerRadius="{StaticResource RMd}"
                            Height="{StaticResource HControl}" Width="{StaticResource HControl}">
                        <TextBlock x:Name="Glyph"
                                   Text="{Binding (local:MenuIcon.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{DynamicResource IconFont}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Журнал — значком, как инструмент; открытая панель подсвечивает его. -->
    <Style x:Key="NavMore" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shape" Background="Transparent" CornerRadius="{StaticResource RMd}"
                            Width="{StaticResource HControl}" Height="{StaticResource HControl}">
                        <TextBlock x:Name="Glyph" FontFamily="{DynamicResource IconFont}" FontSize="16"
                                   Text="{Binding (local:MenuIcon.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Состояние движков справа в полосе: знак состояния (StateMark) и слово.
        Слово остаётся Muted — цвет несёт только знак. Нажатие ведёт на
        «Главную», где их запускают и останавливают.
    -->
    <Style x:Key="NavStatus" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
