    <!--
        Подсказка. Своя, потому что стандартная в теме выглядит чужой
        и, главное, не переносит строк: длинное пояснение уезжает одной
        строкой за край экрана — а именно длинные пояснения мы в подсказки
        и убираем.

        Ширина ограничена: строка в полторы тысячи точек читается хуже,
        чем абзац в четыреста, даже если поместилась.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="HasDropShadow" Value="False" />
        <!-- Поле вокруг рамки под тень; смещение возвращает рамку к курсору. -->
        <Setter Property="HorizontalOffset" Value="-10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
                        <Border x:Name="Shell" Margin="10,4,10,16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RMd}" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <!--
                                Перенос — здесь, для строки в ToolTip="…": её
                                ContentPresenter рисует своим TextBlock без
                                переноса, и всё длиннее MaxWidth срезалось
                                («…Нужно, есл» у «Перечитать» — №18, и снимки
                                владельца 10.10). Значки «i» переносили сами —
                                у них TextBlock свой. BasedOn — чтобы шрифт
                                и цвет остались общими.
                            -->
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <!-- Появление — прозрачностью за 120 мс, без сдвига; скрытие мгновенное. -->
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Значок «подробнее». Пояснения, которые прежде стояли абзацами
        над списком, переехали сюда: список маршрутов занимал треть
        полосы, и владелец 21.09 попросил его удлинить.

        Подсказка берётся из Content, чтобы место применения выглядело
        одной строкой и текст стоял рядом с тем, что объясняет.

        Поле вокруг значка заметно больше его самого: сам он восемь точек
        на восемь, и попасть мышью в такое кольцо нельзя. Наводят
        на область, а видят знак.
    -->
    <Style x:Key="Info" TargetType="ContentControl">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!--
                        Щелчком тоже (InfoTip) и без секундной паузы: жалоба
                        03.10 — значок нажимали, а подсказка не открывалась.
                    -->
                    <Border Background="Transparent" Padding="6,4"
                            local:InfoTip.OpensOnClick="True"
                            ToolTipService.InitialShowDelay="200">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" />
                            </ToolTip>
                        </Border.ToolTip>

                        <Path x:Name="Glyph" Data="{StaticResource InfoGlyph}"
                              Fill="{DynamicResource Muted}" Stretch="Uniform"
                              Width="13" Height="13"
                              RenderTransformOrigin="0.5,0.5">
                            <!--
                                Переворот по вертикали: исходник обведён
                                potrace с отрицательным масштабом по Y,
                                и без этого буква стоит вверх ногами —
                                точка внизу, палочка вверху.
                            -->
                            <Path.RenderTransform>
                                <ScaleTransform ScaleY="-1" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<!--
        Список настроек в духе Happ: одна карточка, много строк, волосяные
        разделители. Взято оттуда намеренно — и вот что именно.

        Одна карточка на все строки вместо карточки на настройку. У нас было
        второе, и пять настроек занимали пятьсот точек высоты, оттесняя список
        подписок за нижний край.

        Справа — состояние, а не действие. «Выкл.», «IPv4», «Отключено».
        Кнопка с подписью-действием подводила нас дважды: переключатель DNS
        и кнопка сортировки, — и оба раза владелец говорил, что нужный
        вариант пропал.

        Пояснений в строках нет вовсе. Тому, что не помещается в подпись,
        место под значком «i».
    -->
    <Style x:Key="SettingsGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardRim}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="CornerRadius" Value="{StaticResource RLg}" />
        <Setter Property="local:Glass.IsOn" Value="True" />
    </Style>

    <!--
        Боковое меню. Фон — стилем, а не в разметке окна: стекло (Glass.cs)
        при выключении сбрасывает фон, и стиль после сброса возвращается сам.
        RailFill — подложка цвета подложки у встроенных тем и плотная
        плашка у тем с картинкой (владелец, 23.09: «шрифт становится
        слишком незаметен, стоит сделать подложку»).
    -->
    <Style x:Key="RailPanel" TargetType="Border">
        <!-- С 0.18 — командная полоса во всю ширину окна: без плашки и тени,
             отделена от раздела волосяной линией снизу. -->
        <Setter Property="Background" Value="{DynamicResource RailFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource NavInset}" />
        <Setter Property="Height" Value="{StaticResource NavHeight}" />
        <Setter Property="local:Glass.IsOn" Value="True" />
    </Style>

    <!--
        Разделитель между строками. Волосяной и не доходящий до краёв:
        сплошная линия во всю ширину режет карточку на отдельные, и смысл
        их объединения теряется.
    -->
    <Style x:Key="RowLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Border}" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <!--
        Тумблер.

        Состояние названо и словом рядом — в разметке, — и видом. Одного вида
        мало: «включено» и «выключено» у тумблера различаются положением
        кружка, а это единственный признак, который теряется при беглом
        взгляде и исчезает вовсе у тех, кто плохо различает оттенки.
    -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    «Сигнал»: дорожка 36x20 со скруглением 10, бегунок 14, без
                    свечения. Выключен — Raised с рамкой FieldLine и бегунком Muted;
                    включён — дорожка Accent без рамки, бегунок OnAccent (чернила
                    подписи кнопки: на тёмной теме тёмный, на светлой белый — те же,
                    что читаются на акценте). Ход 140 мс, CubicEase, без перелёта.
                -->
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="10"
                                Background="{DynamicResource Raised}"
                                BorderBrush="{DynamicResource FieldLine}"
                                BorderThickness="{StaticResource Stroke}">
                            <Border x:Name="KnobBox" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Background="{DynamicResource Muted}" CornerRadius="7" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="KnobScale" />
                                        <TranslateTransform x:Name="KnobShift" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <!-- Слой наведения поверх включённой дорожки. -->
                        <Border x:Name="HoverLayer" CornerRadius="10" Background="{DynamicResource Text}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="KnobBox" Property="Background" Value="{DynamicResource OnAccent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Muted}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.12" />
                        </MultiTrigger>

                        <!-- Нажатие: бегунок чуть шире (ScaleX 1.15), отпускание — обратно. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.15" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Заголовок группы: тихий, мелкий, над карточкой. Оттуда же —
        он отделяет группы, не занимая карточки собой.
    -->
    <Style x:Key="GroupHead" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Margin" Value="4,0,0,7" />
    </Style>



    <!--
        Полоса прокрутки (владелец, 23.09: «она белая и выбивается из темы»).
        Системная рисуется цветами Windows и про тему не знает вовсе.
        Здесь — тонкая дорожка без стрелок и скруглённый ползунок цвета
        рамки; при наведении он светлеет, при перетаскивании — ещё.
        Стиль без ключа, поэтому достаётся всем полосам окна, включая
        выпадающие списки. Цвета — из палитры, и в чужой теме полоса
        перекрасится вместе с остальным.
    -->
    <!--
        Бегунок: LineStrong в покое, под мышью — Muted вполсилы и шире
        (ScaleX 1.6 от правого края, 120 мс), при перетаскивании — Accent.
        Для горизонтальной полосы — свой (ScrollThumbH): растёт по высоте.
    -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource LineStrong}" CornerRadius="3"
                            RenderTransformOrigin="1,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Grow" />
                        </Border.RenderTransform>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Muted}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="0.5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX"
                                                         To="1.6" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbH" TargetType="Thumb" BasedOn="{StaticResource ScrollThumb}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource LineStrong}" CornerRadius="3"
                            RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Grow" />
                        </Border.RenderTransform>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Muted}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="0.5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY"
                                                         To="1.6" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Полоса: область попадания 12, видимый бегунок 6 (по 3 с боков), трек
        прозрачный, стрелок нет.
    -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" Padding="3,2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" Padding="2,3">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbH}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Значки — системным шрифтом значков Windows: Segoe Fluent Icons
        в Windows 11, Segoe MDL2 Assets в 10. Линейные, как в Happ
        (владелец, 28.09: «и значки как в хаппе»), и в цвет темы.
    -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!--
        Квадратная кнопка со значком: ⟳, ⏱, ⋯ у подписки. 32x32, глиф 16,
        без подложки и рамки — они появляются под мышью. Имя для скринридера
        (AutomationProperties.Name) задаёт место применения: у значка нет подписи.
    -->
    <Style x:Key="IconGhost" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="{StaticResource HControl}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{DynamicResource WashHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Выпадающее меню (⋯ у подписки). Стандартное меню Windows в тёмной
        теме — белое пятно с системным шрифтом; здесь — карточка темы.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <!-- Поле вокруг рамки под тень; смещение возвращает рамку к месту вызова. -->
        <Setter Property="HorizontalOffset" Value="-10" />
        <Setter Property="VerticalOffset" Value="-4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
                        <Border x:Name="Shell" Margin="10,4,10,16" Padding="4" MinWidth="220"
                                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource LineStrong}"
                                BorderThickness="{StaticResource Stroke}" CornerRadius="{StaticResource RLg}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Slide" />
                            </Border.RenderTransform>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                    <!-- Открытие: прозрачность и подъём на 4 точки за 120 мс. -->
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y"
                                                     From="-4" To="0" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource RSm}" Padding="10,4"
                            MinHeight="{StaticResource HControlSm}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <!-- Галка отмеченного пункта (IsChecked) — слева, в колонке значка. -->
                            <Path x:Name="Tick" Grid.Column="0" Data="M 0,5 L 3.5,8.5 L 10,1" Stroke="{DynamicResource Accent}"
                                  StrokeThickness="1.6" Width="11" Height="10" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Faint}" FontSize="11" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource WashHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuLine" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Плитка со значком слева от заголовка карточки — по макету «Главной»
        владельца (30.09). Плитка, а не голый знак: у карточек разная высота
        текста, и знак без подложки висел бы то выше, то ниже заголовка.
    -->
    <!-- С 0.16 плитка светится акцентом: подложка AccentSoft и рамка AccentLine. -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource RMd}" />
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="BorderThickness" Value="{StaticResource Line}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="TileGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Мелкий значок в строке текста: «Сервер», «DNS», кнопки быстрых действий. -->
    <Style x:Key="LineGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        То же место, что LineGlyph, для фигуры (TelegramPlane, GitHubMark) —
        в кнопке, её цветом. Знак шрифта 15 занимает около 14 точек: фигура
        во всю клетку выглядела бы крупнее соседей.
    -->
    <Style x:Key="LineShape" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!--
        Прокрутка страницы: полоса поверх правого отступа, а не рядом с ним.
        Стандартная отводит под полосу свою колонку, и появлялась она ровно
        тогда, когда содержимое вырастало, — карточки сужались на её ширину
        посреди работы. Владелец 27.09 поймал это на VPN: раскрыл подписку,
        и все прямоугольники стали на 12 точек уже. Отступ страницы 32,
        полоса 10 — ложится в отступ, ничего не закрывая.
    -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,8,4"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ====================================================================
        «Сигнал»: неявные стили для элементов, у которых раньше своего не было
        (владелец: «голые» CheckBox, RadioButton, ListBox, Slider, ProgressBar
        выходили светлыми системными). Явные стили со своим шаблоном
        (Tick в hosts, ModeCard, ModeSegment, RailItem) их не наследуют.
        ====================================================================
    -->

    <!-- Флажок: 16x16, галка — фигурой (не знаком шрифта), «частично» — чёрточкой. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="{StaticResource HControlSm}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="4" Background="{DynamicResource Raised}"
                                    BorderBrush="{DynamicResource FieldLine}" BorderThickness="{StaticResource Stroke}" />
                            <Border x:Name="Press" CornerRadius="4" Background="{DynamicResource Text}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="Mark" Data="M 3.5,8.2 L 6.6,11.2 L 12.5,4.8" Stroke="{DynamicResource OnAccent}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                            <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource OnAccent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="0.13" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кружок выбора для «голых» RadioButton: выбранный отличается формой (точка), не только цветом. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" MinHeight="{StaticResource HControlSm}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{DynamicResource Raised}" Stroke="{DynamicResource FieldLine}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Press" Fill="{DynamicResource Text}" Opacity="0" IsHitTestVisible="False" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="0.13" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Рамка клавиатурного фокуса внутри элемента списка: снаружи её срезал бы ScrollViewer. -->
    <Style x:Key="ListItemRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="0" BorderThickness="{StaticResource FocusWidth}" CornerRadius="{StaticResource RSm}"
                            BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RMd}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Выбранный в фокусе — AccentSoft и полоса Accent слева; без фокуса — Wash и полоса Muted. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ListItemRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="1" SnapsToDevicePixels="True">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="{StaticResource RSm}"
                                Padding="10,4" MinHeight="{StaticResource HControlSm}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Rectangle x:Name="Bar" Width="2" Margin="0,5" HorizontalAlignment="Left" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource Muted}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Wash}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Accent}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ползунок. Только горизонтальный (вертикальных в программе нет).
        Значение показывает место применения числом рядом (12 Mono).
    -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Grow" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{DynamicResource Text}" Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                        <Ellipse x:Name="Press" Fill="{DynamicResource Text}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="0.13" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="24" SnapsToDevicePixels="True">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource LineStrong}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Полоса хода. Определённая — заполнение по значению, без анимации
        ширины. Неопределённая — сегмент идёт слева направо по кругу 1400 мс
        линейно: сжатый по ширине до 30 % слой, у которого анимируется точка
        опоры (RenderTransformOrigin), а не размер, — раскладка не трогается.
        Всегда нужна подпись рядом («Загрузка…») и AutomationProperties.Name.
    -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Background" Value="{DynamicResource LineStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                        <Border x:Name="Flow" CornerRadius="2" Background="{TemplateBinding Foreground}"
                                Visibility="Collapsed" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <!-- Покой (анимации выключены): статичные 40 % слева. -->
                                <ScaleTransform x:Name="FlowScale" ScaleX="0.4" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Flow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--
                            ВЫКЛЮЧАТЕЛЬ ПО Motion.Enabled: полоса бежит, только когда
                            IsIndeterminate и движение не выключено (Motion.Still — наследуемое
                            свойство окна, его ведёт Motion по Changed: тумблер «Анимации»,
                            Windows, высокий контраст, профиль «Лёгкий»). Иначе стоит статичный
                            сегмент 40 % (ScaleX в покое). Сториборд снимается при смене Still.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsIndeterminate" Value="True" />
                                <Condition Property="local:Motion.Still" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="FlowRun">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FlowScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.3" Duration="0:0:0" />
                                        <PointAnimation Storyboard.TargetName="Flow" Storyboard.TargetProperty="RenderTransformOrigin"
                                                        From="-0.4286,0.5" To="1.4286,0.5" Duration="0:0:1.4"
                                                        RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FlowRun" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ====================================================================
        Состояния «пусто», «загрузка», «ошибка». Заголовок и подсказка —
        присоединёнными PageHead.Title / PageHead.Subtitle (как у PageHead),
        кнопка действия — содержимым.
        ====================================================================
    -->
    <Style x:Key="EmptyState" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
                        <!-- Глиф «узел-связь»: три узла и две связи, контуром. -->
                        <Path Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"
                              Stroke="{DynamicResource Faint}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Data="M 3,22 A 3,3 0 1 1 9,22 A 3,3 0 1 1 3,22 Z M 21,8 A 3,3 0 1 1 27,8 A 3,3 0 1 1 21,8 Z M 21,24 A 3,3 0 1 1 27,24 A 3,3 0 1 1 21,24 Z M 8.1,20.2 L 21.9,9.8 M 9,22.3 L 21,23.7" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Title)}" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360" Style="{StaticResource Caption}"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Subtitle)}" />
                        <ContentPresenter x:Name="Action" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Загрузка: полоса 160 и подпись; заголовок по умолчанию «Загрузка…», место применения уточняет. -->
    <Style x:Key="BusyState" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="local:PageHead.Title" Value="Загрузка…" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
                        <ProgressBar Width="160" IsIndeterminate="True"
                                     AutomationProperties.Name="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Title)}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Title)}" />
                        <ContentPresenter x:Name="Action" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ошибка: что случилось (Title) и что делать (Subtitle); кнопки «Повторить», «Подробности» — содержимым. -->
    <Style x:Key="ErrorState" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}"
                            BorderThickness="{StaticResource Stroke}" CornerRadius="{StaticResource RMd}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Треугольник со знаком «!»: ошибка узнаётся не только цветом. -->
                            <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,12,0"
                                  Fill="{DynamicResource Danger}"
                                  Data="F0 M 8,1.5 L 15,14.5 L 1,14.5 Z M 7.2,6 L 8.8,6 L 8.8,10.5 L 7.2,10.5 Z M 7.2,11.7 L 8.8,11.7 L 8.8,13.2 L 7.2,13.2 Z" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Title)}" />
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PageHead.Subtitle)}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Знак состояния: форма + слово + цвет. Состояние задаётся Tag
        («Off», «Starting», «Running», «Degraded», «Failed»); по умолчанию —
        кольцо «Выключен». Размер — Width/Height (по умолчанию 16), фигуры
        масштабируются Viewbox. Это Path, а не знак шрифта.
        AutomationProperties.Name — слово состояния.
    -->
    <Style x:Key="StateMark" TargetType="Control">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.Name" Value="Выключен" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="16" Height="16">
                            <Ellipse x:Name="Ring" Margin="1.5" Stroke="{DynamicResource Muted}" StrokeThickness="2" />
                            <Path x:Name="Arc" Width="16" Height="16" Stretch="None" Visibility="Collapsed"
                                  Data="M 8,1.5 A 6.5,6.5 0 1 1 1.5,8" Stroke="{DynamicResource Accent}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="Spin" />
                                </Path.RenderTransform>
                            </Path>
                            <Ellipse x:Name="Disc" Margin="1.5" Fill="{DynamicResource Success}" Visibility="Collapsed" />
                            <Path x:Name="Diamond" Width="16" Height="16" Stretch="None" Visibility="Collapsed"
                                  Data="M 8,1 L 15,8 L 8,15 L 1,8 Z" Fill="{DynamicResource Warn}" />
                            <Path x:Name="Triangle" Width="16" Height="16" Stretch="None" Visibility="Collapsed"
                                  Data="F0 M 8,1.5 L 15,14.5 L 1,14.5 Z M 7.2,6 L 8.8,6 L 8.8,10.5 L 7.2,10.5 Z M 7.2,11.7 L 8.8,11.7 L 8.8,13.2 L 7.2,13.2 Z"
                                  Fill="{DynamicResource Danger}" />
                        </Grid>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Starting">
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Arc" Property="Visibility" Value="Visible" />
                            <Setter Property="AutomationProperties.Name" Value="Запуск" />
                        </Trigger>
                        <!--
                            ВЫКЛЮЧАТЕЛЬ ПО Motion.Enabled: дуга вращается, только пока движение
                            не выключено (Motion.Still, см. ProgressBar выше); иначе стоит.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Starting" />
                                <Condition Property="local:Motion.Still" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinRun">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SpinRun" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="Tag" Value="Running">
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Disc" Property="Visibility" Value="Visible" />
                            <Setter Property="AutomationProperties.Name" Value="Работает" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Degraded">
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Diamond" Property="Visibility" Value="Visible" />
                            <Setter Property="AutomationProperties.Name" Value="Работает частично" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Failed">
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Triangle" Property="Visibility" Value="Visible" />
                            <Setter Property="AutomationProperties.Name" Value="Сбой" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
