<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Светлая пара к тёмному «Сигналу». Ключи те же до последнего: стили
        в Controls.xaml опираются только на них и про тему не знают вовсе.
        Поэтому переключение — это подмена одного словаря, а не второй набор
        стилей, который пришлось бы править парами.

        Холодный светло-серый с белыми карточками и тем же синим акцентом,
        только глубже: на белом светлый акцент теряет контраст. Смысл цветов
        состояния тот же — «работает», «требует внимания», «сбой», — иначе
        человек, сменивший тему, начал бы читать таблицу заново.

        Контраст проверяется ThemeContrast по тем же парам, что и тёмная:
        текст, приглушённый и бледный проходят AA.

        Значения совпадают с themes/light/theme.json — расхождение ловит тест
        ThemeFilesMatchXamlPalettes.
    -->

    <Color x:Key="BackdropColor">#FFEEF0F3</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="RaisedColor">#FFF5F6F8</Color>
    <Color x:Key="BorderColor">#FFD5D9E0</Color>

    <Color x:Key="TextColor">#FF14171C</Color>
    <Color x:Key="MutedColor">#FF4A5260</Color>
    <Color x:Key="FaintColor">#FF646C7A</Color>

    <Color x:Key="AccentColor">#FF0B6BCB</Color>
    <Color x:Key="WindowColor">#FF0B6BCB</Color>
    <Color x:Key="AccentDimColor">#FFD6E8FA</Color>
    <Color x:Key="DangerColor">#FFC0262D</Color>
    <Color x:Key="WarnColor">#FF8A5200</Color>

    <!--
        Заливки отдельно от текста, и это не украшательство. На светлом фоне
        одно значение не может служить обоим: жёлтый, читаемый как текст
        на белом, должен быть тёмным, а тёмная заливка с тёмной подписью
        сливается в грязь. Ключи есть в обеих палитрах, иначе стиль кнопки
        пришлось бы писать дважды.
    -->
    <Color x:Key="AccentFillColor">#FF0E74D8</Color>
    <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
    <Color x:Key="WarnFillColor">#FFB26A00</Color>

    <SolidColorBrush x:Key="Backdrop" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />

    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="WarnFill" Color="{StaticResource WarnFillColor}" />

    <!-- Производные — те же доли, что в Themes.Derive (светлая ветка плотнее тёмной). -->
    <SolidColorBrush x:Key="AccentSoft" Color="#1A0B6BCB" />
    <SolidColorBrush x:Key="AccentLine" Color="#590B6BCB" />
    <SolidColorBrush x:Key="DangerSoft" Color="#14C0262D" />
    <SolidColorBrush x:Key="DangerLine" Color="#66C0262D" />
    <SolidColorBrush x:Key="WarnSoft" Color="#148A5200" />
    <SolidColorBrush x:Key="WarnLine" Color="#668A5200" />
    <SolidColorBrush x:Key="Wash" Color="#0814171C" />
    <SolidColorBrush x:Key="WashHover" Color="#1014171C" />
    <SolidColorBrush x:Key="LineStrong" Color="#3814171C" />
    <SolidColorBrush x:Key="FieldLine" Color="#B34A5260" />
    <SolidColorBrush x:Key="Scrim" Color="#B3EEF0F3" />
    <!-- Мягкая тень под карточкой: на светлом фоне иначе теряется (Themes.Derive). -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#000000" RenderingBias="Performance" />

    <LinearGradientBrush x:Key="CardRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F14171C" Offset="0" />
        <GradientStop Color="#1414171C" Offset="1" />
    </LinearGradientBrush>
    <!-- «Работает» — как акцент, пока тема не задала свой (ThemeSlots.Default, 28.10). -->
    <Color x:Key="SuccessColor">#FF0B6BCB</Color>
    <SolidColorBrush x:Key="Success" Color="#FF0A7A4F" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#140A7A4F" />
    <SolidColorBrush x:Key="SuccessLine" Color="#660A7A4F" />
    <!-- Второй акцент и градиенты (Themes.Derive): тон акцента +60° с зажимом. -->
    <Color x:Key="Accent2Color">#FF6B10C6</Color>
    <SolidColorBrush x:Key="Accent2" Color="#FF6B10C6" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0E74D8" Offset="0" />
        <GradientStop Color="#FF0C67C0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFlow" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0B6BCB" Offset="0" />
        <GradientStop Color="#FF6B10C6" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="Decor">1</sys:Double>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!--
        Фон окна для тем с картинкой (Themes.cs). У встроенных картинки нет:
        слой прозрачен, затемнение сплошное, меню — цвета подложки.
    -->
    <SolidColorBrush x:Key="BackdropImage" Color="Transparent" />
    <sys:Double x:Key="BackdropDim">1</sys:Double>
    <SolidColorBrush x:Key="Chrome" Color="Transparent" />
    <SolidColorBrush x:Key="RailFill" Color="#E6FFFFFF" />
    <!-- Арт сбоку на «Главной» (Themes.cs): у встроенных тем картинки нет, колонка пуста. -->
    <SolidColorBrush x:Key="SideArt" Color="Transparent" />
    <ScaleTransform x:Key="UiScaleTransform" ScaleX="1" ScaleY="1" />

</ResourceDictionary>
