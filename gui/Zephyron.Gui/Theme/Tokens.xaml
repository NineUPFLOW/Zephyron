<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Токены оформления Zephyron — нижний слой системы дизайна.

        Здесь только то, что не зависит от темы: скругления, отступы, размеры
        и толщины. Цвета и шрифты темой управляются, поэтому живут в
        Palette.xaml и в theme.json, а не тут. Разделение намеренное: попади
        скругления в тему, каждая правка разметки ломала бы чужие темы,
        и чинить их пришлось бы нам (см. Theme.cs).

        Имена — по роли, а не по значению: RLg, а не «16». Значение при
        пересмотре меняется в одном месте, и вся программа едет за ним.

        Стили берут токены через StaticResource: значение известно на разбор,
        а не на бегу, — и это отличает токен оформления от цвета темы,
        который обязан меняться вживую (DynamicResource).

        Числа сходятся с docs/design-system.md; расхождение ловит
        DesignTokensMatchTheDocument.
    -->

    <!-- Скругления. XL и Pill — для карточек-плиток и кнопок-таблеток.
         Ровно CornerRadius, а не Double: свойство принимает только структуру,
         а голое число для него неподходящего вида — «"12" не является
         допустимым значением для свойства "CornerRadius"», — и это роняло
         разбор шаблона, как раньше дробная толщина (см. Stroke). -->
    <!-- С 0.18 скругления вдвое мельче: 4/6/8 — мера Windows 11. Крупные
         радиусы при плотном окне превращали каждую строку в «таблетку». -->
    <CornerRadius x:Key="RSm">4</CornerRadius>
    <CornerRadius x:Key="RMd">6</CornerRadius>
    <CornerRadius x:Key="RLg">8</CornerRadius>
    <CornerRadius x:Key="RXL">12</CornerRadius>
    <!-- С 0.16 «таблетка» — не овал, а метка с малым скруглением:
         овальные плашки владелец 22.10 назвал «бредом». -->
    <CornerRadius x:Key="RPill">4</CornerRadius>

    <!-- Шаг отступов: 4 → 32. Рядом стоящие значения берутся из одной шкалы,
         чтобы у соседних карточек и строк был один ритм. -->
    <sys:Double x:Key="S1">4</sys:Double>
    <sys:Double x:Key="S2">8</sys:Double>
    <sys:Double x:Key="S3">12</sys:Double>
    <sys:Double x:Key="S4">16</sys:Double>
    <sys:Double x:Key="S5">24</sys:Double>
    <sys:Double x:Key="S6">32</sys:Double>

    <!-- Размеры оболочки окна: предел ширины содержимого «Главной»
         и знак программы в командной полосе. -->
    <sys:Double x:Key="ContentMax">1120</sys:Double>
    <sys:Double x:Key="MarkSize">22</sys:Double>

    <!-- Высоты: элемент управления (кнопки, поля, списки), мелкая строка
         (таблицы, пункты меню; для касания не ниже 24) и командная полоса. -->
    <sys:Double x:Key="HControl">32</sys:Double>
    <sys:Double x:Key="HControlSm">28</sys:Double>
    <sys:Double x:Key="NavHeight">52</sys:Double>

    <!-- Поля страницы раздела. Плотнее прежних: окно рассчитано на 880 точек. -->
    <Thickness x:Key="PagePad">24,20,24,24</Thickness>
    <Thickness x:Key="CardPad">16,14,16,14</Thickness>

    <!-- Поля командной полосы по краям окна. -->
    <Thickness x:Key="NavInset">14,0,14,0</Thickness>

    <!-- Толщина линий и рамок. Тонкая для разделителей, обычная для границ.
         Ровно Thickness, а не Double: WPF подставляет число в BorderThickness,
         переводя его в строку по текущей культуре, — на русской Windows это
         «1,5», а разбор толщин принимает только точку, и шаблон падал с
         XamlParseException при открытии меню (11.10). Объект Thickness
         разбору не подвергается вовсе. -->
    <Thickness x:Key="Line">1</Thickness>
    <!-- С 0.16 рамки волосяные, как разделители: карточку отделяет
         от подложки цвет рамки, а не её толщина. -->
    <Thickness x:Key="Stroke">1</Thickness>
    <!-- Толщина рамки фокуса клавиатуры (FocusRing). -->
    <Thickness x:Key="FocusWidth">2</Thickness>

</ResourceDictionary>
