<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Тёмная «Зефирная» — основная палитра Zephyron и запас, если папки тем
        нет. Уютная, в мягком сиреневом подтоне, с зефирно-розовым акцентом:
        так обход не выглядит угрозой, а выглядит заботой.

        Смысл цветов состояния сохранён ровно тот же, что был: акцент значит
        «работает», красный «закрыто», жёлтый «требует внимания», и в отчёте
        они значат то же самое. Перекрашены оттенки, а не роли.

        Значения совпадают с themes/dark/theme.json — расхождение ловит тест
        ThemeFilesMatchXamlPalettes.
    -->

    <Color x:Key="BackdropColor">#FF17131F</Color>
    <Color x:Key="SurfaceColor">#FF221C2E</Color>
    <Color x:Key="RaisedColor">#FF2C2439</Color>
    <Color x:Key="BorderColor">#FF3E3350</Color>

    <Color x:Key="TextColor">#FFF4EEFB</Color>
    <Color x:Key="MutedColor">#FFBCB0CE</Color>
    <Color x:Key="FaintColor">#FF8F85A3</Color>

    <Color x:Key="AccentColor">#FFFF8FC0</Color>
    <Color x:Key="AccentDimColor">#FF7A3F63</Color>
    <Color x:Key="DangerColor">#FFFF7A8A</Color>
    <Color x:Key="WarnColor">#FFFFC978</Color>

    <!--
        Заливка кнопки и подпись на ней. На тёмном фоне они почти совпадают
        с обычными, но ключи заведены и здесь: стиль кнопки один на обе темы,
        и без них его пришлось бы писать дважды. На светлом они расходятся
        по-настоящему — там текстовый зелёный обязан быть тёмным, а заливка
        с тёмной подписью сливается в грязь.
    -->
    <Color x:Key="AccentFillColor">#FFFF8FC0</Color>
    <Color x:Key="OnAccentColor">#FF2A0F1E</Color>
    <Color x:Key="WarnFillColor">#FFFFC978</Color>

    <SolidColorBrush x:Key="Backdrop" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />

    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="WarnFill" Color="{StaticResource WarnFillColor}" />

    <!--
        Шрифт назван явно. По умолчанию WPF берёт Segoe UI в начертании,
        которое на тёмном фоне выглядит тоньше, чем задумано, — а цифры
        в таблице проверки должны читаться с одного взгляда.
    -->
    <!-- Comfortaa — основной: округлый и мягкий, в тон милому оформлению.
         Segoe UI — запас, если её нет в системе. -->
    <FontFamily x:Key="UiFont">Comfortaa, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="DisplayFont">Comfortaa, Segoe UI</FontFamily>

    <!--
        Фон окна для тем с картинкой (Themes.cs). У встроенных картинки нет:
        слой прозрачен, затемнение сплошное, меню — цвета подложки.
    -->
    <SolidColorBrush x:Key="BackdropImage" Color="Transparent" />
    <sys:Double x:Key="BackdropDim">1</sys:Double>
    <SolidColorBrush x:Key="Chrome" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="RailFill" Color="{StaticResource BackdropColor}" />
    <!-- Арт сбоку на «Главной» (Themes.cs): у встроенных тем картинки нет, колонка пуста. -->
    <SolidColorBrush x:Key="SideArt" Color="Transparent" />
    <ScaleTransform x:Key="UiScaleTransform" ScaleX="1" ScaleY="1" />

</ResourceDictionary>
