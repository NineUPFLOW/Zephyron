<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Тёмная — основная палитра Zephyron и запас, если папки тем нет.
        Значения взяты из эталонного макета (docs/design/mockup.html, блок
        :root): почти чёрная подложка, нейтральные серо-синие поверхности
        и один голубой акцент. Это тёмная тема макета, а не отдельная
        выдумка: макет и есть договор оформления.

        Смысл цветов состояния сохранён ровно тот же, что был: зелёный значит
        «работает», красный «закрыто», жёлтый «требует внимания», и в отчёте
        они значат то же самое. Перекрашены оттенки, а не роли.

        Значения совпадают с themes/dark/theme.json — расхождение ловит тест
        ThemeFilesMatchXamlPalettes.
    -->

    <Color x:Key="BackdropColor">#FF08090F</Color>
    <Color x:Key="SurfaceColor">#FF14171F</Color>
    <Color x:Key="RaisedColor">#FF1A1E28</Color>
    <Color x:Key="BorderColor">#FF21252F</Color>

    <Color x:Key="TextColor">#FFEEF1F7</Color>
    <Color x:Key="MutedColor">#FFA8B0C2</Color>
    <Color x:Key="FaintColor">#FF7B849B</Color>

    <Color x:Key="AccentColor">#FF22D3EE</Color>
    <Color x:Key="AccentDimColor">#FF12566B</Color>
    <Color x:Key="DangerColor">#FFF43F5E</Color>
    <Color x:Key="WarnColor">#FFFBBF24</Color>

    <!--
        Заливка кнопки и подпись на ней. На тёмном фоне они почти совпадают
        с обычными, но ключи заведены и здесь: стиль кнопки один на обе темы,
        и без них его пришлось бы писать дважды. На светлом они расходятся
        по-настоящему — там текстовый зелёный обязан быть тёмным, а заливка
        с тёмной подписью сливается в грязь.
    -->
    <Color x:Key="AccentFillColor">#FF22D3EE</Color>
    <Color x:Key="OnAccentColor">#FF062126</Color>
    <Color x:Key="WarnFillColor">#FFFBBF24</Color>

    <!--
        Цвета, которых нет среди четырнадцати слотов темы: их макет
        (docs/design/mockup.html) зовёт ok, purple и «мягкими» оттенками
        (accent-soft, ok-soft и прочие). Заведены и в XAML, и в собранном
        словаре (Themes.cs), потому что оба вида палитры обязаны держать
        одни ключи — расхождение ловит ABuiltThemeHasEveryKeyOfTheXamlPalette.

        «Ok» — зелёный «работает»: макет красит им точку, пилюлю и полосу
        состояния, а голубой акцент оставляет кнопкам и меню. «Purple» —
        второй акцент макета: им подписан «подъём» в метрике сети. Мягкие —
        те же цвета в четверть силы: подложка выбранного пункта, пилюли
        состояния и баннеров. Прозрачностью, а не подмешиванием к фону:
        под карточкой бывает стекло и картинка темы.
    -->
    <Color x:Key="OkColor">#FF10B981</Color>
    <Color x:Key="PurpleColor">#FFA855F7</Color>
    <Color x:Key="AccentSoftColor">#1F22D3EE</Color>
    <Color x:Key="OkSoftColor">#1A10B981</Color>
    <Color x:Key="WarnSoftColor">#1AFBBF24</Color>
    <Color x:Key="ErrSoftColor">#1AF43F5E</Color>
    <Color x:Key="PurpleSoftColor">#1FA855F7</Color>

    <!--
        «Черты» макета (accent-line, ok-line и прочие): тот же цвет, но
        прозрачнее заливки. Ими обведены кнопка питания, метки состояния
        и баннеры — у макета рамка всегда мягче заливки, иначе элемент
        читается как нажатый. Значения — доли от цвета: 38 % у акцента,
        28 % у зелёного и жёлтого, 34 % у красного.
    -->
    <Color x:Key="AccentLineColor">#6122D3EE</Color>
    <Color x:Key="OkLineColor">#4710B981</Color>
    <Color x:Key="WarnLineColor">#47FBBF24</Color>
    <Color x:Key="ErrLineColor">#57F43F5E</Color>

    <!--
        Узор фона макета (.bg-grid, .glow-1/.glow-2). Сетка — цветом текста
        в два с лишним процента: на тёмной теме это светлые волосяные линии,
        на светлой — тёмные, и узор виден в обеих. Свечения — акцентом
        и сиреневым в десятую долю силы. Тема со своим фоном узор не рисует:
        он часть вида по умолчанию, а не всякой темы (Themes.Build кладёт
        BackdropDeco).
    -->
    <Color x:Key="BackdropGridColor">#06EEF1F7</Color>
    <Color x:Key="AccentGlowColor">#1A22D3EE</Color>
    <Color x:Key="PurpleGlowColor">#17A855F7</Color>

    <!-- Заливки баннеров (banner accent, banner warn): цвет в четыре
         с половиной процента — заметно как оттенок, не как плашка. -->
    <Color x:Key="BannerAccentColor">#0B22D3EE</Color>
    <Color x:Key="BannerWarnColor">#0AFBBF24</Color>

    <SolidColorBrush x:Key="Backdrop" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />

    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="WarnFill" Color="{StaticResource WarnFillColor}" />

    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="OkSoft" Color="{StaticResource OkSoftColor}" />
    <SolidColorBrush x:Key="WarnSoft" Color="{StaticResource WarnSoftColor}" />
    <SolidColorBrush x:Key="ErrSoft" Color="{StaticResource ErrSoftColor}" />
    <SolidColorBrush x:Key="PurpleSoft" Color="{StaticResource PurpleSoftColor}" />

    <SolidColorBrush x:Key="AccentLine" Color="{StaticResource AccentLineColor}" />
    <SolidColorBrush x:Key="OkLine" Color="{StaticResource OkLineColor}" />
    <SolidColorBrush x:Key="WarnLine" Color="{StaticResource WarnLineColor}" />
    <SolidColorBrush x:Key="ErrLine" Color="{StaticResource ErrLineColor}" />

    <SolidColorBrush x:Key="BackdropGrid" Color="{StaticResource BackdropGridColor}" />
    <SolidColorBrush x:Key="AccentGlow" Color="{StaticResource AccentGlowColor}" />
    <SolidColorBrush x:Key="PurpleGlow" Color="{StaticResource PurpleGlowColor}" />
    <SolidColorBrush x:Key="BannerAccent" Color="{StaticResource BannerAccentColor}" />
    <SolidColorBrush x:Key="BannerWarn" Color="{StaticResource BannerWarnColor}" />

    <!--
        Шрифт назван явно. По умолчанию WPF берёт Segoe UI в начертании,
        которое на тёмном фоне выглядит тоньше, чем задумано, — а цифры
        в таблице проверки должны читаться с одного взгляда. Segoe UI —
        основной шрифт, как в макете (Inter — его веб-родня, на Windows
        ближайший системный это Segoe UI).
    -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>

    <!--
        Фон окна для тем с картинкой (Themes.cs). У встроенных картинки нет:
        слой прозрачен, затемнение сплошное, меню — цвета подложки.
    -->
    <SolidColorBrush x:Key="BackdropImage" Color="Transparent" />
    <sys:Double x:Key="BackdropDim">1</sys:Double>

    <!--
        Виден ли узор фона (сетка и свечения макета). Единица — тема своего
        фона не несёт, и узор рисуется; ноль — у темы своя картинка или видео,
        и узор под ней был бы кашей из двух фонов (Themes.Build).
    -->
    <sys:Double x:Key="BackdropDecoOpacity">1</sys:Double>
    <SolidColorBrush x:Key="Chrome" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="RailFill" Color="{StaticResource BackdropColor}" />
    <!-- Арт сбоку на «Главной» (Themes.cs): у встроенных тем картинки нет, колонка пуста. -->
    <SolidColorBrush x:Key="SideArt" Color="Transparent" />
    <ScaleTransform x:Key="UiScaleTransform" ScaleX="1" ScaleY="1" />

</ResourceDictionary>
