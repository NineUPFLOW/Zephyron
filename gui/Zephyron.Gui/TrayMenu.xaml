<Window x:Class="Zephyron.Gui.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zephyron.Gui"
        Title="Zephyron" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        ShowActivated="True" Deactivated="OnDeactivated" KeyDown="OnKeyDown"
>

    <!--
        Меню значка в трее — карточкой в стиле окна, а не системным меню
        WinForms (владелец 24.09: «дать ему нашего стиля»). Всё на
        DynamicResource — те же ключи, что у карточек окна.

        «Сигнал»: меню как всплывающий слой окна — Raised, рамка LineStrong,
        RLg, тень; пункты высотой HControlSm, наведение WashHover. Ни частиц,
        ни свечения, ни срезов: окно слоистое (AllowsTransparency), и каждый
        лишний слой перерисовывается при каждом показе.

        Подложка — размытый снимок того, что под меню, а не прозрачность
        (владелец 24.09: «сделай в трее размытость, а не прозрачность»).
        Системное размытие Windows (подложка DWM и политика акцента) под этим
        окном давало сплошной тёмный слой — снято на экране поверх ярких
        полос, — поэтому размытие своё: снимок в миг открытия, как у стекла
        под карточками окна (Themes.RenderLayer). Подробности — TrayMenu.Blurred.
    -->
    <Window.Resources>
        <!-- Строка выхода: значок и подпись, подсветка WashHover при наведении. -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RMd}" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="18" Margin="0,0,10,0" TextAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource IconFont}" FontSize="13"
                                               Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource WashHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Сегмент режима — как выбор в «Оформлении» (Choice): выбранный — рамка
            AccentLine, AccentSoft, текст Accent; без свечения.
        -->
        <Style x:Key="ModeSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="{DynamicResource Wash}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="{StaticResource RMd}" Padding="4,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Поля под тень: у окна без рамки она иначе обрезается по краю.
        Подложку карточки (Card.Background) и оттенок (Plate.Background) ставит
        код при каждом показе — по настройкам «Меню в трее» в оформлении.
    -->
    <Border x:Name="Card" Margin="14" CornerRadius="{StaticResource RLg}" BorderThickness="{StaticResource Stroke}"
            BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Raised}"
            LayoutTransform="{DynamicResource UiScaleTransform}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" RenderingBias="Performance" />
        </Border.Effect>

        <!-- Оттенок темы над размытым: сквозь него видно, текст на нём читается. -->
        <Border x:Name="Plate" Width="300" CornerRadius="7">
            <Grid>
                <StackPanel Margin="16,14,16,10" TextElement.FontSize="12.5">
                    <DockPanel>
                        <TextBlock x:Name="Version" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Style="{StaticResource MonoTag}" />
                        <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                               Source="pack://application:,,,/Zephyron;component/Assets/logo.png"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Zephyron" FontFamily="{DynamicResource UiFont}" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                    </DockPanel>

                    <!-- Главное — идёт ли обход; ради этого меню и открывают. -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Control x:Name="Mark" Style="{StaticResource StateMark}" Width="14" Height="14" Tag="Off"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="State" Margin="10,0,0,0" FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="Проверяю…" />
                    </StackPanel>

                    <Grid Margin="24,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Туннель" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="0,0,0,2" />
                        <TextBlock x:Name="Tunnel" Grid.Column="1" Margin="12,0,0,2" FontSize="11.5"
                                   FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Muted}" Text="—" />
                        <TextBlock Grid.Row="1" Text="Десинк" Foreground="{DynamicResource Faint}" FontSize="11.5" />
                        <TextBlock x:Name="Desync" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" FontSize="11.5"
                                   FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Muted}" Text="—" />
                    </Grid>

                    <!--
                        Режим работы — тем же выбором из трёх, что на «Главной»
                        (владелец 04.10). Выбор сам перезапускает движки
                        (TrayIcon.ChooseMode): ради этого переключатель в трее
                        и просили — не открывать окно.
                    -->
                    <TextBlock Text="Режим работы" Margin="0,14,0,7" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" />

                    <Grid x:Name="Modes">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="ModeDesync" Grid.Column="0" Style="{StaticResource ModeSegment}"
                                     GroupName="TrayMode" Tag="Desync" Click="OnMode">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource LineGlyph}" FontSize="12.5" Text="&#xE9E9;"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,5,0" />
                                <TextBlock x:Name="ModeDesyncName" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeTunnel" Grid.Column="2" Style="{StaticResource ModeSegment}"
                                     GroupName="TrayMode" Tag="Tunnel" Click="OnMode">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource LineGlyph}" FontSize="12.5" Text="&#xE774;"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,5,0" />
                                <TextBlock x:Name="ModeTunnelName" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeRoute" Grid.Column="4" Style="{StaticResource ModeSegment}"
                                     GroupName="TrayMode" Tag="Route" Click="OnMode">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource LineGlyph}" FontSize="12.5" Text="&#xE8AB;"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,5,0" />
                                <TextBlock x:Name="ModeRouteName" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <TextBlock x:Name="ModeNote" FontSize="10.5" Margin="1,7,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="Toggle" Style="{StaticResource Primary}" Content="Запустить"
                                Padding="12,8" Click="OnToggle" />
                        <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Открыть окно"
                                local:ButtonGlyph.Lead="&#xE8A7;" Padding="12,8" Click="OnShowWindow" />
                    </Grid>

                    <Border Height="1" Margin="-4,12,-4,4" Background="{DynamicResource Border}" />

                    <!--
                        Два выхода, а не один с оговоркой: «убрать значок» и «выключить
                        обход» — разные желания, и ошибка в любую сторону дорогая.
                    -->
                    <Button Style="{StaticResource MenuRow}" Margin="-6,0" Click="OnQuitKeep" Tag="&#xE8BB;"
                            Content="Выйти, движки остаются работать" />
                    <Button Style="{StaticResource MenuRow}" Margin="-6,0" Click="OnQuitStop" Tag="&#xE7E8;"
                            Foreground="{DynamicResource Danger}" Content="Выйти и остановить движки" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
