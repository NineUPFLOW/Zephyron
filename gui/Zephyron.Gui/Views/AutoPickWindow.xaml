<Window x:Class="Zephyron.Gui.Views.AutoPickWindow"
        Style="{StaticResource Dialog}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zephyron.Gui"
        Title="Автоподбор маршрутов" Height="700" Width="920" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        AutomationProperties.Name="Автоподбор маршрутов"
        ResizeMode="CanResize">

    <Window.Resources>
        <!--
            Копия RouteFilter из RoutesView.xaml: там он локальный, и выносить его
            ради одного окна значило бы править страницу маршрутов. Правя один,
            правьте и другой.
        -->
        <Style x:Key="RouteFilter" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="{StaticResource RMd}" Padding="12,0"
                                MinHeight="{StaticResource HControlSm}"
                                BorderThickness="{StaticResource Stroke}" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Строка списка без выделения: выбирать в нём нечего, фокус нужен только
            галочке и «Вернуть» внутри. Свой шаблон, а не BasedOn: стиль темы
            рисует синюю подложку выбранного.
        -->
        <Style x:Key="PlainRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Свой шаблон ListBox: у стиля темы ScrollViewer без CanContentScroll,
            а при физической прокрутке VirtualizingStackPanel не виртуализирует —
            сто пятьдесят строк строились бы разом.
        -->
        <ControlTemplate x:Key="PlainList" TargetType="ListBox">
            <ScrollViewer Focusable="False" CanContentScroll="True" Padding="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
    </Window.Resources>

    <Grid LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Title}" FontSize="20" Text="Автоподбор маршрутов" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Проверяет каждый сервис и ваши маршруты и подбирает, как их открывать: напрямую, десинком, пином в hosts или через VPN. Без VPN, если сайт открывается без него. Меняет только маршруты и пины — пресет и подписка не трогаются." />

            <!-- Свой сайт: подбор для одного имени — по ссылке или домену. -->
            <Grid x:Name="SiteRow" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SiteBox" VerticalAlignment="Center" KeyDown="OnSiteKey"
                         local:Hint.Text="Свой сайт: вставьте ссылку или домен, например https://example.com/page"
                         AutomationProperties.Name="Свой сайт для автоподбора" />

                <Button Grid.Column="1" x:Name="SiteButton" Style="{StaticResource Ghost}" Content="Подобрать для сайта"
                        Click="OnPickSite" Margin="10,0,0,0"
                        ToolTip="Подобрать маршрут только для этого сайта. Если сайт входит в известный сервис, маршрут ставится всему сервису." />
            </Grid>

            <!-- Что важно знать до запуска: только то, что меняет решение человека. -->
            <Border x:Name="NotesCard" Margin="0,12,0,0" Padding="14,10" CornerRadius="{StaticResource RMd}"
                    Background="{DynamicResource Raised}" BorderThickness="{StaticResource Stroke}"
                    BorderBrush="{DynamicResource Border}" AutomationProperties.Name="Что важно знать">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="Что важно знать" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20">
                        • На время подбора (2–5 минут) движки остановлены: весь трафик идёт без обхода и без VPN.<LineBreak />
                        • Сервис проверяется по одному своему имени, а маршрут ставится всему сервису — как при выборе вручную.<LineBreak />
                        • Не трогаются: выключенные вами части, античиты (Riot, Battle.net), имена, уже прибитые в hosts.<LineBreak />
                        • Голос и служебные адреса страницей не проверить — их маршрут остаётся как есть.<LineBreak />
                        • Отказ по стране внутри приложения (ChatGPT, Gemini, Claude) проба не видит — уход с их VPN только предлагается.<LineBreak />
                        • Если сайт везде отказывает по стране, помочь может только другой сервер VPN — выберите его во вкладке VPN.<LineBreak />
                        • Подбор меряет выбранный пресет с вашими game filter и перехватом. Сменили пресет или их — запустите подбор заново.<LineBreak />
                        • Всё записанное можно вернуть: «Вернуть» у строки или «Вернуть всё».
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Полоса ответа (как в RecipeWindow): сеткой, а не стопкой, иначе перенос строки не срабатывает. -->
        <Border Grid.Row="1" x:Name="StatusCard" Margin="0,16,0,0" Padding="14,10"
                CornerRadius="{StaticResource RMd}" Visibility="Collapsed"
                Background="{DynamicResource Raised}" BorderThickness="{StaticResource Stroke}"
                BorderBrush="{DynamicResource Border}"
                AutomationProperties.Name="Состояние автоподбора"
                AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Control Grid.Column="0" x:Name="StatusMark" Style="{StaticResource StateMark}"
                         Margin="0,1,10,0" VerticalAlignment="Top" />

                <TextBlock Grid.Column="1" x:Name="Status" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Этапы и отбор; виден с начала подбора. Чипы в узком окне уходят под этапы (OnSizeChanged). -->
        <Grid Grid.Row="2" x:Name="StagesRow" Margin="0,14,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <WrapPanel x:Name="Stages" />
                <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="1" Value="0" Margin="0,8,0,0"
                             AutomationProperties.Name="Прогресс автоподбора" />
            </StackPanel>

            <WrapPanel x:Name="Chips" Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="FilterAll" Style="{StaticResource RouteFilter}" GroupName="AutoFilter"
                             IsChecked="True" Tag="all" Click="OnFilter" Content="Все" />
                <RadioButton x:Name="FilterChanged" Style="{StaticResource RouteFilter}" GroupName="AutoFilter"
                             Tag="changed" Click="OnFilter" Margin="3,0,0,0" Content="Будет изменено" />
                <RadioButton x:Name="FilterFailed" Style="{StaticResource RouteFilter}" GroupName="AutoFilter"
                             Tag="failed" Click="OnFilter" Margin="3,0,0,0" Content="Не помогло" />
                <RadioButton x:Name="FilterSkipped" Style="{StaticResource RouteFilter}" GroupName="AutoFilter"
                             Tag="skipped" Click="OnFilter" Margin="3,0,0,0" Content="Пропущено" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <!-- До старта: последний запуск. -->
            <Border x:Name="LastRunCard" Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="LastRunText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Запусков ещё не было." />
                    <StackPanel x:Name="LastRunButtons" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource Ghost}" Content="Показать результаты" Padding="10,5"
                                Click="OnShowLast" Margin="0,0,8,0" />
                        <Button x:Name="LastUndoButton" Style="{StaticResource Ghost}" Content="Вернуть всё" Padding="10,5"
                                Click="OnUndoLast" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <ListBox x:Name="List" Template="{StaticResource PlainList}" Background="Transparent"
                         BorderThickness="0" Padding="14,12" IsTabStop="False"
                         ItemContainerStyle="{StaticResource PlainRow}"
                         KeyboardNavigation.TabNavigation="Continue"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Имена и маршруты">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Raised}" CornerRadius="{StaticResource RMd}"
                                    BorderBrush="{Binding Edge}" BorderThickness="{StaticResource Stroke}"
                                    Padding="12,9" Margin="0,0,0,7" Opacity="{Binding RowOpacity}"
                                    AutomationProperties.Name="{Binding RowName}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding Apply, Mode=TwoWay}"
                                              Visibility="{Binding ApplyVisibility}" Padding="4"
                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                              AutomationProperties.Name="{Binding AutoName}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="210" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                        <TextBlock Text="{Binding Host}" Style="{StaticResource Mono}" FontSize="11"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Host}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding CurrentText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="96" TextWrapping="Wrap"
                                               ToolTip="{Binding CurrentName}"
                                               AutomationProperties.Name="{Binding CurrentName}" />

                                    <!-- Вердикт переносится и ограничен по ширине — как в RecipeWindow: длинный не раздвигает строку. -->
                                    <TextBlock Grid.Column="3" Text="{Binding Verdict}" Style="{StaticResource Mono}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="104" MaxWidth="200"
                                               TextWrapping="Wrap" TextAlignment="Right"
                                               Foreground="{Binding VerdictColour}" ToolTip="{Binding VerdictTip}" />

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="150" MaxWidth="230">
                                        <TextBlock Text="{Binding Result}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{Binding ResultColour}" ToolTip="{Binding ResultTip}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Control Style="{StaticResource StateMark}" Tag="{Binding MarkTag}"
                                                     Visibility="{Binding MarkVisibility}" Margin="0,0,8,0"
                                                     AutomationProperties.Name="{Binding MarkName}" />
                                            <Button Style="{StaticResource Ghost}" Content="Вернуть" Padding="10,5"
                                                    Tag="{Binding Host}" Click="OnRestore"
                                                    Visibility="{Binding RestoreVisibility}"
                                                    AutomationProperties.Name="{Binding RestoreName}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl x:Name="EmptyFilter" Style="{StaticResource EmptyState}" Visibility="Collapsed"
                            local:PageHead.Title="Здесь пусто"
                            local:PageHead.Subtitle="Под этот отбор имён нет.">
                <Button Style="{StaticResource Ghost}" Content="Показать все" Click="OnShowAll" />
            </ContentControl>

            <ContentControl x:Name="LoadError" Style="{StaticResource ErrorState}" Visibility="Collapsed"
                            VerticalAlignment="Top"
                            local:PageHead.Title="Не удалось прочитать список имён"
                            local:PageHead.Subtitle="Нажмите «Перечитать» на странице маршрутов и откройте окно снова." />
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Hint" Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,16,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="Начать"
                        Click="OnStart" Margin="0,0,8,0" IsDefault="True" />

                <Button x:Name="StopButton" Style="{StaticResource Ghost}" Content="Стоп" Click="OnStop"
                        Margin="0,0,8,0" Visibility="Collapsed"
                        ToolTip="Остановить подбор. Результаты, что уже есть, сохранятся." />

                <Button x:Name="WriteButton" Style="{StaticResource Primary}" Content="Записать и применить"
                        Click="OnWrite" Margin="0,0,8,0" Visibility="Collapsed"
                        ToolTip="Записать отмеченное и перезапустить движки с новыми маршрутами, затем проверить записанное" />

                <Button x:Name="EnginesButton" Style="{StaticResource Ghost}" Content="Запустить движки"
                        Click="OnEngines" Margin="0,0,8,0" Visibility="Collapsed" />

                <Button x:Name="CheckButton" Style="{StaticResource Ghost}" Content="Проверка после"
                        Click="OnCheck" Margin="0,0,8,0" Visibility="Collapsed" />

                <Button x:Name="UndoButton" Style="{StaticResource Ghost}" Content="Вернуть всё"
                        Click="OnUndo" Margin="0,0,8,0" Visibility="Collapsed" />

                <Button x:Name="CloseButton" Style="{StaticResource Ghost}" Content="Закрыть"
                        Click="OnClose" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
