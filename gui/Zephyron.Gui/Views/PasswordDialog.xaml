<Window x:Class="Zephyron.Gui.Views.PasswordDialog"
        Style="{StaticResource Dialog}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyron" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">

    <!-- Пароль копии настроек: на сохранении вводится дважды, на восстановлении — раз. -->
    <StackPanel LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,22">
        <TextBlock x:Name="Head" Style="{StaticResource Title}" FontSize="20" TextWrapping="Wrap" />
        <TextBlock x:Name="Hint" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,16,0,6" />
        <PasswordBox x:Name="First" />

        <StackPanel x:Name="ConfirmRow">
            <TextBlock Text="Пароль ещё раз" FontWeight="SemiBold" Margin="0,12,0,6" />
            <PasswordBox x:Name="Second" />
        </StackPanel>

        <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource Primary}" Content="Продолжить" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
