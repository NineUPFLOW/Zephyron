<Window x:Class="Zephyron.Gui.Views.ThemeEditorWindow"
        Style="{StaticResource Dialog}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zephyron.Gui.Views"
        Title="Своя тема" Height="760" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Backdrop}">

    <!--
        Редактор темы (владелец, 24.09: «добавь возможность прям в программе
        создавать свои темы и сохранять в файл»). Тема из редактора — такая
        же папка с theme.json, как тема художника, и проходит ту же проверку.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Heading" Text="Своя тема" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Начинается с цветов выбранной сейчас темы, и каждая правка сразу видна на окне. Смысл зелёного, красного и жёлтого общий для всех тем — оттенки ваши. Нечитаемый цвет отмечен в своей строке, а «Поправить нечитаемое» подстроит его светлоту, не трогая выбранное." />

            <!--
                Кусок «Главной» прямо в редакторе: окно под ним закрыто диалогом, а смотреть
                надо, пока правишь. Цвета — те же ресурсы, что правит Themes.Preview, так что
                полоска перекрашивается сама. Кнопки — для вида, не нажимаются.
            -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,8" IsHitTestVisible="False"
                    AutomationProperties.Name="Предпросмотр «Главной»">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource Success}" />
                        <TextBlock Text="Работает" Foreground="{DynamicResource Success}" FontWeight="SemiBold"
                                   FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <local:FlowLanes x:Name="PreviewLanes" Grid.Column="1" Height="64" Margin="16,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Ghost}" Content="Остановить" Focusable="False" />
                        <Button Style="{StaticResource Primary}" Content="Запустить" Focusable="False" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="NameField" AutomationProperties.Name="Название темы" />
                    </Grid>
                </Border>

                <TextBlock Text="Цвета" FontWeight="SemiBold" FontSize="15" Margin="4,18,0,10" />

                <ItemsControl x:Name="ColorRows" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Choice}" Tag="{Binding Slot}" Click="OnColor" AutomationProperties.Name="{Binding Label}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="26" CornerRadius="{StaticResource RMd}" Margin="0,0,14,0"
                                            Background="{Binding Swatch}" BorderBrush="{DynamicResource LineStrong}"
                                            BorderThickness="1" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Danger}" Visibility="{Binding WarningShown}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Hex}" Style="{StaticResource Mono}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Фон" FontWeight="SemiBold" FontSize="15" Margin="4,18,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Картинка или видео" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="PNG, JPG или живой фон — видео MP4: оно крутится по кругу без звука." />
                                <TextBlock x:Name="ImageName" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource Ghost}" Content="Выбрать…" Click="OnPickImage" Margin="0,0,8,0" />
                                <Button x:Name="ClearImage" Style="{StaticResource Ghost}" Content="Убрать" Click="OnClearImage" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="ImageSettings" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Укладка" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="FitChoice" AutomationProperties.Name="Укладка картинки" SelectionChanged="OnChanged">
                                    <ComboBoxItem Content="на всё окно" />
                                    <ComboBoxItem Content="целиком" />
                                    <ComboBoxItem Content="плиткой" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Затемнение" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="DimChoice" AutomationProperties.Name="Затемнение" SelectionChanged="OnChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Размытие под карточками" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="BlurChoice" AutomationProperties.Name="Размытие под карточками" SelectionChanged="OnChanged">
                                    <ComboBoxItem Content="нет" />
                                    <ComboBoxItem Content="слабое" />
                                    <ComboBoxItem Content="среднее" />
                                    <ComboBoxItem Content="сильное" />
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Плотность карточек" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Чем прозрачнее, тем больше видно картинку сквозь стекло." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="AlphaChoice" AutomationProperties.Name="Плотность карточек" VerticalAlignment="Center" SelectionChanged="OnChanged" />
                            </Grid>

                            <!--
                                Картинка на «Главной» (владелец 15.10: «сделай миниатюру главной
                                и дай возможность разместить там фон, всё остальное заливается
                                градиентом»). Миниатюра рисуется тем же расчётом, что «Главная»
                                (SideArtLayout, HomePlacement): тянуть — двигать, колесо или
                                ползунок — размер.
                            -->
                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,14" />

                            <TextBlock Text="Картинка или видео на «Главной»" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Тяните картинку по миниатюре «Главной», колесом или ползунком — размер. Что картинка не закрывает, зальётся градиентом из фона окна в её цвет." />

                            <Border x:Name="HomeMini" Width="480" Height="307" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" CornerRadius="{StaticResource RLg}" ClipToBounds="True"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    Background="{DynamicResource Backdrop}" Cursor="SizeAll"
                                    MouseLeftButtonDown="OnMiniDown" MouseMove="OnMiniMove"
                                    MouseLeftButtonUp="OnMiniUp" MouseWheel="OnMiniWheel">
                                <Grid>
                                    <Rectangle x:Name="MiniGround" />
                                    <Rectangle x:Name="MiniArt" />
                                    <Rectangle x:Name="MiniShade" />
                                    <Canvas x:Name="MiniCards" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Размер" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="SizeSlider" AutomationProperties.Name="Размер картинки" Minimum="0.2" Maximum="3"
                                        VerticalAlignment="Center" ValueChanged="OnSize" />
                                <TextBlock Grid.Column="2" x:Name="SizeText" Style="{StaticResource Mono}"
                                           Width="52" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Карточки" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="SideChoice" Width="252" AutomationProperties.Name="Где карточки «Главной»"
                                          SelectionChanged="OnSide">
                                    <ComboBoxItem Content="Слева, картинка справа" />
                                    <ComboBoxItem Content="По центру" />
                                    <ComboBoxItem Content="Справа, картинка слева" />
                                </ComboBox>
                            </Grid>

                            <Button Style="{StaticResource Ghost}" Content="Как было: фоном окна, как на других вкладках"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnHomeReset" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Шрифт" FontWeight="SemiBold" FontSize="15" Margin="4,18,0,10" />

                <!-- Один на всю тему; каждый в списке написан собой. -->
                <Border Style="{StaticResource Card}">
                    <ComboBox x:Name="FontChoice" AutomationProperties.Name="Шрифт темы" SelectionChanged="OnChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="Problems" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}"
                   Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="FixButton" Style="{StaticResource Ghost}" Content="Поправить нечитаемое" Click="OnFix"
                    Margin="0,0,8,0" Visibility="Collapsed" />
            <Button Style="{StaticResource Ghost}" Content="Отмена" Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
            <Button Style="{StaticResource Primary}" Content="Сохранить и применить" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
