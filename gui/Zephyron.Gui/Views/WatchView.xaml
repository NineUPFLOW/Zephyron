<UserControl x:Class="Zephyron.Gui.Views.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Zephyron.Gui"
             xmlns:gui="clr-namespace:Zephyron.Gui"
             xmlns:views="clr-namespace:Zephyron.Gui.Views"
             Background="{DynamicResource Chrome}">
    <UserControl.Resources>
        <!-- Строка «кто шумит»: имя, полоска длины по числу, число; щелчок — отбор. -->
        <DataTemplate x:Key="WatchTopLine">
            <Grid Margin="0,2" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnTopClick"
                  ToolTip="{Binding Hint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="{DynamicResource Raised}" VerticalAlignment="Center"
                        Width="{Binding Track}">
                    <Border Height="5" CornerRadius="2.5" Background="{DynamicResource Accent2}"
                            HorizontalAlignment="Left" Width="{Binding Bar}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- Значок счётчика — приглушённым: акцент в «Сигнале» только у выбранного и главного. -->
        <Style x:Key="StatGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,12,0" />
        </Style>

        <!-- Число счётчика: на узком окне плитка в полторы сотни точек. -->
        <Style x:Key="StatNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <!--
        По макету владельца 10.10: поиск, отборы «Программа», «Куда», «Правило»,
        счётчики, таблица с кружком «точно / по правилам» и меню у строки,
        справа кольцо долей и «кто шумит». На узком окне правая колонка уходит
        под таблицу (OnBodySize): у владельца ~830 точек содержимого.
    -->
    <Grid Margin="{StaticResource PagePad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ContentControl Style="{StaticResource PageHead}"
                            local:PageHead.Title="Наблюдение"
                            local:PageHead.Subtitle="Соединения по мере появления и правило, которое сработало бы для каждого. Раздел только показывает и ничего не меняет.">
                <ContentControl Style="{StaticResource Info}"
                                Content="Источник: события ядра Windows (ETW) о каждом новом соединении и открывшей его программе.&#x0a;&#x0a;«Куда» показывает, что решили бы правила для этого имени или адреса. Точно известно лишь про подставные адреса движки, саму движок и домашнюю сеть: это залитый кружок.&#x0a;&#x0a;Всё, в том числе прямое, пишется в runtime\watch.log и попадает в отчёт." />
            </ContentControl>

            <!--
                WrapPanel: на узком окне лишнее уходит на вторую строку, а не за край.
                Отступ кнопок 14, а не 18: со значками ряд на окне владельца
                (1536 точек) выходил на две точки шире, и «Открыть журнал»
                уходила второй строкой — та отнимала у таблицы 46 точек высоты.
            -->
            <WrapPanel Margin="0,16,0,-8">
                <WrapPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                        <Setter Property="Padding" Value="12,6" />
                    </Style>
                </WrapPanel.Resources>
                <Button x:Name="PowerButton" Style="{StaticResource Primary}" Padding="16,6"
                        Content="Запустить" Click="OnPower" MinWidth="110" Margin="0,0,8,8"
                        gui:ButtonGlyph.Lead="&#xE768;" />
                <Button x:Name="ProcessButton" MinWidth="150"
                        Content="Программа: все" Click="OnProcessMenu" Margin="0,0,8,8" gui:ButtonGlyph.Menu="True"
                        ToolTip="Только соединения одной программы" />
                <Button x:Name="RouteButton" MinWidth="110"
                        Content="Куда: все" Click="OnRouteMenu" Margin="0,0,8,8" gui:ButtonGlyph.Menu="True" />
                <Button x:Name="RuleButton" MinWidth="120"
                        Content="Правило: все" Click="OnRuleMenu" Margin="0,0,8,8" gui:ButtonGlyph.Menu="True" />
                <Button x:Name="ClearButton"
                        Content="Стереть список" Click="OnClear" Margin="0,0,8,8" gui:ButtonGlyph.Lead="&#xE74D;" />
                <Button x:Name="CopyButton"
                        Content="Копировать" Click="OnCopyMenu" Margin="0,0,8,8"
                        gui:ButtonGlyph.Lead="&#xE8C8;" gui:ButtonGlyph.Menu="True"
                        ToolTip="Сайты, домены или адреса из текущего отбора, по одному в строке, без повторов. Локальные и служебные соединения не копируются." />
                <Button x:Name="SummaryButton" Visibility="Collapsed"
                        Content="Итоги" Click="OnSummary" Margin="0,0,8,8" gui:ButtonGlyph.Lead="&#xEB05;"
                        ToolTip="Кольцо долей, самые шумные и сайты скрываются на узком окне, чтобы таблице хватило места" />
                <Button x:Name="JournalButton"
                        Content="Журнал" Click="OnJournal" Margin="0,0,8,8" gui:ButtonGlyph.Lead="&#xE8FD;"
                        ToolTip="runtime\watch.log: все соединения всех сеансов, включая прямые" />
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="Status" Style="{StaticResource Caption}"
                       Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Ответ пунктов «Почему так» и «Проверить это имя» из меню строки. -->
            <Border x:Name="Details" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailsTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailsText" Style="{StaticResource Mono}" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Свернуть"
                            VerticalAlignment="Top" Margin="12,0,0,0" Click="OnDetailsClose" />
                </Grid>
            </Border>
        </StackPanel>

        <!--
            Без прокрутки страницы: 10.10 владелец — «теперь везде нужно мотать
            страницу». На узком окне сводка скрыта и открывается кнопкой
            «Сводка» (OnBodySize), иначе таблице оставалось три строки.
        -->
        <Grid Grid.Row="2" x:Name="Body" Margin="0,16,0,0" SizeChanged="OnBodySize">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="330" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MainRow" Height="*" />
                <RowDefinition x:Name="SideRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="TableRow" Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Лупа поверх поля. Отступ поля слева 34 — текст
                    с подсказкой встают сразу за лупой.
                -->
                <Grid Grid.Row="0">
                    <TextBox x:Name="Search" TextChanged="OnSearch" Padding="34,7,11,7"
                             gui:Hint.Text="Искать по имени, адресу, программе, правилу" />
                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE721;" FontSize="14"
                               HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- Счётчики: имён и адресов рядом — разрыв выдаёт браузер со своим DoH. -->
                <UniformGrid Grid.Row="1" Rows="1" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE8AB;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TotalText" Text="0" Style="{StaticResource StatNumber}" />
                                <TextBlock Text="всего соединений" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE816;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="MatchedText" Text="0" Style="{StaticResource StatNumber}" />
                                <TextBlock Text="по правилам" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE8EC;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="NamesText" Text="0" Style="{StaticResource StatNumber}" />
                                <TextBlock Text="имён известно" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE968;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="AddressesText" Text="0" Style="{StaticResource StatNumber}" />
                                <TextBlock Text="адресов" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE916;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ClockText" Text="—" Style="{StaticResource StatNumber}" />
                                <TextBlock x:Name="ClockCaption" Text="не идёт" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!--
                    Заголовок таблицы отдельной строкой, а не первым элементом
                    списка: список переписывается целиком, и заголовок уезжал бы.
                -->
                <Grid Grid.Row="2" Margin="16,14,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="98" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Когда" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="Куда" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="Приложение" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="3" Text="Куда" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="4" Text="Правило" Style="{StaticResource Caption}" />
                </Grid>

                <!--
                    Таблица виртуальная: рисуются только видимые строки. До 10.10
                    все 400 строк собирались целиком, и после двух часов наблюдения
                    заход в раздел и смена отбора занимали поток окна на 2–3,5 с
                    (сторож подвисаний у владельца: 1,1–2,0 с, «окно считало»).
                    Прокрутка внутри шаблона списка, а не снаружи: иначе
                    VirtualizingStackPanel получает бесконечную высоту и строит всё.
                -->
                <Border x:Name="TableCard" Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                    <!-- Пусто: показывается, пока в таблице нет строк (отбор или наблюдение выключено). -->
                    <ContentControl local:PageHead.Title="Соединений пока нет"
                                    local:PageHead.Subtitle="Нажмите «Начать» — они появятся по мере открытия. Если наблюдение идёт, смягчите отбор.">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource EmptyState}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=Rows}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                        <ItemsControl x:Name="Rows"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8"
                                                  CanContentScroll="True" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="98" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />

                                        <!-- Залитый кружок — известно точно, полый — ответ правил. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="{Binding CertaintyHint}">
                                            <Rectangle RadiusX="1.5" RadiusY="1.5" Width="9" Height="9" Stroke="{Binding Colour}" StrokeThickness="1.6"
                                                     Fill="{Binding Dot}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Mode}" Foreground="{Binding Colour}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Process}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                                   Cursor="Hand" ToolTip="Только это приложение"
                                                   MouseLeftButtonUp="OnProcessClick" />

                                        <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AddressLine}" Visibility="{Binding AddressShown}"
                                                       Style="{StaticResource Mono}" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="4" Text="{Binding RuleName}" ToolTip="{Binding Rule}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Button Grid.Column="5" Style="{StaticResource Ghost}" Content="⋮"
                                                Padding="0,2" MinWidth="28" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Click="OnRowMenu"
                                                ToolTip="Действия с этим соединением"
                                                AutomationProperties.Name="Действия с соединением" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Margin="4,8,0,0" TextWrapping="Wrap"
                           Text="● — известно точно: подставной адрес движки, сама движок, домашняя сеть · ○ — так решили бы правила, движок не спрашивали" />
            </Grid>

            <!--
                Правая колонка; на узком окне — строкой под таблицей (OnBodySize).
                Без прокрутки: «Сайты» забирают остаток высоты и показывают
                столько строк, сколько влезло целиком (FitStack). В сборке 11
                колонка на развёрнутом окне владельца не влезала на ~30 точек
                и прокручивалась своей полосой.
            -->
            <Border x:Name="SideHost" Grid.Column="1" Grid.Row="0" Margin="16,0,0,0">
            <Grid x:Name="Side">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SideR0" Height="Auto" />
                    <RowDefinition x:Name="SideR1" Height="Auto" />
                    <RowDefinition x:Name="SideR2" Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SideC0" Width="*" />
                    <ColumnDefinition x:Name="SideC1" Width="0" />
                    <ColumnDefinition x:Name="SideC2" Width="0" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RingCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <!--
                        Легенда справа от кольца, и на широком окне тоже: под
                        кольцом она отнимала у «Сайтов» ~120 точек высоты —
                        на окне владельца (сборка 11) им оставалась строка-две.
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.ColumnSpan="2">
                            <TextBlock Text="Куда идёт трафик" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Доля соединений сеанса по каждому пути. При «Куда: наружу» считаются только туннель, десинк и «напрямую», при «Куда: всё» добавляются локальные (домашняя сеть, мультикаст) и служебные (соединения самого sing-box: к VPN-серверу и DNS).&#x0a;&#x0a;Щёлкните строку, и в таблице останется только она." />
                        </StackPanel>
                        <Grid x:Name="RingBox" Grid.Row="1" Width="116" Height="116" VerticalAlignment="Center">
                            <views:WatchRing x:Name="Ring" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="RingTotal" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="RingCaption" Text="всего соединений" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="RingLegend" Grid.Row="1" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" Cursor="Hand" Background="Transparent"
                                          MouseLeftButtonUp="OnLegendClick" ToolTip="Оставить только это">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle RadiusX="1" RadiusY="1" Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Word}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Share}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border x:Name="ProgramsCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Самые шумные" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Программы с самым большим числом соединений за сеанс. При «Куда: наружу» локальные и служебные соединения не считаются.&#x0a;&#x0a;Щёлкните строку, чтобы в таблице осталась только эта программа." />
                        </StackPanel>
                        <ItemsControl x:Name="TopPrograms" Grid.Row="1" ItemTemplate="{StaticResource WatchTopLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <gui:FitStack />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border x:Name="SitesCard" Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Сайты" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Сайты по числу соединений. Имена сведены к сайту: www.youtube.com и m.youtube.com считаются вместе. Строк столько, сколько помещается по высоте.&#x0a;&#x0a;Щёлкните строку, чтобы найти сайт в таблице." />
                        </StackPanel>
                        <ItemsControl x:Name="TopSites" Grid.Row="1" ItemTemplate="{StaticResource WatchTopLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <gui:FitStack />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
