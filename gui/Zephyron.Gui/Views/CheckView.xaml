<UserControl x:Class="Zephyron.Gui.Views.CheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Zephyron.Gui"
             xmlns:gui="clr-namespace:Zephyron.Gui"
             Background="{DynamicResource Chrome}">

    <ScrollViewer Style="{StaticResource PageScroll}" Padding="{StaticResource PagePad}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <ContentControl Style="{StaticResource PageHead}"
                                local:PageHead.Title="Проверка блокировок"
                                local:PageHead.Subtitle="Что закрыто в этой сети и чем это лечится.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!--
                            Что проверять. Полная проверка берёт по имени
                            с каждой части всего справочника и идёт минуты;
                            точечная — один сервис, но вчетверо глубже.
                            Когда чинят Discord, ответ нужен про Discord,
                            а не про сорок имён, из которых он одно.
                        -->
                        <ComboBox x:Name="Scope" AutomationProperties.Name="Что проверять" Width="164" Margin="0,0,8,0"
                                  SelectionChanged="OnScope" />

                        <Button x:Name="StopButton" Style="{StaticResource Ghost}"
                                Content="Прервать" Click="OnStop" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="RunButton" Style="{StaticResource Primary}"
                                Content="Проверить" Click="OnRun" />
                    </StackPanel>
                </ContentControl>

                <!--
                    Обстановка замера. Без неё отчёт нечем толковать: при
                    работающем обходе видно сеть уже вылеченной, а не такой,
                    какая она есть.
                -->
                <Border x:Name="SetupCard" Style="{StaticResource Card}" Margin="0,20,0,0"
                        Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SetupTitle" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                        <TextBlock x:Name="SetupBody" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,18,0,0" TextWrapping="Wrap"
                           Text="Проверка идёт минуты: по каждому имени соединение, и каждое ждёт ответа." />

                <!--
                    Расшифровка подписей в карточках. Таблицы в две колонки нет,
                    общей шапки у неё быть не может: каждое значение подписано
                    в самой карточке, а здесь сказано, что подпись значит.
                -->
                <TextBlock x:Name="Header" Style="{StaticResource Caption}" Margin="4,18,0,8" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="TCP — соединение · TLS — рукопожатие · Порт 80 — обычный HTTP · Данные — пришло ли тело страницы" />

                <!--
                    Карточки в две колонки (MasonryPanel, как «Маршруты» и «Десинк»):
                    следующая встаёт в более короткий столбец, на узком окне
                    столбец один. Без виртуализации — строк в проверке до сотни,
                    и это допустимо.
                -->
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <gui:MasonryPanel ColumnWidth="380" Gap="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <StackPanel>
                                    <!--
                                        Сетка, а не стопка: горизонтальная стопка меряет
                                        содержимое бесконечной шириной, и перенос в ней
                                        не срабатывает. Имя с пометкой — одна строка,
                                        вердикт под ним целиком, без обрезки.
                                    -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Имя — ссылка на его маршрут (владелец, 04.10):
                                            щелчок открывает «Маршруты» на той части, чьё
                                            правило решает это имя (RoutesView.Reveal).
                                            Правым щелчком — копировать (TextCopy).

                                            Стиль — от общего стиля TextBlock: свой стиль без
                                            BasedOn сбрасывал цвет и шрифт темы, и имена
                                            выходили чёрными на тёмном фоне (снимок владельца
                                            05.10). Подчёркивания нет и при наведении — его
                                            слово; ссылку выдаёт цвет и курсор.
                                        -->
                                        <TextBlock Grid.Column="0" Text="{Binding Host}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand" MouseLeftButtonUp="OnHostClick"
                                                   ToolTip="Открыть маршрут этого имени">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="1" Background="{DynamicResource Raised}"
                                                CornerRadius="{StaticResource RSm}" Padding="5,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding MarkShown}">
                                            <TextBlock Text="{Binding Mark}" FontSize="10"
                                                       Foreground="{DynamicResource Muted}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Verdict}" Foreground="{Binding Color}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <!-- Замеры с подписями; на узкой карточке переносятся целыми. -->
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Mono}" Margin="0,0,14,0"><Run Text="TCP " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Tcp, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Style="{StaticResource Mono}" Margin="0,0,14,0"><Run Text="TLS " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Tls, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Style="{StaticResource Mono}" Margin="0,0,14,0"><Run Text="Порт 80 " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Http, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Style="{StaticResource Mono}"><Run Text="Данные " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Data, Mode=OneWay}" /></TextBlock>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding WhyShown}" />

                                    <!--
                                        Отдельной строкой и цветом предупреждения:
                                        она не объясняет замер, а отменяет совет
                                        из вердикта. Слитая с «почему», она читалась бы
                                        как ещё одна подробность и пропускалась бы
                                        ровно теми, кому нужна.
                                    -->
                                    <TextBlock Text="{Binding Bypass}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource Warn}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding BypassShown}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Итог по видам и советы. Появляются, когда есть что сказать. -->
                <ItemsControl x:Name="Sections" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{Binding Color}" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Итог проверки — внизу, после всех карточек и советов:
                    сколько проверено, по каким вердиктам и куда лёг отчёт.
                    Пока проверка идёт, на виду строка хода (Status).
                -->
                <Border x:Name="Totals" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TotalsHead" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ItemsControl x:Name="TotalsItems" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,18,2" Foreground="{Binding Color}"><Run Text="{Binding Title, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Body, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TotalsNote" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
