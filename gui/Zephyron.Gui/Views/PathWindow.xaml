<Window x:Class="Zephyron.Gui.Views.PathWindow"
        Style="{StaticResource Dialog}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Маршрут сайта" Width="560" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">

    <!--
        Выбор пути отдельным окном (владелец 19.10, идеи №6): выключено,
        напрямую, десинк с рецептом, через VPN с пулом — в одном месте
        вместо меню пути. Окно постоянного размера, как «выбор цели»:
        в нём одна колонка вариантов.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Style="{StaticResource PageScroll}" Padding="28,24,28,0">
            <StackPanel>
                <TextBlock x:Name="Head" Style="{StaticResource Title}" FontSize="20" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,10" TextWrapping="Wrap"
                           Text="Куда ведёт этот маршрут. Вступит в силу после следующего запуска." />

                <StackPanel x:Name="Options" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,18,28,24">
            <Button Style="{StaticResource Ghost}" Content="Не менять" IsCancel="True"
                    Margin="0,0,8,0" Click="OnCancel" />
            <Button Style="{StaticResource Primary}" Content="Принять" IsDefault="True" Click="OnDone" />
        </StackPanel>
    </Grid>
</Window>
