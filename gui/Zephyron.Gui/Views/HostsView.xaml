<UserControl x:Class="Zephyron.Gui.Views.HostsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:Zephyron.Gui"
             Background="{DynamicResource Chrome}">

    <!--
        По макету владельца 19.10: счётчики, поиск с отбором, одна таблица
        на весь файл с выбором и выключателем у строки, справа добавление,
        источники и что делает запись. Не взяты кнопка «Сохранить» (правка
        пишется сразу, с копией файла рядом), импорт и экспорт (их делают
        вкладка «Список» и «Открыть файл») и свободный комментарий к записи —
        вместо него колонка «Вид»: от неё зависит, тронет ли имя десинк.
    -->
    <UserControl.Resources>
        <Style x:Key="StatGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,12,0" />
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            Знак живости записи — StateMark (форма + цвет): диск — ответил, треугольник —
            молчит, ромб — не проверен, кольцо — выключен или заглушка. Слово — в подсказке (StateHint).
            Флажок выбора строки — неявный CheckBox из Controls.xaml: прежний «Tick» умел то же самое.
        -->
        <Style x:Key="HealthDot" TargetType="Control" BasedOn="{StaticResource StateMark}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Alive">
                    <Setter Property="Tag" Value="Running" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Dead">
                    <Setter Property="Tag" Value="Failed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Untested">
                    <Setter Property="Tag" Value="Degraded" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Style="{StaticResource PageHead}"
                        gui:PageHead.Title="Файл hosts"
                        gui:PageHead.Subtitle="Имена, прибитые к адресам. Windows разрешает их сама, раньше всякого DNS — и нашего тоже.">

            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="SideButton" Style="{StaticResource Ghost}" Content="Добавить запись"
                        Click="OnSide" Margin="0,0,8,0" Visibility="Collapsed"
                        gui:ButtonGlyph.Lead="&#xE710;" />
                <Button x:Name="OpenButton" Style="{StaticResource Ghost}" Content="Открыть файл"
                        Click="OnOpen" Margin="0,0,8,0" gui:ButtonGlyph.Lead="&#xE8E5;"
                        ToolTip="Блокнотом, целиком — вместе с комментариями, которых таблица не показывает" />
                <Button x:Name="CheckButton" Style="{StaticResource Primary}" Content="Проверить адреса"
                        Click="OnCheck" gui:ButtonGlyph.Lead="&#xE72C;"
                        ToolTip="Стучится по 443 в каждый адрес действующих записей, по восемь разом" />
            </WrapPanel>
        </ContentControl>

        <StackPanel Grid.Row="1">
            <!-- Стёртый защитником файл: сказать до того, как человек решит, что ничего не прибивал. -->
            <Border x:Name="ReplacedCard" Style="{StaticResource Card}" Margin="0,16,0,0"
                    Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Control Style="{StaticResource StateMark}" Tag="Failed" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ReplacedTitle" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Изменённый hosts он считает признаком заражения и вернул файл к своему умолчанию — вместе со всеми пинами. Пин на этой машине не живёт, пока файл не внесён в доверенные в настройках защитника." />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Повторы: имя прибито не в первый раз. Windows берёт первую
                запись, так что повтор ничего не делает, но выглядит рабочим.
                Замер 23.09: 68 повторов, из них 29 — тот же адрес в блоке
                ZapretGUI, 39 — ChatGPT на старом адресе под нашим пином.
            -->
            <Border x:Name="RepeatsCard" Style="{StaticResource Card}" Margin="0,16,0,0"
                    BorderBrush="{DynamicResource WarnLine}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RepeatsTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="RepeatsText" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Показать"
                            Click="OnShowRepeats" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="RepeatsButton" Style="{StaticResource Ghost}"
                            Click="OnRemoveRepeats" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Строка состояния: ошибка — панелью ErrorState (StatusLook); Text и Visibility пишет код. -->
            <Border x:Name="StatusBox" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Control x:Name="StatusMark" Style="{StaticResource StateMark}" Visibility="Collapsed"
                             VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock x:Name="Status" Grid.Column="1" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="Body" Margin="0,16,0,0" SizeChanged="OnBodySize">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="SideRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Rows="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE8A5;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TotalText" Text="0" Style="{StaticResource StatNumber}" />
                                <TextBlock Text="записей всего" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE718;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="OursText" Text="0" Style="{StaticResource StatNumber}" />
                                <TextBlock Text="поставлено нами" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatGlyph}" Text="&#xE711;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="OffText" Text="0" Style="{StaticResource StatNumber}" />
                                <TextBlock Text="отключено" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DeadGlyph" Style="{StaticResource StatGlyph}" Text="&#xE783;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DeadText" Text="—" Style="{StaticResource StatNumber}" />
                                <TextBlock x:Name="DeadCaption" Text="молчат: не проверено" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Лупа поверх поля: отступ поля слева 34 оставляет ей место. -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="Search" TextChanged="OnSearch" Padding="34,7,11,7"
                             gui:Hint.Text="Поиск по имени, адресу, источнику или подписи" />
                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE721;" FontSize="14"
                               HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />

                    <Button Grid.Column="1" x:Name="ShowButton" Style="{StaticResource Ghost}" MinWidth="150"
                            Content="Все записи" Click="OnShowMenu" Margin="8,0,0,0" gui:ButtonGlyph.Menu="True" />
                </Grid>

                <!--
                    Таблица виртуальная: у владельца в файле ~690 записей. Прокрутка
                    внутри шаблона списка, а не снаружи: иначе VirtualizingStackPanel
                    получает бесконечную высоту и строит всё. Заголовок — отдельной
                    строкой над списком, чтобы не уезжал.
                -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="16,10,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="AllBox" Click="OnSelectAll" VerticalAlignment="Center"
                                      AutomationProperties.Name="Выбрать всё, что показано сейчас"
                                      ToolTip="Выбрать всё, что показано сейчас" />
                            <TextBlock Grid.Column="2" Text="Имя" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="Адрес" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="4" Text="Источник" Style="{StaticResource Caption}" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <TextBlock Text="Вид" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Посредник — чужой узел, через который ходит имя (XBOX DNS, Comss, GeoHide): щит десинка пропускает его без обработки.&#x0a;&#x0a;Адрес сервиса — сам сервис, пин только выбирает незакрытый адрес: щит такое имя не берёт, и его обрабатывает рецепт.&#x0a;&#x0a;Заглушка — петля или нули, имя закрыто намеренно." />
                            </StackPanel>
                            <TextBlock Grid.Column="6" Text="Вкл." Style="{StaticResource Caption}" />
                        </Grid>

                        <ItemsControl x:Name="Rows" Grid.Row="1"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,8"
                                                  CanContentScroll="True" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}">
                                        <Grid Margin="0,4" MinHeight="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Выбрать запись" Click="OnRowTick" />

                                            <Control Grid.Column="1" Style="{StaticResource HealthDot}" ToolTip="{Binding StateHint}" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Text="{Binding Sub}" FontSize="11.5"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSub}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding Address}" Style="{StaticResource Mono}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <TextBlock Grid.Column="4" Text="{Binding Source}" ToolTip="{Binding SourceHint}"
                                                       Foreground="{DynamicResource Muted}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <TextBlock Grid.Column="5" Text="{Binding Kind}" ToolTip="{Binding KindHint}"
                                                       Foreground="{DynamicResource Muted}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <ToggleButton Grid.Column="6" Style="{StaticResource Switch}"
                                                          IsChecked="{Binding Row.Enabled, Mode=OneWay}"
                                                          Click="OnToggle" HorizontalAlignment="Left"
                                                          ToolTip="Выключенная запись остаётся в файле под решёткой и возвращается этим же выключателем" />

                                            <Button Grid.Column="7" Style="{StaticResource Ghost}" Content="⋮"
                                                    Padding="0,2" MinWidth="28" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Click="OnRowMenu"
                                                    AutomationProperties.Name="Что сделать с этой записью"
                                                    ToolTip="Что сделать с этой записью" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Visibility, ElementName=EmptyText}">
                            <Path Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"
                                  Stroke="{DynamicResource Faint}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Data="M 3,22 A 3,3 0 1 1 9,22 A 3,3 0 1 1 3,22 Z M 21,8 A 3,3 0 1 1 27,8 A 3,3 0 1 1 21,8 Z M 21,24 A 3,3 0 1 1 27,24 A 3,3 0 1 1 21,24 Z M 8.1,20.2 L 21.9,9.8 M 9,22.3 L 21,23.7" />
                            <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <WrapPanel>
                        <TextBlock x:Name="SelectedText" Text="Выбрано: 0" VerticalAlignment="Center"
                                   Margin="0,0,14,0" MinWidth="90" />
                        <Button x:Name="DeleteButton" Style="{StaticResource Ghost}" Content="Удалить"
                                Foreground="{DynamicResource Danger}" Click="OnDeleteSelected" Margin="0,0,8,0"
                                IsEnabled="False" gui:ButtonGlyph.Lead="&#xE74D;" />
                        <Button x:Name="EnableButton" Style="{StaticResource Ghost}" Content="Включить"
                                Click="OnEnableSelected" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="DisableButton" Style="{StaticResource Ghost}" Content="Отключить"
                                Click="OnDisableSelected" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="ClearSelectionButton" Style="{StaticResource Ghost}" Content="Снять выбор"
                                Click="OnClearSelection" IsEnabled="False" />
                    </WrapPanel>
                </Border>
            </Grid>

            <!-- Правая колонка; на узком окне — под таблицей, по кнопке «Добавить запись» (OnBodySize). -->
            <ScrollViewer x:Name="SideHost" Grid.Column="1" Style="{StaticResource PageScroll}"
                          Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Добавить запись" FontWeight="SemiBold" FontSize="15" />

                            <UniformGrid Rows="1" Margin="0,12,0,0">
                                <Button x:Name="OneTab" Style="{StaticResource Choice}" Click="OnOneTab"
                                        Padding="14,6" Margin="0,0,4,0">
                                    <TextBlock Text="Одна запись" HorizontalAlignment="Center" />
                                </Button>
                                <Button x:Name="ListTab" Style="{StaticResource Choice}" Click="OnListTab"
                                        Padding="14,6" Margin="4,0,0,0">
                                    <TextBlock Text="Список" HorizontalAlignment="Center" />
                                </Button>
                            </UniformGrid>

                            <StackPanel x:Name="OnePanel" Margin="0,12,0,0">
                                <TextBlock Text="Имя" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                <TextBox x:Name="NewName" KeyDown="OnNewKey" gui:Hint.Text="example.com" />
                                <TextBlock Text="Адрес" Style="{StaticResource Caption}" Margin="2,10,0,4" />
                                <TextBox x:Name="NewAddress" KeyDown="OnNewKey" gui:Hint.Text="93.184.216.34" />
                            </StackPanel>

                            <StackPanel x:Name="ListPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,4" TextWrapping="Wrap"
                                           Text="По строке: адрес и имя в любом порядке, можно несколько имён. Решётка и всё за ней — подпись." />
                                <TextBox x:Name="NewList" AcceptsReturn="True" Height="130" TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource {x:Type TextBox}}" FontFamily="{DynamicResource MonoFont}"
                                         gui:Hint.Text="93.184.216.34 example.com" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Адрес самого сервиса" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleButton x:Name="NewService" Grid.Column="1" Style="{StaticResource Switch}" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Включите, если адрес — сам сервис (Meta, Twitter), а не посредник: тогда десинк имя не пропустит. Для XBOX DNS, Comss и им подобных — выключено." />

                            <Button x:Name="AddButton" Style="{StaticResource Primary}" Content="Добавить запись"
                                    Click="OnAddPin" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                    gui:ButtonGlyph.Lead="&#xE710;" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Источники записей" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Кто ведёт строку — по блоку файла, в котором она лежит. Программы размечают свои записи блоками и могут вернуть удалённое при следующей своей правке.&#x0a;&#x0a;«Неизвестно» — строка вне блоков: вы сами, антивирус или программа, которой уже нет.&#x0a;&#x0a;Щелчок — показать в таблице только этот источник." />
                            </StackPanel>
                            <ItemsControl x:Name="Sources">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" MinHeight="{StaticResource HControlSm}" CornerRadius="{StaticResource RMd}" Cursor="Hand"
                                                Background="{Binding Back}" BorderBrush="{Binding Edge}"
                                                BorderThickness="{StaticResource Stroke}"
                                                MouseLeftButtonUp="OnSourceClick" ToolTip="Показать только эти записи">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" Margin="2,0,8,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource Accent}" Visibility="{Binding Mark}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Подсказка обязана говорить правду (владелец 19.10): «отменяет любой маршрут» — неверно. -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Что делает запись" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Имя из hosts Windows разрешает сама, до всякого DNS, и адрес берётся из файла." />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="VPN: в «Гибриде» туннель забирает имена через подставные адреса, а прибитое имя их не получит — правило «через VPN» на него не сработает. Где трафик и так идёт через движок, правило по домену действует: имя видно из рукопожатия." />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Десинк: имя с видом «посредник» щит пропускает без обработки, «адрес сервиса» — оставляет рецепту." />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Перед каждой правкой рядом с файлом ложится его копия." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Расположение файла" FontWeight="SemiBold" />
                            <TextBlock x:Name="PathText" Style="{StaticResource Mono}" FontSize="12" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                            <Button Style="{StaticResource Ghost}" Content="Открыть папку" Click="OnOpenFolder"
                                    Margin="0,10,0,0" HorizontalAlignment="Stretch" gui:ButtonGlyph.Lead="&#xE838;" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
