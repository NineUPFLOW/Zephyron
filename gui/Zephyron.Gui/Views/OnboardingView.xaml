<UserControl x:Class="Zephyron.Gui.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:Zephyron.Gui"
             Background="{DynamicResource Chrome}">

    <UserControl.Resources>
        <!--
            Карточка режима на шаге «Режим работы ZY». Выбранная: AccentSoft + AccentLine
            и галочка справа — признак не только цветом (спека «Сигнал», раздел 9).
        -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Shape" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource CardRim}" BorderThickness="{StaticResource Stroke}"
                                    CornerRadius="{StaticResource RLg}" Padding="{StaticResource CardPad}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Hover" Background="{DynamicResource WashHover}" CornerRadius="{StaticResource RLg}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="Check" Data="M 1,5.5 L 4.5,9 L 11,1.5" Stroke="{DynamicResource Accent}"
                                  StrokeThickness="2" StrokeLineJoin="Round" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" Margin="0,12,14,0" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Кнопки шагов — внизу, вне прокрутки (владелец, 06.10, по снимкам
        сборки 7: в окне 1330×890 при масштабе 125 % «Начать» на первом шаге
        и «Дальше» на шаге режима уходили под край). Прокручивается только
        содержимое шага. Обе части — на всю ширину окна (владелец 07.10:
        «каждое окно что мы делаем должно растягиваться на весь экран»;
        до того мастер был не шире 680, и на широком окне по бокам пустовало).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" Style="{StaticResource PageScroll}" Padding="28,22,28,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" x:Name="Head" Style="{StaticResource PageHead}"
                            gui:PageHead.Title="Начало работы"
                            gui:PageHead.Subtitle="">

                <!--
                    Пропускает шаг, на котором сейчас стоите, а не весь
                    мастер — подпись меняется на «Готово» на последнем шаге,
                    где пропускать уже нечего.
                -->
                <Button x:Name="HeaderSkip" Style="{StaticResource Ghost}"
                        Content="Пропустить мастер" Click="OnHeaderSkip" VerticalAlignment="Top" />
            </ContentControl>

            <!-- Полоса шагов: пройденные и текущий — цветом акцента. -->
            <UniformGrid Grid.Row="1" x:Name="Progress" Rows="1" Margin="0,16,0,0" Height="4" />

            <Grid Grid.Row="2" Margin="0,26,0,0">

                <!-- Шаг 1: знакомство -->
                <StackPanel x:Name="Step1">
                    <TextBlock Text="Зачем нужен Zephyron" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="У каждого сайта свой маршрут. Что не заблокировано, идёт напрямую; где хватает десинка, трафик идёт напрямую, но его не узнают; закрытое по IP идёт через ваш VPN; закрытое по стране идёт через посредник с закреплением адреса." />

                    <!--
                        Схема пути, живая. Рисуется в коде (StartHero): пакеты
                        выходят из компьютера одинаковыми, «Маршруты» раскладывают
                        их по четырём дорогам — напрямую, десинк, VPN, пин — и
                        каждая по-своему проходит ТСПУ. Подпись выше называет
                        дороги в том же порядке.
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="0,6">
                        <Viewbox Stretch="Uniform" MaxHeight="300">
                            <Canvas x:Name="Hero" Width="700" Height="298" ClipToBounds="True" />
                        </Viewbox>
                    </Border>

                    <UniformGrid x:Name="Features" Columns="3" Margin="-5,14,-5,0">
                        <Border Style="{StaticResource Card}" Margin="5,0" Opacity="0">
                            <StackPanel>
                                <TextBlock Text="Десинк" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Разрезает и перемешивает первые пакеты, чтобы ТСПУ не узнал сайт. Подписка не нужна." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,0" Opacity="0">
                            <StackPanel>
                                <TextBlock Text="VPN по списку" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="В туннель уходит только названное вами. Банки, игры и российские сайты работают как раньше." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,0" Opacity="0">
                            <StackPanel>
                                <TextBlock Text="Разбор причин" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Проверка блокировок и диагностика показывают, что сломалось и как это исправить, вместо общего «не работает»." />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- Шаг 2: оформление -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="Внешний вид" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Тема включается сразу, попробуйте любую. Позже в «Оформлении» можно сменить её, настроить фон и шрифты или собрать свою." />

                    <ItemsControl x:Name="ThemeList" Margin="0,18,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- Та же плитка, что в «Оформлении» (ThemeTile). -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Id}" Click="OnTheme" Margin="0,0,14,10" Cursor="Hand"
                                        ToolTip="{Binding Tip}" Opacity="{Binding Fade}"
                                        FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel Width="112">
                                        <Border Height="84" CornerRadius="{StaticResource RLg}" BorderThickness="1"
                                                Background="{Binding Backdrop}" BorderBrush="{Binding Edge}">
                                            <Grid>
                                                <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Image}" />
                                                <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Backdrop}"
                                                           Opacity="{Binding Dim}" />

                                                <Border Background="{Binding Surface}" CornerRadius="{StaticResource RMd}"
                                                        Width="52" Height="14" Margin="10,10,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <Border Background="{Binding Fill}" CornerRadius="{StaticResource RMd}"
                                                        Width="44" Height="14" Margin="0,30,10,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" />

                                                <Grid Width="18" Height="18" Margin="0,0,0,9"
                                                      HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <Rectangle RadiusX="4" RadiusY="4" Stroke="{Binding Ring}" StrokeThickness="1.5" />
                                                    <Rectangle RadiusX="2" RadiusY="2" Width="10" Height="10" Fill="{Binding Dot}"
                                                             Visibility="{Binding DotShown}" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                                                   HorizontalAlignment="Center" Margin="0,7,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ThemeStatus" Style="{StaticResource Caption}" Margin="4,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!--
                    Шаг 3: режим работы (владелец, 05.10: «шаг с режимом работы НЗ,
                    который объясняет, как работает каждый»). До 21.10 стоял после
                    подписки; владелец 21.10: «3 вкладку есть ли впн перенеси на
                    4 вкладку». Поэтому «Туннель» выбирается и без подписки: её
                    спросит следующий шаг, а не подключат — останется «Десинк».
                    Выбор пишется при «Дальше» (WorkModes.Choose).
                -->
                <StackPanel x:Name="StepMode" Visibility="Collapsed">
                    <TextBlock Text="Режим работы ZY" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Так программа обходит блокировки. Режим можно сменить в любой момент: на «Главной» и в меню значка в трее." />

                    <StackPanel Margin="0,18,0,0">
                        <RadioButton x:Name="PickDesync" Style="{StaticResource ModeCard}" GroupName="OnboardingMode" Tag="Desync" Checked="OnModePicked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE9E9;" Foreground="{DynamicResource Muted}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PickDesyncName" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Обходит блокировку прямо в вашем соединении: искажает рукопожатие, и фильтр оператора не узнаёт имя сайта. Трафик идёт напрямую, адрес остаётся домашним, подписка не нужна. Не поможет, если сайт закрыт по стране (ChatGPT) или по адресу (Telegram, Instagram)." />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="PickTunnel" Style="{StaticResource ModeCard}" GroupName="OnboardingMode" Tag="Tunnel" Checked="OnModePicked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE774;" Foreground="{DynamicResource Muted}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PickTunnelName" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Весь трафик идёт через туннель, кроме сайтов с пометкой «напрямую». Работает как обычный VPN-клиент: адрес зарубежный, открывается всё, что открывает ваш сервер. Российские сайты тоже увидят зарубежный адрес. Нужна подписка или WARP." />
                                    <TextBlock x:Name="PickTunnelNote" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                                               Text="Подписки пока нет — её спросит следующий шаг. Без неё этот режим поднимать нечем, и останется «Десинк»." />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="PickRoute" Style="{StaticResource ModeCard}" GroupName="OnboardingMode" Tag="Route" Checked="OnModePicked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8AB;" Foreground="{DynamicResource Muted}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PickRouteName" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Оба сразу. Что в «Маршрутах» стоит «через VPN», уходит в туннель — с зарубежным адресом; остальное идёт напрямую, и закрытое по имени чинит десинк. Российские сервисы видят домашний адрес. Без подписки работает как «Десинк»." />
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!--
                        Путь DNS (владелец, 06.10: «добавь в мастер выбор днс напрямую,
                        через туннель или авто»). Здесь, а не отдельным шагом: цена пути
                        зависит от режима — без туннеля «через туннель» значит «через
                        движок», — и пояснение меняется вместе с выбранной карточкой.
                        Те же три пункта и те же слова, что на вкладке DNS
                        (DnsRoutes.Explain); пишется при «Дальше» вместе с режимом.
                        Строкой, цена пути — под «i»: карточкой шаг выходил выше окна
                        (снимок владельца 06.10, сборка 7: окно 1330×890 при масштабе
                        125 %), а с кнопками внизу строка короче и не спорит с режимами.
                    -->
                    <!--
                        Прокси Telegram (владелец, 07.10: «по аналогии с настройкой днс
                        так же и включение тг вс прокси на вкладке с выбором режима»).
                        Стоит то, что в настройках; пишется при «Дальше» вместе с режимом
                        и DNS (TgWsProxy.Switch). Под «i» — нужен ли он при выбранном режиме.
                        Выключатель на подложке той же ширины и вида, что список DNS
                        (владелец 07.10: «сделай фон для прокси телеграм» — голый
                        выключатель терялся на арте темы), подписи — одной колонкой,
                        чтобы поле и подложка начинались с одного места.
                    -->
                    <Grid Margin="4,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="DNS" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1" x:Name="DnsPick" AutomationProperties.Name="Путь DNS" Width="260" VerticalAlignment="Center"
                                  SelectionChanged="OnDnsPicked"
                                  ToolTip="Как программа узнаёт адреса сайтов. Позже это меняется во вкладке DNS.">
                            <ComboBoxItem Content="авто: сначала напрямую, при отказе DoH — по TCP, затем через туннель" Tag="Auto" />
                            <ComboBoxItem Content="спрашивать напрямую" Tag="Direct" />
                            <ComboBoxItem Content="спрашивать через туннель" Tag="Tunnel" />
                        </ComboBox>
                        <ContentControl Grid.Column="2" x:Name="DnsInfo" Style="{StaticResource Info}" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="1" Text="Прокси для Telegram" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,12,0" />
                        <Border Grid.Row="1" Grid.Column="1" Width="260" Margin="0,10,0,0" Padding="12,4,8,4"
                                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RLg}"
                                ToolTip="Telegram Desktop заработает без VPN. Позже это меняется во вкладке «TG Proxy».">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TgPickState" VerticalAlignment="Center" Text="не включено" />
                                <ToggleButton Grid.Column="1" x:Name="TgPick" Style="{StaticResource Switch}" AutomationProperties.Name="Прокси для Telegram" VerticalAlignment="Center"
                                              ToolTipService.ShowOnDisabled="True"
                                              Checked="OnTgPicked" Unchecked="OnTgPicked" />
                            </Grid>
                        </Border>
                        <ContentControl Grid.Row="1" Grid.Column="2" x:Name="TgInfo" Style="{StaticResource Info}" Margin="4,10,0,0" />
                    </Grid>
                </StackPanel>

                <!--
                    Шаг 4, последний: подписка на VPN. Шага «Запуск и проверка»
                    после него больше нет (владелец 21.10: «5 вкладку удали») —
                    движки поднимаются на «Главной».
                -->
                <StackPanel x:Name="StepVpn" Visibility="Collapsed">
                    <TextBlock Text="У вас есть подписка на VPN?" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Своя подписка — та же ссылка, что вставляют в Happ или другой клиент. Программа её не выдаёт: десинк работает и без неё, но открывает не всё — то, что ТСПУ банит по IP (например Telegram), лечится только через туннель." />

                    <!-- Что подписка значит для режима, выбранного шагом раньше. -->
                    <TextBlock x:Name="VpnForMode" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="Адрес подписки" Style="{StaticResource Caption}" Margin="4,18,0,4" />

                    <!--
                        Пароль, не текст: ссылка на подписку равносильна
                        паролю, выдаёт весь список серверов с ключами.
                    -->
                    <PasswordBox x:Name="SubLink" AutomationProperties.Name="Адрес подписки" Padding="10,8" />

                    <TextBlock x:Name="VpnStatus" Style="{StaticResource Caption}"
                               Margin="4,10,0,0" TextWrapping="Wrap" />
                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>

    <!-- Кнопки шага: видна полоса текущего (Show), прочие свёрнуты. -->
    <Grid Grid.Row="1" Margin="32,10,32,24">
        <StackPanel x:Name="Step1Buttons" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Primary}" Content="Приступить" Click="OnIntroNext" />
        </StackPanel>

        <StackPanel x:Name="Step2Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
            <Button Style="{StaticResource Ghost}" Content="Вернуться" Margin="0,0,8,0" Click="OnBack" />
            <Button Style="{StaticResource Primary}" Content="Далее" Click="OnThemeNext" />
        </StackPanel>

        <StackPanel x:Name="StepModeButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
            <Button Style="{StaticResource Ghost}" Content="Вернуться" Margin="0,0,8,0" Click="OnBack" />
            <Button Style="{StaticResource Primary}" Content="Далее" Click="OnModeNext" />
        </StackPanel>

        <!--
            Подписка загрузилась — «Нет подписки» и «Загрузить» уходят,
            остаётся «Готово» (ShowVpnButtons): число серверов видно до ухода
            на «Главную».
        -->
        <StackPanel x:Name="StepVpnButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
            <Button Style="{StaticResource Ghost}" Content="Вернуться" Margin="0,0,8,0" Click="OnBack" />
            <Button x:Name="NoSubscription" Style="{StaticResource Ghost}" Content="Нет подписки" Margin="0,0,8,0" Click="OnNoSubscription" />
            <Button x:Name="VpnLoad" Style="{StaticResource Primary}" Content="Подключить" Click="OnAddSubscription" />
            <Button x:Name="VpnDone" Style="{StaticResource Primary}" Content="Готово" Click="OnFinish" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
    </Grid>
</UserControl>
