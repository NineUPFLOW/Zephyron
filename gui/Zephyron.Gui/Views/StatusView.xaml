<UserControl x:Class="Zephyron.Gui.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Zephyron.Gui"
             xmlns:views="clr-namespace:Zephyron.Gui.Views"
             Background="{DynamicResource Chrome}">

    <UserControl.Resources>
        <!--
            Сегмент режима: выбранный отмечен рамкой Accent и подложкой AccentSoft,
            без свечения — как выбранный пункт меню.
        -->
        <Style x:Key="ModeSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="{DynamicResource Wash}"
                                BorderBrush="{DynamicResource LineStrong}" BorderThickness="{StaticResource Stroke}"
                                CornerRadius="{StaticResource RMd}" Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource WashHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка компонента: нейтральная, состояние говорит знак (StateMark) и слово. -->
        <Style x:Key="EnginePill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Wash}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="{StaticResource Stroke}" />
            <Setter Property="CornerRadius" Value="{StaticResource RMd}" />
            <Setter Property="Padding" Value="14,10,6,10" />
        </Style>

        <!-- Заголовок блока «Главной»: «Компоненты», «Сеть», «События». -->
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <!-- Время работы на плашке: табличные цифры, Muted. -->
        <Style x:Key="HeroTime" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Typography.NumeralStyle" Value="Lining" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Единица рядом с крупным числом: общая нижняя линия с Metric (поправка на разницу кеглей). -->
        <Style x:Key="NetUnit" TargetType="TextBlock" BasedOn="{StaticResource MetricUnit}">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="6,0,0,5" />
            <Setter Property="Text" Value="Мбит/с" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <!--
        «Главная» в языке «Сигнал»: главная плашка состояния (знак, слово, цвет
        и дорожки FlowLanes) и справа «Компоненты»; ниже «Сеть» — четыре числа
        и два графика; затем режим, события, пресет, подключение, автозапуск,
        обновление. Все карточки, кроме плашки, нейтральные: без акцентных
        обводок и срезов. Окно уже ~980 — компактная раскладка (Compact в коде):
        плашка на всю ширину, «Компоненты» двумя плитками под ней, «Сеть» 2x2,
        графики друг под другом.

        Если у темы есть картинка, справа остаётся колонка под арт (SideArt,
        Themes.cs), как прежде: веса 100 к 1, левая берёт всё до своего
        предела, правой достаётся остаток — на узком окне ноль.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="100*" MinWidth="560" />
            <ColumnDefinition x:Name="ArtColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Арт сбоку. Картинка одна на всю страницу, но сдвинута так, что её
            середина стоит посередине правой колонки (PlaceArt). Не прокручивается —
            это фон.
        -->
        <Grid x:Name="ArtLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" SizeChanged="OnArtSize">
            <!-- Градиент под картинкой, уложенной руками (HomePlacement, 15.10). -->
            <Rectangle x:Name="ArtGround" />
            <Rectangle x:Name="Art" />
            <Rectangle x:Name="ArtShade" />
        </Grid>

        <!-- Низ 16, а не PagePad 24: «Главная» целиком влезает в развёрнутое окно 1920x1080 (26.10). -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="0" Style="{StaticResource PageScroll}" Padding="24,20,24,16">
            <StackPanel x:Name="Page">

                <!--
                    Просьба о звезде и канале (владелец, 01.10) — первой на «Главной». Прячется навсегда:
                    «Скрыть» пишет SupportCardHidden. Показывается после мастера
                    первого запуска — до него человеку не до звёзд.
                -->
                <Border x:Name="SupportCard" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Width="32" Height="32" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE735;" FontSize="14" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Text="Нравится Zephyron?" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="Поставьте звезду на GitHub, подпишитесь на канал или поддержите донатом: так о программе узнают другие, а вы — о новых версиях." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Quiet}" Click="OnStar" Margin="0,0,4,0" Content="Звезда"
                                    local:ButtonGlyph.Lead="&#xE734;"
                                    ToolTip="Страница Zephyron на GitHub — звезда справа вверху" />
                            <Button Style="{StaticResource Quiet}" Click="OnTelegram" Margin="0,0,4,0" Content="Канал"
                                    local:ButtonGlyph.Lead="&#xE724;" ToolTip="Новости в телеграм-канале" />
                            <Button Style="{StaticResource Ghost}" Click="OnSupport" Margin="0,0,6,0" Content="Поддержать"
                                    local:ButtonGlyph.Lead="&#xEB51;" ToolTip="Поддержать разработку донатом" />
                            <Button Style="{StaticResource IconGhost}" Click="OnSupportHide" Content="&#xE711;" FontSize="11"
                                    Padding="7,6" MinWidth="0" Background="Transparent" BorderBrush="Transparent"
                                    ToolTip="Скрыть и больше не показывать" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Вышла новая версия (UpdateNotice). Сразу под просьбой о звезде: её видно при
                    первом взгляде на окно. «Не сейчас» прячет её до следующей
                    версии. Решение владельца 23.09: карточка и точка у пункта
                    меню, без уведомлений Windows.
                -->
                <Border x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Width="32" Height="32"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE896;" FontSize="14" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="UpdateWhat" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Quiet}" Content="Что нового"
                                    Click="OnUpdateNotes" Margin="0,0,4,0" />
                            <Button Style="{StaticResource Quiet}" Content="Не сейчас"
                                    Click="OnUpdateLater" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Primary}" Content="Обновить" Padding="16,8"
                                    Click="OnUpdateNow" />
                        </StackPanel>
                    </Grid>
                </Border>


                <!--
                    Ряд управления: слева главная плашка состояния, справа компоненты.
                    В компактной раскладке (Compact) компоненты уходят строкой ниже.
                -->
                <Grid x:Name="TopRow" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="250" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!--
                    Главная плашка: идёт ли обход и что с ним — формой знака, словом
                    и цветом (одно состояние на всё: HomeState). Единственная
                    карточка со срезом угла и единственная с тинтом: радиальный
                    цвет состояния @6 % из верхнего левого угла (у «Выключен» нет).
                    Справа единственная кнопка: «Запустить» (Primary) или, пока
                    обход идёт, «Остановить» (Ghost): акцент горит только на «входе».

                    Время работы стоит под словом, а не вместо него: остановленный
                    обход не показывает нулей. Цвет и слово ставит ShowHero.
                -->
                <views:FitWidth Grid.Column="0" x:Name="HeroCell">
                    <Border x:Name="Hero" Style="{StaticResource Card}" Padding="0" local:Chamfer.Size="10">
                        <Grid>
                            <Rectangle x:Name="Tint" IsHitTestVisible="False" Opacity="0.06" Visibility="Collapsed">
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="1.4">
                                        <GradientStop Color="Black" Offset="0" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>

                            <Grid Margin="24,20,24,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Два знака друг над другом: при смене состояния один гаснет, другой проявляется (160 мс). -->
                                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Success}" StrokeThickness="2" Opacity="0"
                                             IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="RingScale" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Control x:Name="MarkA" Style="{StaticResource StateMark}" Width="40" Height="40" Tag="Off" />
                                    <Control x:Name="MarkB" Style="{StaticResource StateMark}" Width="40" Height="40" Tag="Off" Opacity="0" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="StateLine" Style="{StaticResource StateWord}" Foreground="{DynamicResource Muted}"
                                               Text="Проверяю…" TextTrimming="CharacterEllipsis"
                                               AutomationProperties.LiveSetting="Polite" />

                                    <!--
                                        Время, затем одна строка пояснения; не помещается — пояснение уходит строкой ниже.
                                        Высота 52 — строка времени и две строки пояснения при любом состоянии: иначе
                                        плашка росла при пуске и ряд под ней прыгал (видео владельца, 26.10).
                                    -->
                                    <WrapPanel Margin="0,2,0,0" Height="52">
                                        <StackPanel x:Name="UptimeBox" Orientation="Horizontal" Visibility="Collapsed">
                                            <TextBlock x:Name="Uptime" Style="{StaticResource HeroTime}" Margin="0,0,12,0" Text="00:00:00" />
                                        </StackPanel>
                                        <!-- Не больше двух строк: длиннее — плашка перерастала соседей, и ряд прыгал (26.10). Целиком — в подсказке. -->
                                        <TextBlock x:Name="StateHint" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" MaxWidth="560" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </WrapPanel>
                                </StackPanel>

                                <!--
                                    «Остановить ▾»: рядом с кнопкой — меню с перезапуском
                                    и двумя выходами, как в трее. В колонке — только кнопки:
                                    её ширина берётся по содержимому и отнимается у слова
                                    и пояснения слева.
                                -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Grid HorizontalAlignment="Right">
                                        <Button x:Name="StartButton" Style="{StaticResource Primary}" Height="40" MinWidth="150" Padding="22,0"
                                                Click="OnStart" Visibility="Collapsed"
                                                local:ButtonGlyph.Lead="&#xE768;" Content="Запустить" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Visibility, ElementName=StopButton}">
                                            <Button x:Name="StopButton" Style="{StaticResource Ghost}" Height="40" MinWidth="150" Padding="22,0"
                                                    Click="OnStop" Visibility="Collapsed"
                                                    local:ButtonGlyph.Lead="&#xE71A;" Content="Остановить" />
                                            <Button x:Name="EngineMenuButton" Style="{StaticResource Ghost}" Height="40" Margin="6,0,0,0"
                                                    Click="OnEngineMenu" Padding="14,0" MinWidth="0"
                                                    ToolTip="Перезапустить движки или выйти из программы"
                                                    AutomationProperties.Name="Перезапуск и выход">
                                                <Path Data="M 0 0 L 5 5 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.6" Margin="0,2,0,0" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!--
                                    Процессор в долях ядра, память и трафик туннеля с запуска. Только
                                    пока обход идёт. Своей строкой на всю ширину, а не под кнопкой:
                                    там строка в ~370 точек раздвигала колонку кнопок, и на средней
                                    ширине окна слово «Работает» и пояснение сжимались в столбик (25.10).
                                -->
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="EngineMeters" Style="{StaticResource MonoTag}"
                                           Margin="56,10,0,0" TextTrimming="CharacterEllipsis" Visibility="Hidden" Text=" " />

                                <!--
                                    Трассы (FlowLanes): какие пути от компьютера к сети открыты
                                    сейчас и как бежит по ним трафик. Знак «Главной» Zephyron.
                                -->
                                <views:FlowLanes Grid.Row="2" Grid.ColumnSpan="3" x:Name="Lanes" Margin="0,10,0,0"
                                                 AutomationProperties.Name="Пути трафика: десинк, напрямую, туннель" />
                            </Grid>
                        </Grid>
                    </Border>
                </views:FitWidth>

                    <!--
                        Компоненты этого запуска — каждый строкой: знак и слово его
                        состояния, номер процесса и переход к настройкам (ShowEngine).
                    -->
                    <views:FitWidth Grid.Column="2" x:Name="ComponentsCell">
                        <Border x:Name="ComponentsCard" Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Компоненты" Style="{StaticResource SectionHead}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                                               Text="Движки этого запуска: состояние и номер процесса." />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource Quiet}" Click="OnQuickDoctor" Padding="8,5"
                                            local:ButtonGlyph.Lead="&#xE9D9;" Content="Диагностика" />
                                </StackPanel>

                                <UniformGrid x:Name="Chips" Columns="1" VerticalAlignment="Top">
                                    <Border x:Name="DesyncChip" Style="{StaticResource EnginePill}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Control x:Name="DesyncMark" Style="{StaticResource StateMark}" Width="10" Height="10" Tag="Off"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="Десинк" />
                                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource MonoTag}" Text="winws2" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="DesyncState" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" />
                                                    <TextBlock x:Name="DesyncPid" Margin="8,0,0,0" Style="{StaticResource MonoTag}"
                                                               VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE713;"
                                                    Padding="7,5" MinWidth="0" FontSize="12" Click="OnDesyncSettings"
                                                    Background="Transparent" BorderBrush="Transparent"
                                                    ToolTip="Пресеты и рецепты — раздел «Десинк»" AutomationProperties.Name="Настройки десинка" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="TunnelChip" Style="{StaticResource EnginePill}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Control x:Name="TunnelMark" Style="{StaticResource StateMark}" Width="10" Height="10" Tag="Off"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="Туннель" />
                                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource MonoTag}" Text="sing-box" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="TunnelState" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" />
                                                    <TextBlock x:Name="TunnelPid" Margin="8,0,0,0" Style="{StaticResource MonoTag}"
                                                               VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE713;"
                                                    Padding="7,5" MinWidth="0" FontSize="12" Click="OnTunnelSettings"
                                                    Background="Transparent" BorderBrush="Transparent"
                                                    ToolTip="Настройки туннеля" AutomationProperties.Name="Настройки туннеля" />
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </DockPanel>
                        </Border>
                    </views:FitWidth>
                </Grid>

                <!-- Предупреждения: защитник в стеке, стёртый hosts. Пусто — не показываем. -->
                <ItemsControl x:Name="Warnings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Одной строкой, полный текст — в подсказке: плашка не должна
                                раздвигать «Главную» так, что низ уходит за край (жалоба 28.10).
                            -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,10"
                                    Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}"
                                    ToolTip="{Binding Body}">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Body, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}"
                           Margin="4,0,0,12" TextWrapping="Wrap" Visibility="Collapsed" />


                <!-- Режим работы и события — рядом. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="250" />
                    </Grid.ColumnDefinitions>

                <!--
                    Режим — выбором из трёх (владелец 04.10, docs/ideas.md №12):
                    «Десинк», «Туннель», «Гибрид». Хранится выключателями движков
                    (Rules.WorkModes): переносить настройки не нужно. Под
                    сегментами — пояснение выбранного режима и его движки.
                -->
                <views:FitWidth Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="Режим работы" Style="{StaticResource Eyebrow}" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="ModeTag" Style="{StaticResource MonoTag}" Margin="12,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="ModeDesync" Grid.Column="0" Style="{StaticResource ModeSegment}"
                                             GroupName="WorkMode" Tag="Desync" Click="OnMode">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource LineGlyph}" FontSize="14" Text="&#xE9E9;"
                                                   Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                        <TextBlock x:Name="ModeDesyncName" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                        Content="winws2: вмешивается в рукопожатие TLS так, что фильтр оператора не опознаёт имя. Трафик идёт напрямую, своим обычным путём, и адрес остаётся домашним.&#x0a;&#x0a;Лечит блокировки по имени и не лечит отказы по стране: сайт видит тот же адрес, что и без него." />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ModeTunnel" Grid.Column="2" Style="{StaticResource ModeSegment}"
                                             GroupName="WorkMode" Tag="Tunnel" Click="OnMode">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource LineGlyph}" FontSize="14" Text="&#xE774;"
                                                   Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                        <TextBlock x:Name="ModeTunnelName" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                        Content="sing-box: поднимает сетевой адаптер и уводит через него трафик. Адрес становится зарубежным, и это лечит отказы по стране.&#x0a;&#x0a;В этом режиме забирает всё, кроме поставленного «напрямую», — как обычный VPN. Без исключений (настройки туннеля) — вообще всё.&#x0a;&#x0a;Требует подписки или WARP: без них поднимать нечего." />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ModeRoute" Grid.Column="4" Style="{StaticResource ModeSegment}"
                                             GroupName="WorkMode" Tag="Route" Click="OnMode">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource LineGlyph}" FontSize="14" Text="&#xE8AB;"
                                                   Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                        <TextBlock x:Name="ModeRouteName" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                        Content="Оба движка сразу. Что названо в маршрутах «через VPN», уходит в туннель; остальное идёт напрямую, и закрытое по имени чинит десинк.&#x0a;&#x0a;Адрес для сайтов из маршрутов — зарубежный, для прочих — домашний: российские сервисы не видят VPN." />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <!--
                                Пояснение выбранного режима; его движки — в «Компонентах» (0.18).
                                Место — под две строки всегда: ряд, растущий только
                                у одного режима, дёргал бы страницу.
                            -->
                            <Grid Margin="2,16,0,0" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ModeText" Style="{StaticResource Caption}" FontSize="12.5" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="19"
                                           LineStackingStrategy="BlockLineHeight" MaxHeight="38" Margin="0,0,20,0" />

                            </Grid>

                            <!-- Жалоба на сочетание движков; пусто — полосы нет вовсе. -->
                            <Border Margin="0,14,0,0" Padding="12,9" CornerRadius="{StaticResource RSm}"
                                    Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}"
                                    BorderThickness="{StaticResource Stroke}"
                                    Visibility="{Binding Visibility, ElementName=EnginesLine}">
                                <!-- DockPanel, а не горизонтальная стопка: в ней ширина бесконечна и текст не переносится. -->
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource LineGlyph}" Text="&#xE7BA;" FontSize="13"
                                               Foreground="{DynamicResource Warn}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock x:Name="EnginesLine" FontSize="11.5" Foreground="{DynamicResource Warn}"
                                               TextWrapping="Wrap" Visibility="Collapsed" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </views:FitWidth>

                    <!--
                        События — последние строки общего журнала (runtime\supervisor.log),
                        который пишут надзор и окно: запуск, остановка, сбои, правки.
                        Читаются в фоне раз в несколько секунд (StatusView.Events.cs).
                    -->
                    <views:FitWidth Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="OnQuickLog" Padding="8,4"
                                            Content="Весь журнал" local:ButtonGlyph.Lead="&#xE8FD;" />
                                    <TextBlock Text="События" Style="{StaticResource SectionHead}" VerticalAlignment="Center" />
                                </DockPanel>

                                <Grid>
                                    <!--
                                        Не выше четырёх строк: карточка не растёт от числа событий
                                        и не раздвигает ряд «Режим работы» (жалоба 28.10). Остальное —
                                        в «Весь журнал».
                                    -->
                                    <ItemsControl x:Name="Events" Focusable="False" MaxHeight="96" ClipToBounds="True"
                                                  VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7" ToolTip="{Binding Full}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="3" Margin="0,2,10,2" Fill="{Binding Tone}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource MonoTag}"
                                                               Margin="0,1,10,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Muted}">
                                                        <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Message, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="EventsEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="Событий пока нет: журнал пишется с первого запуска движков." />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </views:FitWidth>
                </Grid>

                <!-- Пресет и параметры подключения — рядом. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="250" />
                    </Grid.ColumnDefinitions>

                    <views:FitWidth Grid.Column="0">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE9E9;" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Текущий пресет" Style="{StaticResource Eyebrow}" />
                                    <TextBlock x:Name="PresetValue" FontSize="13.5" FontWeight="Medium" Text="—" Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <!--
                                        Первая фраза описания из самого файла пресета
                                        («# Description:»), в две строки. Своих описаний
                                        не придумываем: пресеты меняются выпусками,
                                        и придуманное разошлось бы с файлом.
                                    -->
                                    <TextBlock x:Name="PresetNote" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                </StackPanel>

                                <!--
                                    Смена пресета — тем же, чем в «Десинке»: запись
                                    PresetName и предложение перезапустить.
                                -->
                                <Button Grid.Row="1" Grid.Column="1" x:Name="PresetMenu" Style="{StaticResource Ghost}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,14,0,0"
                                        Content="Изменить" local:ButtonGlyph.Menu="True" Click="OnPresetMenu" />
                            </Grid>
                        </Border>
                    </views:FitWidth>

                    <!-- Настройка. Только показ: правка — в своих разделах. -->
                    <views:FitWidth Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8CE;" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Параметры подключения" Style="{StaticResource Eyebrow}" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" Text="Сервер"
                                                   Margin="0,0,20,8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ServerValue" Text="—" Margin="0,0,0,8"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                                        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" Text="DNS"
                                                   Margin="0,0,20,8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DnsValue" Text="—" Margin="0,0,0,8"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                                        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Foreground="{DynamicResource Faint}" Text="Подписки"
                                                   Margin="0,0,20,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SubscriptionValue" Text="—"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </views:FitWidth>
                </Grid>

                <!-- Автозапуск и обновление — рядом. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="250" />
                    </Grid.ColumnDefinitions>

                    <views:FitWidth Grid.Column="0">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE945;" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Автозапуск" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                        Content="Задача планировщика, а не служба: правами администратора задача наделяется сразу, запрос UAC при входе не появляется. Запускается та же программа и с теми же ключами, что и кнопка «Запустить», — иначе автозапуск поднимал бы не то, что вы проверили руками." />
                                    </StackPanel>

                                    <!--
                                        Что именно поднимется — теми же словами, какими
                                        это задано выключателями движков. Своего выбора
                                        у автозапуска нет намеренно: он был бы вторым
                                        местом, где решают одно и то же.
                                    -->
                                    <TextBlock x:Name="AutostartRaises" Style="{StaticResource Caption}"
                                               Margin="0,5,0,0" TextWrapping="Wrap" />

                                    <!--
                                        Слова о задаче — только когда с ней не всё
                                        ясно: проверяется, не читается, устарела.
                                    -->
                                    <TextBlock x:Name="AutostartValue" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>

                                <!--
                                    Выключатель, а не кнопка «Завести/Убрать». Щелчок
                                    заводит или убирает задачу, а положение затем ставится
                                    по ответу планировщика: отказал — выключатель вернётся.
                                -->
                                <ToggleButton Grid.Column="2" x:Name="AutostartSwitch" Style="{StaticResource Switch}"
                                              Click="OnAutostart" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </views:FitWidth>

                    <views:FitWidth Grid.Column="2">
                        <views:UpdatePanel x:Name="Updates" />
                    </views:FitWidth>
                </Grid>

                <!--
                    Сеть — полоса в одну строку: заголовок, четыре числа (знак слева от
                    подписи — он же легенда графика) и два низких графика под ними:
                    скорость за минуту и задержка за две. Всё — настоящие замеры
                    StatusView.Net.cs, и только пока обход запущен (SyncNet):
                    остановленный — «—» и пустые графики, а не нули.
                -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Сеть" Style="{StaticResource SectionHead}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MonoTag}" VerticalAlignment="Center"
                                   Text="все адаптеры · ICMP до 1.1.1.1" />

                        <!-- В компактной раскладке (Compact) числа уходят строкой ниже, по два. -->
                        <UniformGrid x:Name="NetMetrics" Grid.Column="1" Columns="4" VerticalAlignment="Center">
                            <StackPanel x:Name="NetDownCell" Orientation="Horizontal" Margin="0,0,16,0" Background="Transparent"
                                        ToolTip="Приём по всем сетевым адаптерам машины">
                                <Rectangle Width="12" Height="2" Fill="{DynamicResource Accent2}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Caption}" Text="Приём" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <TextBlock x:Name="NetDown" Style="{StaticResource Metric}" FontSize="15" Foreground="{DynamicResource Muted}" Text="—"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="NetDownUnit" Style="{StaticResource NetUnit}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel x:Name="NetUpCell" Orientation="Horizontal" Margin="0,0,16,0" Background="Transparent"
                                        ToolTip="Отдача по всем сетевым адаптерам машины">
                                <Line X2="12" Y1="1" Y2="1" Width="12" Height="2" Stroke="{DynamicResource Text}" Opacity="0.75"
                                      StrokeThickness="2" StrokeDashArray="3,2" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Caption}" Text="Отдача" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <TextBlock x:Name="NetUp" Style="{StaticResource Metric}" FontSize="15" Foreground="{DynamicResource Muted}" Text="—"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="NetUpUnit" Style="{StaticResource NetUnit}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel x:Name="NetPingCell" Orientation="Horizontal" Margin="0,0,16,0" Background="Transparent"
                                        ToolTip="Задержка до 1.1.1.1 по ICMP, раз в пять секунд">
                                <Rectangle Width="12" Height="2" Fill="{DynamicResource Accent2}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Caption}" Text="Задержка" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <TextBlock x:Name="NetPing" Style="{StaticResource Metric}" FontSize="15" Foreground="{DynamicResource Muted}" Text="—"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="NetPingUnit" Style="{StaticResource NetUnit}" Margin="4,0,0,0" VerticalAlignment="Center" Text="мс" />
                            </StackPanel>

                            <StackPanel x:Name="NetLossCell" Orientation="Horizontal" Margin="0,0,16,0" Background="Transparent"
                                        ToolTip="Доля потерянных проверок задержки за последние две минуты">
                                <Path Data="M 4,0 L 8,4 L 4,8 L 0,4 Z" Width="8" Height="8" Fill="{DynamicResource Warn}" VerticalAlignment="Center" Margin="2,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="Потери" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <TextBlock x:Name="NetLoss" Style="{StaticResource Metric}" FontSize="15" Foreground="{DynamicResource Muted}" Text="—"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="NetLossUnit" Style="{StaticResource NetUnit}" Margin="4,0,0,0" VerticalAlignment="Center" Text="%" />
                            </StackPanel>
                        </UniformGrid>

                        <!-- Два графика в ряд; в компактной раскладке — друг под другом. -->
                        <Grid x:Name="Charts" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="ChartRowGap" Height="0" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <views:NetChart x:Name="ThroughputChart" Height="56" Capacity="60" Unit="Мбит/с" Floor="1"
                                            Empty="Скорость начнёт писаться с запуском обхода"
                                            AutomationProperties.Name="График скорости за минуту" />

                            <views:NetChart x:Name="LatencyChart" Grid.Column="2" Height="56" Capacity="24" Unit="мс" Floor="20"
                                            Empty="Нет данных" AutomationProperties.Name="График задержки за две минуты" />
                        </Grid>
                    </Grid>
                </Border>


                <!--
                    Быстрые действия: переходы в разделы разбора и папка настроек —
                    то, за чем идут, когда что-то не так. Журнал — в карточке «События».
                -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <Button Style="{StaticResource Ghost}" Padding="10,9" Margin="0,0,8,0" Click="OnQuickCheck"
                            local:ButtonGlyph.Lead="&#xE721;" Content="Проверить блокировки" />
                    <Button Style="{StaticResource Ghost}" Padding="10,9" Margin="0,0,8,0" Click="OnQuickDoctor"
                            local:ButtonGlyph.Lead="&#xE756;" Content="Диагностика" />
                    <Button Style="{StaticResource Ghost}" Padding="10,9" Click="OnQuickConfig"
                            local:ButtonGlyph.Lead="&#xE8B7;" Content="Открыть конфиг"
                            ToolTip="Папка config в проводнике, файл настроек выделен" />
                </UniformGrid>

                <!--
                    Подвал: сколько работает обход и когда собран конфиг туннеля,
                    справа — ссылки на описание, исходники и канал.
                -->
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="4,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Control x:Name="FooterMark" Style="{StaticResource StateMark}" Width="10" Height="10" Tag="Off"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="FooterState" Style="{StaticResource MonoTag}" FontSize="11"
                                       Foreground="{DynamicResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="FooterConfig" Style="{StaticResource MonoTag}" FontSize="11"
                                   Margin="18,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Quiet}" Padding="9,5" FontSize="11.5" Click="OnDocs"
                                    local:ButtonGlyph.Lead="&#xE82D;" Content="Документация" ToolTip="Описание программы на GitHub" />
                            <Button Style="{StaticResource Quiet}" Padding="9,5" FontSize="11.5" Click="OnGitHub"
                                    local:ButtonGlyph.Lead="&#xE943;" Content="GitHub" ToolTip="Исходники, выпуски, вопросы и обсуждения" />
                            <Button Style="{StaticResource Quiet}" Padding="9,5" FontSize="11.5" Click="OnTelegram"
                                    local:ButtonGlyph.Lead="&#xE724;" Content="Telegram"
                                    ToolTip="Новости в телеграм-канале: что вышло и зачем обновляться, коротко" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
