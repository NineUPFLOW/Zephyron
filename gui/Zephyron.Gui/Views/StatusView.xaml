<UserControl x:Class="Zephyron.Gui.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Zephyron.Gui"
             xmlns:views="clr-namespace:Zephyron.Gui.Views"
             Background="{DynamicResource Backdrop}">

    <UserControl.Resources>
        <!-- Строка-ключ и значение: имя слева, значение справа, как в карточках. -->
        <Style x:Key="KeyLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="KeyValue" TargetType="TextBlock" BasedOn="{StaticResource KeyLine}">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!--
            Кнопка питания героя (макет, .power): мягкий акцент, крупная,
            с запасом по краям. Остановка — красным (макет, .power.is-stop):
            это единственное действие, у которого цвет что-то значит.
        -->
        <Style x:Key="PowerButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,14" />
        </Style>

        <!-- Ячейка метрики сети (макет, .net-item): подпись, число, единица. -->
        <Style x:Key="NetItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="NetCap" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>

        <Style x:Key="NetValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NetUnit" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <!--
        «Главная» — по эталонному макету (docs/design/mockup.html, .ct):
        одна колонка по центру, герой сверху, за ним метрика сети, панель
        режима, пары карточек, быстрые действия, баннер поддержки и строка
        внизу. Слева и справа — воздух, справа же ложится арт темы.

        Две колонки, а не одна: содержимое по центру ограничено 1080 точками
        (как .ct в макете), а правая звезда отдана арту — по её ширине
        PlaceArt решает, ставить персонажа сбоку или прятать за затемнением.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ContentColumn" Width="100*" MinWidth="560" MaxWidth="1080" />
            <ColumnDefinition x:Name="ArtColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Арт темы — картинка или живой фон, сдвинутые вправо и растворяющиеся
            в подложке. Раскладывается в коде (PlaceArt): место зависит
            от ширины колонок. Не прокручивается — это фон.
        -->
        <Grid x:Name="ArtLayer" Grid.ColumnSpan="3" IsHitTestVisible="False" SizeChanged="OnArtSize">
            <Rectangle x:Name="Art" />
            <Rectangle x:Name="ArtShade" />
        </Grid>

        <ScrollViewer Grid.Column="1" Style="{StaticResource PageScroll}" Padding="32,16,32,40">
            <StackPanel>

                <!--
                    Вышла новая версия (UpdateNotice). Над героем: её видно
                    при первом взгляде на окно, а не только тем, кто дошёл вниз.
                    «Не сейчас» прячет её до следующей версии.
                -->
                <Border x:Name="UpdateCard" Style="{StaticResource Banner}" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource Accent}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource BannerIcon}" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE896;" FontSize="16"
                                       Foreground="{DynamicResource Accent}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="UpdateWhat" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Content="Что нового"
                                    Padding="14,7" Click="OnUpdateNotes" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Ghost}" Content="Не сейчас"
                                    Padding="14,7" Click="OnUpdateLater" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Primary}" Content="Обновить"
                                    Padding="16,8" Click="OnUpdateNow" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Герой раздела — по макету (.hero): пилюля состояния, крупный
                    таймер работы, полоса и кнопка питания. Первое, зачем окно
                    открывают, — понять, идёт ли обход и сколько.
                -->
                <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center">

                    <!-- Пилюля состояния (.hero-pill): точка и слово. -->
                    <Border x:Name="StatePill" Style="{StaticResource StatePill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                                     Margin="0,0,9,0" Fill="{DynamicResource Faint}">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="DotGlow" ShadowDepth="0" BlurRadius="22"
                                                      Opacity="0.7" Color="Transparent" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StateLine" FontSize="11.5" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource MonoFont}" Text="Проверяю…"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!--
                        Крупный таймер работы (.hero-big): моноширинный, с табличными
                        цифрами, чтобы не дёргался на каждой секунде. Пусто — «—»:
                        не запущено. Заполняется из состояния надзора (UptimeTick),
                        а не из подписи пилюли: у работающего это «ЧЧ:ММ:СС».
                    -->
                    <TextBlock x:Name="UptimeText" Margin="0,20,0,0" Text="—"
                               FontFamily="{DynamicResource MonoFont}" FontSize="64"
                               FontWeight="Medium" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Faint}" />

                    <!-- Полоса состояния (.hero-bar): во всю ширину героя. -->
                    <Border x:Name="StateBar" Height="4" Width="220" CornerRadius="2" Margin="0,16,0,0"
                            Background="{DynamicResource Border}" ClipToBounds="True"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Rectangle x:Name="StateBarFill" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Faint}" />

                            <Rectangle x:Name="StartProgressMark" Width="140" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Left" Visibility="Collapsed"
                                       Fill="{DynamicResource WarnFill}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="StartProgressShift" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- Подпись под полосой (.hero-cap): «uptime · …». -->
                    <TextBlock x:Name="StateHint" Margin="0,12,0,0" Text=""
                               FontFamily="{DynamicResource MonoFont}" FontSize="10.5"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="420" TextWrapping="Wrap"
                               Foreground="{DynamicResource Faint}" />

                    <!--
                        Одна кнопка на месте: «Запустить» или «Остановить».
                        Как .power в макете — крупная, по центру героя.
                    -->
                    <Grid Margin="0,20,0,0" HorizontalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource PowerButton}"
                                HorizontalAlignment="Center" Click="OnStart" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE768;" Margin="0,0,10,0" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Запустить" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource PowerButton}"
                                HorizontalAlignment="Center" Click="OnStop" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE71A;" Margin="0,0,10,0" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Остановить" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!--
                    Метрика сети (.net): приём, отдача, задержка, потери и полоса
                    истории. Показаний у программы нет — счётчиков адаптера она
                    не читает, — поэтому строка стоит в покое («—», приглушённо),
                    а не выдуманными числами: выдуманное читалось бы как живое.
                -->
                <Border Style="{StaticResource NetBar}" Margin="0,24,0,16">
                    <DockPanel>
                        <StackPanel x:Name="NetItems" DockPanel.Dock="Left" Orientation="Horizontal" Opacity="0.45">
                            <StackPanel Style="{StaticResource NetItem}">
                                <TextBlock Style="{StaticResource NetCap}" Text="↓" />
                                <TextBlock Style="{StaticResource NetValue}" Text="—" />
                                <TextBlock Style="{StaticResource NetUnit}" Text="Мбит/с" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource NetItem}">
                                <TextBlock Style="{StaticResource NetCap}" Text="↑" />
                                <TextBlock Style="{StaticResource NetValue}" Text="—" />
                                <TextBlock Style="{StaticResource NetUnit}" Text="Мбит/с" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource NetItem}">
                                <TextBlock Style="{StaticResource NetCap}" Text="~" />
                                <TextBlock Style="{StaticResource NetValue}" Text="—" />
                                <TextBlock Style="{StaticResource NetUnit}" Text="мс" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource NetItem}">
                                <TextBlock Style="{StaticResource NetCap}" Text="!" />
                                <TextBlock Style="{StaticResource NetValue}" Text="—" />
                                <TextBlock Style="{StaticResource NetUnit}" Text="%" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Полоса истории: в покое — ровная линия у нижнего края. -->
                        <Border Height="18" VerticalAlignment="Center" Background="Transparent">
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Border}" />
                        </Border>
                    </DockPanel>
                </Border>

                <!--
                    Панель режима (.panel): выбор из трёх, пояснение выбранного
                    и метки движков с шестернями. Одной карточкой во всю ширину,
                    как в макете.
                -->
                <Border Style="{StaticResource MockCard}" Margin="0,0,0,16" Padding="24,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Режим работы ZY" Margin="4,0,0,10" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="ModeDesync" Grid.Column="0" Style="{StaticResource Segment}"
                                         GroupName="WorkMode" Tag="Desync" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE9E9;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeDesyncName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="winws2: вмешивается в рукопожатие TLS так, что фильтр оператора не опознаёт имя. Трафик идёт напрямую, своим обычным путём, и адрес остаётся домашним.&#x0a;&#x0a;Лечит блокировки по имени и не лечит отказы по стране: сайт видит тот же адрес, что и без него." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ModeTunnel" Grid.Column="2" Style="{StaticResource Segment}"
                                         GroupName="WorkMode" Tag="Tunnel" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE774;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeTunnelName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="sing-box: поднимает сетевой адаптер и уводит через него трафик. Адрес становится зарубежным, и это лечит отказы по стране.&#x0a;&#x0a;В этом режиме забирает всё, кроме поставленного «напрямую», — как обычный VPN. Без исключений (настройки туннеля) — вообще всё.&#x0a;&#x0a;Требует подписки или WARP: без них поднимать нечего." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ModeRoute" Grid.Column="4" Style="{StaticResource Segment}"
                                         GroupName="WorkMode" Tag="Route" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE8AB;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeRouteName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Оба движка сразу. Что названо в маршрутах «через VPN», уходит в туннель; остальное идёт напрямую, и закрытое по имени чинит десинк.&#x0a;&#x0a;Адрес для сайтов из маршрутов — зарубежный, для прочих — домашний: российские сервисы не видят VPN." />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ModeText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="56" Text="" Margin="4,0,16,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="DesyncChip" Style="{StaticResource EnginePill}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DesyncDot" Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                        <TextBlock x:Name="DesyncState" Margin="8,0,0,0" FontSize="11.5"
                                                   Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DesyncPid" Margin="6,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource GearButton}" Content="&#xE713;" Margin="8,0,0,0"
                                                Click="OnDesyncSettings" ToolTip="Пресеты и рецепты — раздел «Десинк»" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="TunnelChip" Style="{StaticResource EnginePill}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="TunnelDot" Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                        <TextBlock x:Name="TunnelState" Margin="8,0,0,0" FontSize="11.5"
                                                   Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TunnelPid" Margin="6,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource GearButton}" Content="&#xE713;" Margin="8,0,0,0"
                                                Click="OnTunnelSettings" ToolTip="Настройки туннеля" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Жалоба на сочетание движков; пусто — строки нет вовсе. -->
                        <TextBlock x:Name="EnginesLine" Style="{StaticResource Caption}"
                                   Margin="4,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!--
                    Предупреждения: защитник в стеке, стёртый hosts. Пусто —
                    не показываем. Стоят выше прочих карточек: это то, из-за
                    чего обход может не работать, и узнать о них нужно раньше,
                    чем увидеть «работает с оговорками».
                -->
                <ItemsControl x:Name="Warnings" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MockCard}" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource Warn}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}"
                           Margin="4,0,0,16" TextWrapping="Wrap" Visibility="Collapsed" />

                <!--
                    Текущий пресет и параметры подключения — рядом, как в макете
                    (.grid-2). Подъём под курсором: карточка ведёт в выбор пресета.
                -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MockCard}" local:Lift.IsOn="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,14,0"
                                        Background="{DynamicResource PurpleSoft}" BorderBrush="{DynamicResource Purple}">
                                    <TextBlock Style="{StaticResource TileGlyph}" FontSize="16" Text="&#xE9E9;"
                                               Foreground="{DynamicResource Purple}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Текущий пресет" />
                                    <TextBlock x:Name="PresetValue" Style="{StaticResource CardName}" Margin="0,4,0,0" Text="—"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <!--
                                Первая фраза описания из самого файла пресета
                                («# Description:»), в две строки. Своих описаний
                                не придумываем: пресеты меняются выпусками,
                                и придуманное разошлось бы с файлом.
                            -->
                            <TextBlock x:Name="PresetNote" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />

                            <Button x:Name="PresetMenu" Style="{StaticResource Ghost}" HorizontalAlignment="Right"
                                    Padding="12,7" Margin="0,12,0,0" Click="OnPresetMenu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Изменить" VerticalAlignment="Center" />
                                    <Path Style="{StaticResource Chevron}" Margin="10,1,0,0">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Настройка. Только показ: правка — в своих разделах. -->
                    <Border Grid.Column="2" Style="{StaticResource MockCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" FontSize="16" Text="&#xE8CE;" />
                                </Border>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Параметры подключения"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource KeyLine}" Text="Сервер" Margin="0,0,20,9" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ServerValue" Style="{StaticResource KeyValue}"
                                           Text="—" Margin="0,0,0,9" />

                                <TextBlock Grid.Row="1" Style="{StaticResource KeyLine}" Text="DNS" Margin="0,0,20,9" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DnsValue" Style="{StaticResource KeyValue}"
                                           Text="—" Margin="0,0,0,9" />

                                <TextBlock Grid.Row="2" Style="{StaticResource KeyLine}" Text="Подписки" Margin="0,0,20,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SubscriptionValue" Style="{StaticResource KeyValue}"
                                           Text="—" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Автозапуск и обновление — рядом, как в макете. -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MockCard}" local:Lift.IsOn="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,14,0"
                                    Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}">
                                <TextBlock Style="{StaticResource TileGlyph}" FontSize="16" Text="&#xE945;"
                                           Foreground="{DynamicResource Ok}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Автозапуск" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Задача планировщика, а не служба: правами администратора задача наделяется сразу, запрос UAC при входе не появляется. Запускается та же программа и с теми же ключами, что и кнопка «Запустить», — иначе автозапуск поднимал бы не то, что вы проверили руками." />
                                </StackPanel>

                                <!-- Что именно поднимется — теми же словами, какими это задано выключателями движков. -->
                                <TextBlock x:Name="AutostartRaises" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />

                                <!-- Слова о задаче — только когда с ней не всё ясно. -->
                                <TextBlock x:Name="AutostartValue" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                            <!--
                                Выключатель, а не кнопка «Завести/Убрать». Щелчок
                                заводит или убирает задачу, а положение затем
                                ставится по ответу планировщика, не по щелчку:
                                отказал планировщик — выключатель вернётся.
                            -->
                            <ToggleButton Grid.Column="2" x:Name="AutostartSwitch" Style="{StaticResource Switch}"
                                          Click="OnAutostart" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MockCard}" local:Lift.IsOn="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,14,0"
                                    Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Ok}">
                                <TextBlock Style="{StaticResource TileGlyph}" FontSize="16" Text="&#xE896;"
                                           Foreground="{DynamicResource Ok}" />
                            </Border>

                            <views:UpdatePanel Grid.Column="1" x:Name="Updates" />
                        </Grid>
                    </Border>
                </Grid>

                <!--
                    Быстрые действия (макет, .quick): переходы в разделы разбора
                    и папка настроек — то, за чем идут, когда что-то не так.
                    Четыре кнопки в ряд.
                -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource QuickButton}" Click="OnQuickCheck">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE721;" Margin="0,0,8,0" />
                            <TextBlock Text="Проверить блокировки" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource QuickButton}" Click="OnQuickLog">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE8FD;" Margin="0,0,8,0" />
                            <TextBlock Text="Открыть журнал" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource QuickButton}" Click="OnQuickDoctor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE756;" Margin="0,0,8,0" />
                            <TextBlock Text="Диагностика" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource QuickButton}" Click="OnQuickConfig"
                            ToolTip="Папка config в проводнике, файл настроек выделен">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE8B7;" Margin="0,0,8,0" />
                            <TextBlock Text="Открыть конфиг" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--
                    Просьба о звезде и канале (макет, баннер поддержки).
                    Прячется навсегда: «Скрыть» пишет SupportCardHidden.
                -->
                <Border x:Name="SupportCard" Style="{StaticResource Banner}" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource Warn}" Background="{DynamicResource WarnSoft}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource BannerIcon}" Margin="0,0,14,0"
                                Background="{DynamicResource WarnSoft}">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE735;" FontSize="16"
                                       Foreground="{DynamicResource Warn}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                       Text="Нравится Zephyron?" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="Поставьте звезду, подпишитесь на канал или поддержите донатом — так о программе узнают другие." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Padding="14,7" Click="OnStar" Margin="0,0,8,0"
                                    ToolTip="Страница Zephyron на GitHub — звезда справа вверху">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE734;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Звезда" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Padding="14,7" Click="OnTelegram" Margin="0,0,8,0"
                                    ToolTip="Новости в телеграм-канале">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE724;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Канал" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Padding="14,7" Click="OnSupport" Margin="0,0,8,0"
                                    ToolTip="Поддержать разработку донатом">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xEB51;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Поддержать" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconGhost}" Content="&#xE711;" Padding="6,4" MinWidth="0"
                                    Click="OnSupportHide" ToolTip="Больше не показывать" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Строка внизу (макет, .ft): состояние слева, время сборки
                    конфига туннеля справа. Отделена волосяной чертой сверху.
                -->
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                        Padding="4,16,4,0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse x:Name="FooterDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource Faint}" />
                            <TextBlock x:Name="FooterState" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="FooterConfig" Style="{StaticResource Caption}" Margin="16,0,0,0"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
