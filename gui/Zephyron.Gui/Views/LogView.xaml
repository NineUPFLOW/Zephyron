<UserControl x:Class="Zephyron.Gui.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Chrome}">

    <!--
        С 0.16 журнал живёт в двух местах: окном из «Диагностики» (LogWindow)
        и выезжающей снизу панелью главного окна — по кнопке «Журнал» в правом
        нижнем углу. Шапка поэтому своя, узкая, а не PageHead: в панели высотой
        в треть окна крупная шапка съела бы половину строк. Поля задаёт тот,
        кто кладёт журнал к себе, — свойством Padding.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Акцентная черта — тот же знак, что у шапок разделов: чёткая, без свечения. -->
            <Border Grid.Column="0" Width="3" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                    Background="{DynamicResource Accent}" />

            <TextBlock Grid.Column="1" Text="Журнал" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />

            <TextBlock Grid.Column="2" x:Name="Status" Style="{StaticResource MonoTag}"
                       Margin="12,0,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    Переехало из «Ещё → Прочее» (владелец, 05.10): выключают
                    журнал, глядя на сам журнал. Движки читают настройку при
                    запуске — отсюда и предложение перезапустить.
                -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            ToolTip="Без журнала разбор сбоя сводится к догадкам. Выключают те, кого смущает рост файла: winws2 пишет строку на соединение. Применится при следующем запуске движков.">
                    <ToggleButton x:Name="LogsSwitch" Style="{StaticResource Switch}" Click="OnLogsSwitch" VerticalAlignment="Center" />
                    <TextBlock Text="Вести журнал" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <ComboBox x:Name="Source" Width="140" SelectedIndex="0"
                          SelectionChanged="OnSource" Margin="0,0,8,0">
                    <ComboBoxItem Content="sing-box" />
                    <ComboBoxItem Content="winws2" />
                    <ComboBoxItem Content="супервизор" />
                    <ComboBoxItem Content="окно" />
                </ComboBox>

                <Button x:Name="ErrorsButton" Style="{StaticResource Ghost}"
                        Content="Только ошибки" Click="OnErrors" Margin="0,0,8,0" />
                <Button Style="{StaticResource Ghost}" Content="Обновить" Click="OnReload" />

                <!-- Только в панели главного окна (ShowClose): у окна журнала есть свой крестик. -->
                <Button x:Name="CloseButton" Style="{StaticResource IconGhost}" Content="&#xE711;"
                        Margin="8,0,0,0" Padding="8,6" Visibility="Collapsed" Click="OnClose"
                        ToolTip="Свернуть журнал" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Border}"
                BorderThickness="{StaticResource Stroke}" CornerRadius="{StaticResource RMd}">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Padding="14,10">
                <TextBox x:Name="Text" Style="{x:Null}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Muted}"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
