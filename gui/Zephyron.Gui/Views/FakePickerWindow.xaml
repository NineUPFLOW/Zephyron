<Window x:Class="Zephyron.Gui.Views.FakePickerWindow"
        Style="{StaticResource Dialog}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:Zephyron.Gui"
        Title="Подделки секций" Width="720" Height="660" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}">

    <!--
        Подделка (blob) у каждой секции пресета выбирается из списка образцов,
        не правя файл пресета. Поиск — по имени секции, её спискам и фильтрам,
        как в окне выбора программы.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Head" Style="{StaticResource Title}" FontSize="20" TextWrapping="Wrap" />

        <TextBox Grid.Row="1" x:Name="Search" AutomationProperties.Name="Поиск секции" Margin="0,16,0,0"
                 TextChanged="OnSearch" gui:Hint.Text="Поиск по имени секции, спискам и фильтрам…" />

        <TextBlock Grid.Row="2" x:Name="Count" Style="{StaticResource Caption}" Margin="4,8,0,8" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="3" Style="{StaticResource PageScroll}">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Section}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                          DisplayMemberPath="Text" VerticalAlignment="Center"
                                          AutomationProperties.Name="Подделка секции" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                       Text="Действует со следующего запуска движков. Обновление пресета выбор не стирает." />

            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
            <Button Grid.Column="2" Style="{StaticResource Primary}" Content="Сохранить" IsDefault="True" Click="OnSave" />
        </Grid>
    </Grid>
</Window>
