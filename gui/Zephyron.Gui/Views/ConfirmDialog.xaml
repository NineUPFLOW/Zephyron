<Window x:Class="Zephyron.Gui.Views.ConfirmDialog"
        Style="{StaticResource Dialog}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyron" Width="460" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">

    <!-- Общий вопрос «да/нет» вместо системного MessageBox: тема, шрифт и масштаб как у программы. -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Head" Style="{StaticResource Title}" FontSize="20" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="0,12,0,0" MaxHeight="360">
            <TextBlock x:Name="Body" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="No" Style="{StaticResource Ghost}" IsCancel="True" Margin="0,0,8,0" Click="OnNo" />
            <Button x:Name="Yes" Style="{StaticResource Primary}" Click="OnYes" />
        </StackPanel>
    </Grid>
</Window>
