<UserControl x:Class="Zephyron.Gui.Views.EvolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:Zephyron.Gui"
             Background="{DynamicResource Chrome}">

    <ScrollViewer Style="{StaticResource PageScroll}" Padding="{StaticResource PagePad}">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Заголовок страницы -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Эволюция и генетический отбор пресетов" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Text}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Тестирование пресетов на целевых сайтах, отбор лучших стратегий в генофонд и направленная эволюция без деградации рабочих сервисов." />
                </StackPanel>
            </Grid>

            <!-- ШАГ 1: Целевые домены для проверки -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="1. Целевые домены для проверки" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Отметьте сайты, доступ к которым критически важен. Все пресеты будут проверены реальными сетевыми пробами." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Content="Популярные" Click="OnSelectPopularDomains" />
                            <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Content="Выбрать все" Click="OnSelectAllDomains" />
                            <Button Style="{StaticResource Quiet}" Content="Снять все" Click="OnDeselectAllDomains" />
                        </StackPanel>
                    </Grid>

                    <!-- Список чекбоксов доменов -->
                    <ItemsControl x:Name="TargetDomainsList" Margin="0,8,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="10,6" Margin="0,0,8,8">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Дополнительные домены -->
                    <Expander Header="Дополнительные произвольные домены" Margin="0,4,0,12" Foreground="{DynamicResource Muted}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Caption}" Text="Укажите свои домены (по одному на строку или через запятую):" Margin="0,0,0,4" />
                            <TextBox x:Name="CustomHostsBox" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="12"
                                     Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                                     BorderBrush="{DynamicResource Border}" Padding="6" />
                        </StackPanel>
                    </Expander>

                    <!-- Кнопка запуска бенчмарка пресетов -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BenchmarkAllButton" Grid.Column="0" Style="{StaticResource Primary}"
                                Content="⚡ Протестировать все пресеты на выбранных доменах" Padding="14,7" Click="OnBenchmarkAllPresets" />
                        <Button x:Name="StopBenchmarkButton" Grid.Column="1" Style="{StaticResource Quiet}" Margin="8,0,0,0"
                                Content="Остановить тест" Visibility="Collapsed" Click="OnStopBenchmark" />

                        <TextBlock x:Name="BenchmarkStatusText" Grid.Column="2" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ProgressBar x:Name="BenchmarkProgressBar" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- ШАГ 2: Рейтинг пресетов и отбор участников эволюции -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="2. Рейтинг пресетов и отбор в родительский генофонд" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Отметьте галочками пресеты с лучшим пробивом. Алгоритм скрестит их сильные стороны без деградации рабочих сервисов." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Content="🏆 Топ-3" Click="OnSelectTop3" />
                            <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Content="Топ-5" Click="OnSelectTop5" />
                            <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Content="Все" Click="OnSelectAllPresets" />
                            <Button Style="{StaticResource Quiet}" Margin="0,0,6,0" Content="Снять" Click="OnDeselectAllPresets" />
                            <Button Style="{StaticResource Quiet}" Margin="0,0,12,0" Content="🔄 Обновить" Click="OnRefreshPresets" ToolTip="Обновить список пресетов с диска" />
                            <Border Background="{DynamicResource Wash}" CornerRadius="{StaticResource RSm}" Padding="10,5">
                                <TextBlock x:Name="SelectedCountText" Text="Отобрано для эволюции: 0" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Поиск и фильтрация по списку пресетов -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchPresetBox" Height="28" Padding="6,2" VerticalContentAlignment="Center"
                                 Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
                                 BorderBrush="{DynamicResource Border}" TextChanged="OnSearchPresetTextChanged" />
                        <TextBlock x:Name="SearchPresetPlaceholder" Text="🔍 Фильтр по названию или Gen..." Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" />
                    </Grid>

                    <!-- Список отсортированных пресетов -->
                    <ItemsControl x:Name="BenchmarkResultsList" Margin="0,6,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Чекбокс отбора -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <!-- Имя пресета и бейдж эволюции -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}"
                                                        BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="4,1" Margin="6,0,0,0"
                                                        Visibility="{Binding EvolvedBadgeVisibility}">
                                                    <TextBlock Text="{Binding EvolvedBadge}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RankText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Бейдж проходимости хостов -->
                                        <Border Grid.Column="2" Background="{Binding ScoreBackground}" CornerRadius="{StaticResource RSm}"
                                                Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScoreBadge}" Foreground="{Binding ScoreBrush}" FontWeight="Bold" />
                                        </Border>

                                        <!-- Средний пинг -->
                                        <TextBlock Grid.Column="3" Text="{Binding LatencyBadge}" Style="{StaticResource Caption}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />

                                        <!-- Чипы проверенных доменов -->
                                        <ItemsControl Grid.Column="4" ItemsSource="{Binding HostChips}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Border}"
                                                            BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="6,2" Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding DisplayText}" Foreground="{Binding BadgeColor}" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Расширенные параметры эволюции -->
                    <Expander Header="Параметры генетического алгоритма (нажмите для настройки)" Margin="0,0,0,12" Foreground="{DynamicResource Muted}">
                        <Border Background="{DynamicResource Wash}" CornerRadius="{StaticResource RSm}" Padding="14" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Левая колонка параметров -->
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Style="{StaticResource Caption}" Text="Размер популяции (особей)" />
                                        <TextBlock x:Name="PopSizeLabel" HorizontalAlignment="Right" FontWeight="SemiBold" Text="16" />
                                    </Grid>
                                    <Slider x:Name="PopSizeSlider" Minimum="6" Maximum="32" Value="16" IsSnapToTickEnabled="True"
                                            TickFrequency="2" ValueChanged="OnPopSizeChanged" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Style="{StaticResource Caption}" Text="Количество поколений" />
                                        <TextBlock x:Name="GenerationsLabel" HorizontalAlignment="Right" FontWeight="SemiBold" Text="15" />
                                    </Grid>
                                    <Slider x:Name="GenerationsSlider" Minimum="3" Maximum="50" Value="15" IsSnapToTickEnabled="True"
                                            TickFrequency="1" ValueChanged="OnGenerationsChanged" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Style="{StaticResource Caption}" Text="Целевой фитнес (порог схождения)" />
                                        <TextBlock x:Name="ConvergeLabel" HorizontalAlignment="Right" FontWeight="SemiBold" Text="92%" />
                                    </Grid>
                                    <Slider x:Name="ConvergeSlider" Minimum="60" Maximum="99" Value="92" IsSnapToTickEnabled="True"
                                            TickFrequency="1" ValueChanged="OnConvergeChanged" Margin="0,0,0,6" />
                                </StackPanel>

                                <!-- Правая колонка параметров -->
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Style="{StaticResource Caption}" Text="Интенсивность мутаций" />
                                        <TextBlock x:Name="MutationLabel" HorizontalAlignment="Right" FontWeight="SemiBold" Text="15%" />
                                    </Grid>
                                    <Slider x:Name="MutationSlider" Minimum="5" Maximum="40" Value="15" IsSnapToTickEnabled="True"
                                            TickFrequency="1" ValueChanged="OnMutationChanged" Margin="0,0,0,10" />

                                    <CheckBox x:Name="IslandCheck" Margin="0,2,0,6" Content="Островная модель (параллельные субпопуляции)" />
                                    <CheckBox x:Name="MemeticCheck" IsChecked="True" Margin="0,0,0,6" Content="Меметическая доводка (Hill-Climbing)" />
                                    <CheckBox x:Name="SynergyCheck" IsChecked="True" Margin="0,0,0,6" Content="Проверка синергии в связке (YouTube + Discord + Web)" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- Выбор целевой секции для микро-эволюции -->
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Область оптимизации:" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="TargetSectionCombo" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                  SelectionChanged="OnTargetSectionChanged">
                            <ComboBoxItem Content="🧬 Все секции (Полная эволюция)" IsSelected="True" Tag="all" />
                            <ComboBoxItem Content="📺 YouTube (Видеопотоки googlevideo)" Tag="youtube" />
                            <ComboBoxItem Content="🎙 Discord (Голосовые шлюзы и WebRTC)" Tag="discord" />
                            <ComboBoxItem Content="🌐 Общие веб-блокировки (Остальные сайты)" Tag="general" />
                        </ComboBox>
                        <TextBlock x:Name="TargetSectionHint" Grid.Column="2" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Text="Будут оптимизированы все секции пресета." Foreground="{DynamicResource Muted}" />
                    </Grid>

                    <!-- Кнопки запуска эволюции из отобранных пресетов -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartEvolutionButton" Style="{StaticResource Primary}" Padding="16,8"
                                Content="🧬 Запустить эволюцию (0)" Click="OnStartEvolution" />
                        <Button x:Name="SprintEvolutionButton" Style="{StaticResource Ghost}" Margin="10,0,0,0" Padding="14,8"
                                Content="⚡ Микро-эволюция (8 сек)" Click="OnStartMicroEvolution"
                                ToolTip="Быстрый экспресс-спринт из 4 поколений по выбранной секции без риска деградации остальных" />
                        <Button x:Name="StopEvolutionButton" Style="{StaticResource Quiet}" Margin="10,0,0,0" Padding="14,8"
                                Content="Остановить" IsEnabled="False" Click="OnStopEvolution" />
                        <Button x:Name="ResumeEvolutionButton" Style="{StaticResource Quiet}" Margin="8,0,0,0" Padding="14,8"
                                Content="Возобновить" Click="OnResumeEvolution" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ШАГ 3: Мониторинг процесса эволюции и результаты -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="PhaseText" Text="Ожидание запуска" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="GenerationProgressText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="Выберите стратегии выше и запустите эволюцию" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="DpiProfileBadge" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}"
                                    BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="8,4" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock x:Name="DpiProfileText" Text="DPI: Стандартный" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{DynamicResource Wash}" CornerRadius="{StaticResource RSm}"
                                    Padding="14,6">
                                <TextBlock x:Name="OverallFitnessText" Text="Фитнес: 0%" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="EvolutionProgressBar" Height="6" Margin="0,0,0,14" Minimum="0" Maximum="100" Value="0" />

                    <!-- Статистические плашки -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Открыто хостов" />
                                <TextBlock x:Name="BestPassedText" Text="0 / 0" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Средний пинг" />
                                <TextBlock x:Name="BestLatencyText" Text="0 мс" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Текущее поколение" />
                                <TextBlock x:Name="GenerationsDoneText" Text="0" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Прирост фитнеса" />
                                <TextBlock x:Name="FitnessGainText" Text="+0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- График динамики поколений -->
                    <Border x:Name="FitnessHistoryCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="📈 Динамика приспособленности по поколениям" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                <TextBlock x:Name="HistoryPointsSummary" HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" />
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FitnessHistoryList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Wash}" CornerRadius="{StaticResource RSm}"
                                                    Padding="6,4" Margin="0,0,6,0" VerticalAlignment="Bottom" ToolTip="{Binding TooltipText}">
                                                <StackPanel HorizontalAlignment="Center" Width="38">
                                                    <TextBlock Text="{Binding FitnessText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                                    <ProgressBar Orientation="Vertical" Height="40" Width="14" Minimum="0" Maximum="100"
                                                                 Value="{Binding FitnessPercent, Mode=OneWay}" Margin="0,3,0,3" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding GenText}" FontSize="9" Foreground="{DynamicResource Muted}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Две колонки: Результаты проб сайтов + Живой журнал эволюции -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <!-- Колонка 1: Результаты проб сайтов -->
                        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Сетевые пробы лучшей особи" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Grid Margin="4,0,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Хост" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Статус" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Пинг" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Детали" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                </Grid>

                                <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ProbeResultsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Wash}" CornerRadius="{StaticResource RSm}"
                                                        Padding="8,5" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Host}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                                   FontWeight="Bold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Latency}" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Колонка 2: Живой журнал поколений -->
                        <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Живой журнал эволюции и мутаций" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <ScrollViewer x:Name="LogScrollViewer" Height="180" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="EvolutionLogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas, monospace"
                                                               FontSize="11" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Color}"
                                                               TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Панель финиша / Экспорта, Diff-инспектора и A/B Тестирования -->
                    <Border x:Name="ExportCard" Background="{DynamicResource Wash}" BorderBrush="{DynamicResource AccentLine}"
                            BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="16" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎉 Адаптация пресета успешно завершена!" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}" />
                                    <TextBlock x:Name="ExportPathText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SynergyReportText" Style="{StaticResource Caption}" Margin="0,4,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Padding="14,8"
                                            Content="🚀 Применить пресет" Margin="0,0,6,0" Click="OnApplyPreset" />
                                    <Button x:Name="RollbackButton" Style="{StaticResource Ghost}" Padding="12,8" Margin="0,0,6,0"
                                            Content="↩️ Откатить" Visibility="Collapsed" Click="OnRollbackPreset"
                                            ToolTip="Вернуть предыдущий стабильный пресет" />
                                    <Button x:Name="ABTestButton" Style="{StaticResource Quiet}" Padding="12,8" Margin="0,0,6,0"
                                            Content="⚔️ A/B Тест" Click="OnRunABTest"
                                            ToolTip="Сравнить базовый и эволюционировавший пресеты в реальном бою" />
                                    <Button Style="{StaticResource Ghost}" Padding="10,8" Margin="0,0,6,0" Content="📋 Скопировать" Click="OnCopyPresetContent"
                                            ToolTip="Скопировать содержимое пресета в буфер обмена" />
                                    <Button Style="{StaticResource Ghost}" Padding="10,8" Content="Папка" Click="OnOpenFolder" />
                                </StackPanel>
                            </Grid>

                            <!-- Результаты A/B Тестирования («Было / Стало» в бою) -->
                            <Border x:Name="ABTestResultCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="⚔️ Результаты прямого A/B тестирования (В бою)" FontWeight="Bold" />
                                        <TextBlock x:Name="ABStatusText" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                                    </Grid>
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Колонка Базовый пресет -->
                                        <Border Grid.Column="0" Background="{DynamicResource Wash}" CornerRadius="{StaticResource RSm}" Padding="10">
                                            <StackPanel>
                                                <TextBlock x:Name="ABBaseTitleText" Text="Базовый пресет" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock x:Name="ABBaseHostsText" Text="Доступность: —" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                                <TextBlock x:Name="ABBaseLatencyText" Text="Пинг: —" Style="{StaticResource Caption}" />
                                                <TextBlock x:Name="ABBaseThroughputText" Text="L7 Throughput: —" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Колонка Эволюционировавший пресет -->
                                        <Border Grid.Column="2" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}"
                                                BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="10">
                                            <StackPanel>
                                                <TextBlock x:Name="ABEvolvedTitleText" Text="🧬 Эволюция" FontWeight="Bold" Foreground="{DynamicResource Accent}" FontSize="13" />
                                                <TextBlock x:Name="ABEvolvedHostsText" Text="Доступность: —" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <TextBlock x:Name="ABEvolvedLatencyText" Text="Пинг: —" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ABEvolvedThroughputText" Text="L7 Throughput: —" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="ABVerdictText" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Инспектор изменений пресета («Было / Стало») -->
                            <Expander x:Name="DiffExpander" Header="🔍 Инспектор изменений («Было / Стало» в секциях)" IsExpanded="True" Foreground="{DynamicResource Text}">
                                <ItemsControl x:Name="DiffEntriesList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding SectionName}" FontWeight="Bold" FontSize="13" />
                                                            <TextBlock Text=" · " Foreground="{DynamicResource Muted}" />
                                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="{StaticResource RSm}" Padding="6,2">
                                                            <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding BadgeBrush}" FontSize="11" FontWeight="Bold" />
                                                        </Border>
                                                    </Grid>

                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="{DynamicResource Wash}" CornerRadius="{StaticResource RSm}" Padding="8,6">
                                                            <StackPanel>
                                                                <TextBlock Text="Было:" Style="{StaticResource Caption}" Foreground="{DynamicResource Muted}" FontSize="10" />
                                                                <TextBlock Text="{Binding OldSteps}" FontFamily="Consolas, monospace" FontSize="11"
                                                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="{StaticResource RSm}" Padding="8,6">
                                                            <StackPanel>
                                                                <TextBlock Text="Стало (Оптимизировано):" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding NewSteps}" FontFamily="Consolas, monospace" FontSize="11"
                                                                           Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
