<Project>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    РЎР±РѕСЂРєР° РґРѕР»Р¶РЅР° РїРѕРІС‚РѕСЂСЏС‚СЊСЃСЏ Сѓ РїРѕСЃС‚РѕСЂРѕРЅРЅРµРіРѕ С‡РµР»РѕРІРµРєР°, РёРЅР°С‡Рµ В«СЃРѕР±РµСЂРёС‚Рµ СЃР°РјРё
    Рё СЃРІРµСЂСЊС‚РµВ» вЂ” РїСѓСЃС‚РѕР№ СЃРѕРІРµС‚. РџСЂРѕРІРµСЂРµРЅРѕ 2026-09-07: РґРІРµ РїРѕРґСЂСЏРґ Сѓ РЅР°СЃ РґР°СЋС‚
    РѕРґРёРЅ Рё С‚РѕС‚ Р¶Рµ SHA256, РЅРѕ СЌС‚РѕРіРѕ РјР°Р»Рѕ вЂ” СЃРѕРІРїР°РґР°С‚СЊ РґРѕР»Р¶РЅРѕ Рё РЅР° С‡СѓР¶РѕР№ РјР°С€РёРЅРµ.

    Deterministic РєРѕРјРїРёР»СЏС‚РѕСЂ РІРєР»СЋС‡Р°РµС‚ СЃР°Рј; Р·РґРµСЃСЊ РІР°Р¶РЅРµРµ РІС‚РѕСЂРѕРµ. Р‘РµР·
    DeterministicSourcePaths РІ С„Р°Р№Р» РїРѕРїР°РґР°СЋС‚ Р°Р±СЃРѕР»СЋС‚РЅС‹Рµ РїСѓС‚Рё СЃР±РѕСЂРѕС‡РЅРѕР№ РјР°С€РёРЅС‹,
    Рё Сѓ СЃРѕР±СЂР°РІС€РµРіРѕ РІ РґСЂСѓРіРѕР№ РїР°РїРєРµ РІС‹С…РѕРґРёС‚ РґСЂСѓРіРѕР№ С„Р°Р№Р» РїСЂРё С‚РѕРј Р¶Рµ РёСЃС…РѕРґРЅРёРєРµ.
    Р—Р°РѕРґРЅРѕ СЌС‚Рѕ СѓС‚РµС‡РєР°: РІ РІС‹РїСѓС‰РµРЅРЅРѕРј zephyron.exe Р»РµР¶Р°Р»Р° СЃС‚СЂРѕРєР°
    C:\Users\<РёРјСЏ>\Projects\zephyron\..., С‚Рѕ РµСЃС‚СЊ РёРјСЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ СѓРµР·Р¶Р°Р»Рѕ
    РєР°Р¶РґРѕРјСѓ СЃРєР°С‡Р°РІС€РµРјСѓ.

    Р’РµСЂСЃРёСЋ РїР°РєРµС‚Р° SDK Р·Р°РґР°С‘С‚ global.json вЂ” РѕРЅР° РІР»РёСЏРµС‚ РЅР° IL РЅРµ РјРµРЅСЊС€Рµ.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths Condition="'$(Configuration)' == 'Release'">true</DeterministicSourcePaths>

    <!--
      РќСѓР¶РµРЅ РґР»СЏ DeterministicSourcePaths РІРЅРµ РЅРµРїСЂРµСЂС‹РІРЅРѕР№ СЃР±РѕСЂРєРё: Р±РµР· РЅРµРіРѕ
      MSBuild Р¶Р°Р»СѓРµС‚СЃСЏ, С‡С‚Рѕ РєРѕСЂРµРЅСЊ РёСЃС…РѕРґРЅРёРєРѕРІ РЅРµ Р·Р°РґР°РЅ. РћС‚РѕР±СЂР°Р¶РµРЅРёРµ РґРµР»Р°РµС‚
      С‚Рѕ Р¶Рµ, С‡С‚Рѕ СЃРґРµР»Р°Р» Р±С‹ СЃРµСЂРІРµСЂ СЃР±РѕСЂРєРё, вЂ” Р·Р°РјРµРЅСЏРµС‚ РєРѕСЂРµРЅСЊ РЅР° РЅРµР№С‚СЂР°Р»СЊРЅС‹Р№.
    -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    РЎРІРµРґРµРЅРёСЏ Рѕ РїСЂРѕРґСѓРєС‚Рµ РїРѕРїР°РґР°СЋС‚ РІ СЃРІРѕР№СЃС‚РІР° СЃРѕР±СЂР°РЅРЅС‹С… С„Р°Р№Р»РѕРІ: Сѓ СЂР°СЃРїСЂРѕСЃС‚СЂР°РЅСЏРµРјРѕР№
    РїСЂРѕРіСЂР°РјРјС‹ РѕРЅРё РІРёРґРЅС‹ РІ В«РЎРІРѕР№СЃС‚РІР°С…В» С„Р°Р№Р»Р°, Рё РїСѓСЃС‚С‹Рµ РїРѕР»СЏ С‚Р°Рј РІС‹РіР»СЏРґСЏС‚ С‚Р°Рє Р¶Рµ,
    РєР°Рє Сѓ winws2.exe, С‡СЊСЋ Р»РёС†РµРЅР·РёСЋ РЅР°Рј РїСЂРёС€Р»РѕСЃСЊ РІС‹СЏСЃРЅСЏС‚СЊ РЅР° СЃС‚РѕСЂРѕРЅРµ.
  -->
  <PropertyGroup>
    <Product>Zephyron</Product>
    <Company>NineUPFLOW</Company>
    <Copyright>Copyright (c) 2026 NineUPFLOW. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NineUPFLOW/Zephyron</RepositoryUrl>

    <!--
      РќРѕР»СЊ РІ СЃС‚Р°СЂС€РµРј СЂР°Р·СЂСЏРґРµ РЅР°РјРµСЂРµРЅРЅРѕ: РµРґРёРЅРёС†Р° РѕР·РЅР°С‡Р°Р»Р° Р±С‹ РѕР±РµС‰Р°РЅРёРµ, С‡С‚Рѕ С„РѕСЂРјР°С‚
      РїСЂР°РІРёР» Рё РїРѕРІРµРґРµРЅРёРµ РЅРµ РїРѕРјРµРЅСЏСЋС‚СЃСЏ РїРѕРґ С‚РµРјРё, РєС‚Рѕ СѓР¶Рµ РїРѕСЃС‚Р°РІРёР». Р¤РѕСЂРјР°С‚ РµС‰С‘
      СЂР°СЃС‚С‘С‚ вЂ” СЃРµРєС†РёСЏ capture, С‚РёРї ipset Рё РґРІР° СЂРµР¶РёРјР° СЂР°Р±РѕС‚С‹ РїРѕСЏРІРёР»РёСЃСЊ РїРѕСЃР»РµРґРЅРёРјРё.
      Р‘РµР· СЏРІРЅРѕРіРѕ Р·РЅР°С‡РµРЅРёСЏ .NET РїРѕРґСЃС‚Р°РІР»СЏРµС‚ 1.0.0, Рё С„Р°Р№Р» Р·Р°СЏРІР»СЏР» Р±С‹ СЃС‚Р°Р±РёР»СЊРЅРѕСЃС‚СЊ,
      РєРѕС‚РѕСЂРѕР№ РЅРµС‚, РІРґРѕР±Р°РІРѕРє СЂР°СЃС…РѕРґСЏСЃСЊ СЃ С‚РµРіРѕРј СЂРµР»РёР·Р°.
    -->
    <Version>1.4.2</Version>
  </PropertyGroup>

  <!--
    РџСЂРѕРµРєС‚ С†РµР»РёРєРѕРј x64-only: WFP-РёРЅС‚РµСЂРѕРї СЃРѕРґРµСЂР¶РёС‚ Р·Р°С€РёС‚С‹Рµ СЃРјРµС‰РµРЅРёСЏ РїРѕР»РµР№
    СЃС‚СЂСѓРєС‚СѓСЂ РґР»СЏ x64 ABI. РЎР±РѕСЂРєР° РїРѕРґ x86/ARM64 РґР°СЃС‚ РјРѕР»С‡Р° РЅРµРІРµСЂРЅС‹Р№ СЂР°Р·Р±РѕСЂ,
    РїРѕСЌС‚РѕРјСѓ Р»СѓС‡С€Рµ СѓРїР°СЃС‚СЊ РЅР° СЌС‚Р°РїРµ РєРѕРјРїРёР»СЏС†РёРё.
  -->
  <Target Name="GuardAgainstNonX64" BeforeTargets="Build">
    <Error Condition="'$(PlatformTarget)' != 'x64'"
           Text="Zephyron СЃРѕР±РёСЂР°РµС‚СЃСЏ С‚РѕР»СЊРєРѕ РїРѕРґ x64 (WFP-РёРЅС‚РµСЂРѕРї Р·Р°РІСЏР·Р°РЅ РЅР° x64 layout)." />
  </Target>

</Project>
