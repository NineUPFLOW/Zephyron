<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Лёгкий инструмент разбора. Своей логики не содержит: всё, что он
    делает, — зовёт те же библиотеки, которыми пользуется окно.

    Прав администратора не просит намеренно: чтение состояния их
    не требует, а диагностика, дёргающая UAC, не нужна никому.

    В поставку не идёт — pack.cmd публикует только окно.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>zy</AssemblyName>
    <RootNamespace>Zephyron.Tools</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zephyron.Core\Zephyron.Core.csproj" />
    <ProjectReference Include="..\..\src\Zephyron.Supervisor\Zephyron.Supervisor.csproj" />
    <ProjectReference Include="..\..\src\Zephyron.Proxy\Zephyron.Proxy.csproj" />
    <ProjectReference Include="..\..\src\Zephyron.Zapret\Zephyron.Zapret.csproj" />
  </ItemGroup>

</Project>